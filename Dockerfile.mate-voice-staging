FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY prisma ./prisma
COPY src ./src
COPY crm ./crm
COPY scripts/migrate-deploy.mjs ./scripts/migrate-deploy.mjs
COPY scripts/staging-set-app-user-password.mjs ./scripts/staging-set-app-user-password.mjs
COPY tsconfig.json ./tsconfig.json
RUN npm run build

ENV NODE_ENV=production
EXPOSE 3000
