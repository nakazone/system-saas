# Application
NODE_ENV=production
PORT=3000

# Public hostname without protocol (used for tenant subdomains: {slug}.APP_ROOT_DOMAIN)
# Example with custom domain: yourdomain.com
# Example with Railway default (no real multi-tenant subdomains): your-app.up.railway.app
APP_ROOT_DOMAIN=your-app.up.railway.app

# Full public URL of the app (no trailing slash)
APP_BASE_URL=https://your-app.up.railway.app

# Generate with: openssl rand -base64 32
SESSION_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Provided automatically when you attach a Railway Postgres plugin.
# If missing, add Railway Postgres and reference ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Email (console logs emails until a real provider is configured)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@yourdomain.com

# Optional S3-compatible storage (leave blank to use in-memory/data-URL fallback)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=flooring-saas
S3_PUBLIC_URL=

# Platform admin seed (run `npm run db:seed` once after first deploy if needed)
PLATFORM_ADMIN_EMAIL=platform@localhost
PLATFORM_ADMIN_PASSWORD=changeme-platform-admin
