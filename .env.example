# Application
NODE_ENV=development
PORT=3000
APP_ROOT_DOMAIN=localhost
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string

# Database
# Use the non-superuser app_user so Row-Level Security is enforced.
# Migrations should be run with the postgres superuser URL when needed:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flooring_saas?schema=public npx prisma migrate deploy
DATABASE_URL=postgresql://app_user:app_user@localhost:5432/flooring_saas?schema=public

# JWT (partner portal — prepared for later phases)
JWT_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_IN=7d

# S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=flooring-saas
S3_PUBLIC_URL=http://localhost:9000/flooring-saas

# Email (console provider in development)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@localhost

# Platform admin seed defaults
PLATFORM_ADMIN_EMAIL=platform@localhost
PLATFORM_ADMIN_PASSWORD=changeme-platform-admin
