# Display name for the product (marketing + public pages)
PRODUCT_NAME=ObraMate

# Application
NODE_ENV=production
PORT=3000

# Public hostname without protocol (tenant workspaces: {slug}.APP_ROOT_DOMAIN)
# Production (obramate.com):
APP_ROOT_DOMAIN=obramate.com
#
# Local:
# APP_ROOT_DOMAIN=localhost
#
# Railway default host (no wildcard TLS — forces session workspaces on apex):
# APP_ROOT_DOMAIN=your-app.up.railway.app

# Tenant routing: subdomain | session | auto (default)
# Production on obramate.com MUST be subdomain (requires DNS *.obramate.com → Railway)
TENANT_ROUTING=subdomain

# Full public URL of the app (no trailing slash)
APP_BASE_URL=https://obramate.com

# --- DNS required for multi-tenant subdomains (Network Solutions / your DNS) ---
# 1) Apex:   CNAME or ALIAS  obramate.com     → <your-service>.up.railway.app
# 2) WWW:    CNAME           www              → obramate.com  (app redirects www → apex)
# 3) Wild:   CNAME           *                → <your-service>.up.railway.app
# 4) Admin:  covered by wildcard as admin.obramate.com
# 5) Railway → Settings → Networking → add custom domains:
#      obramate.com , www.obramate.com , *.obramate.com , admin.obramate.com
# 6) Verify: node scripts/check-obramate-domain.mjs

# Generate with: openssl rand -base64 32
SESSION_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Provided automatically when you attach a Railway Postgres plugin.
# If missing, add Railway Postgres and reference ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Email (console logs emails until a real provider is configured)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@obramate.com

# Optional S3-compatible storage (leave blank to use in-memory/data-URL fallback)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=flooring-saas
S3_PUBLIC_URL=

# Optional Web Push VAPID (auto-generated into DB if omitted)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@obramate.com

# Optional support inbox
# SUPPORT_INBOX_EMAIL=support@obramate.com

# Platform admin seed (run `npm run db:seed` once after first deploy if needed)
PLATFORM_ADMIN_EMAIL=platform@obramate.com
PLATFORM_ADMIN_PASSWORD=changeme-platform-admin
