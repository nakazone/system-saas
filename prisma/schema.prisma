/// Digital employees configured for an organization's virtual office.
/// Their capabilities are an allowlist for future task execution, not CRM permissions.
model VirtualAgent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Stable key used by workflows even when an employee's name or department changes.
  key            String
  name           String
  title          String
  department     String
  avatarKey      String       @default("avatar-1")
  description    String       @db.Text
  capabilities   String[]     @default([])
  enabled        Boolean      @default(true)
  /// Uploaded photo (only with the person's consent); overrides avatarKey when set.
  photoUrl       String?
  /// ElevenLabs voice for this employee (null = company default).
  voiceId        String?
  /// How this employee talks ("direta e bem-humorada, chama o cliente pelo nome").
  personality    String?      @db.Text
  /// How hard they follow up on what is pending: light | normal | firm.
  followUpStyle  String       @default("normal")
  /// Working hours (company timezone) for repeated nudges.
  workStartHour  Int          @default(8)
  workEndHour    Int          @default(18)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, department, enabled])
}

/// Something a user asked an office employee to remember ("Marina, me lembra sexta de ligar pro Ortiz").
/// The employee brings it up in the office and nudges by bell/push until it is done.
model OfficeReminder {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// VirtualAgent.key of the employee who will remind.
  agentKey       String
  text           String
  dueAt          DateTime
  /// open | done | canceled
  status         String       @default("open")
  nudgeCount     Int          @default(0)
  lastNudgedAt   DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, userId, status, dueAt])
  @@index([status, dueAt])
}

// ---------------------------------------------------------------------------
// Auth / staff users
// ---------------------------------------------------------------------------

model User {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @db.Uuid
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email              String
  passwordHash       String
  name               String
  phone              String?
  avatarUrl          String?
  /// Personal signature image for quotes/PDFs when this user is the salesperson.
  signatureUrl       String?
  roleId             String?      @db.Uuid
  role               Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  status             String       @default("active") // active | invited | suspended | disabled
  mustChangePassword Boolean      @default(false)
  /// Usual start address for day route maps (home / shop / yard).
  routeStartAddress  String?
  /// Interface language chosen by the user (pt | en | es). Null = company default.
  uiLocale           String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  permissions                   UserPermission[]
  ownedLeads                    Lead[]                    @relation("LeadOwner")
  salesQuotes                   Quote[]                   @relation("QuoteSalesperson")
  assignedAssessments           SiteAssessment[]          @relation("AssessmentAssignee")
  completedChecklists           ChecklistResponse[]       @relation("ChecklistCompleter")
  assignedVisits                Visit[]                   @relation("VisitAssignee")
  crewMemberships               CrewMember[]
  projectEvents                 ProjectEvent[]            @relation("ProjectEventActor")
  laborRates                    LaborRate[]
  laborEntries                  LaborEntry[]
  supportTickets                SupportTicket[]           @relation("SupportTicketAuthor")
  pushSubscriptions             PushSubscription[]
  staffNotifications            StaffNotification[]
  officeReminders               OfficeReminder[]
  assignedWorkOrders            WorkOrder[]               @relation("WorkOrderAssignee")
  assignedMeetings              Meeting[]                 @relation("MeetingAssignee")
  workOrderMemberships          WorkOrderMember[]
  payrollEmployee               PayrollEmployee?
  campoShifts                   CampoShift[]
  campoWeekSubmissions          CampoWeekSubmission[]
  campoManualEntries            CampoManualEntry[]
  jobMedia                      JobMedia[]                @relation("JobMediaAuthor")
  jobReports                    JobReport[]               @relation("JobReportAuthor")
  jobInspections                JobInspection[]           @relation("JobInspectionAuthor")
  jobMeasurements               JobMeasurement[]          @relation("JobMeasurementAuthor")
  chatConversationsCreated      ChatConversation[]        @relation("ChatConversationCreator")
  chatMemberships               ChatConversationMember[]
  chatContexts                  ChatConversationContext[]
  chatMessagesAuthored          ChatMessage[]             @relation("ChatMessageAuthor")
  chatMessagesHidden            ChatMessage[]             @relation("ChatMessageHiddenBy")
  chatMessageEdits              ChatMessageEdit[]         @relation("ChatMessageEditAuthor")
  chatMessageJobsLinked         ChatMessageJob[]          @relation("ChatMessageJobLinker")
  chatMentionsReceived          ChatMessageMention[]
  chatAuditLogs                 ChatAuditLog[]            @relation("ChatAuditActor")
  chatMessageFlagsAssigned      ChatMessageFlag[]         @relation("ChatMessageFlagAssignee")
  mateVoiceConversationsCreated MateVoiceConversation[]   @relation("MateVoiceConversationCreator")
  mateAiConversations           MateAiConversation[]
  passwordResetTokens           PasswordResetToken[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Role {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  name           String
  description    String?
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users       User[]
  permissions RolePermission[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  group       String
  description String?

  userPermissions UserPermission[]
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

/// Org-managed lookup lists for quotes/catalog (service categories, units, …).
model OrgCatalogItem {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// service_category | unit | customer_type | payroll_payment_method
  kind           String
  key            String
  label          String
  description    String?
  sortOrder      Int          @default(0)
  active         Boolean      @default(true)
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, kind, key])
  @@index([organizationId, kind])
}

model UserPermission {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  permissionId String     @db.Uuid
  granted      Boolean    @default(true)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model Invitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  roleId         String       @db.Uuid
  token          String       @unique
  status         String       @default("pending") // pending | accepted | expired
  invitedBy      String?      @db.Uuid
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([token])
}

// ---------------------------------------------------------------------------
// External partner accounts, each scoped to one Builder / contractor contact.
// ---------------------------------------------------------------------------

model PartnerUser {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  builderId          String?             @db.Uuid
  builder            Builder?            @relation(fields: [builderId], references: [id], onDelete: SetNull)
  customerId         String?             @db.Uuid
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  email              String
  passwordHash       String
  name               String
  companyName        String?
  status             String              @default("active")
  mustChangePassword Boolean             @default(true)
  lastLoginAt        DateTime?
  /// Set when this row stands for a member of a builder account (the builder signs in with the account).
  builderMemberId    String?             @db.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  jobRequests        PartnerJobRequest[]

  @@unique([organizationId, email])
  @@index([builderMemberId])
  @@index([organizationId])
  @@index([organizationId, builderId])
  @@index([organizationId, customerId])
}

/// Service requests submitted by Builders through their tenant-scoped partner portal.
/// The tenant can require review or add new submissions as Jobs automatically.
model PartnerJobRequest {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @db.Uuid
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partnerUserId     String       @db.Uuid
  partnerUser       PartnerUser  @relation(fields: [partnerUserId], references: [id], onDelete: Cascade)
  workOrderId       String?      @db.Uuid
  workOrder         WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  customerId        String?      @db.Uuid
  builderId         String?      @db.Uuid
  title             String
  address           String
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  serviceType       String?
  preferredDate     DateTime?
  notes             String?      @db.Text
  status            String       @default("pending") // pending | accepted | declined
  files             Json         @default("[]")
  reviewedAt        DateTime?
  reviewNote        String?      @db.Text
  /// The builder's own job / PO number, read from their work order.
  externalRef       String?
  /// Set when the builder asked to update a job that already exists (no FK: the job may be deleted).
  targetWorkOrderId String?      @db.Uuid
  /// { source: "ai" | "manual", fields_checked: string[], model?: string }
  intake            Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([partnerUserId, createdAt])
  @@index([workOrderId])
  @@index([organizationId, externalRef])
}

/// Messages between the company and the builder inside a job the builder sent (both portals).
model JobPartnerMessage {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrderId    String       @db.Uuid
  workOrder      WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  /// company | builder
  side           String
  authorUserId   String?      @db.Uuid
  partnerUserId  String?      @db.Uuid
  authorName     String
  body           String       @db.Text
  /// [{ key, name, contentType, size }]
  files          Json         @default("[]")
  createdAt      DateTime     @default(now())

  @@index([organizationId, workOrderId, createdAt])
}

// ---------------------------------------------------------------------------
// Leads / pipeline
// ---------------------------------------------------------------------------

model PipelineStage {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @db.Uuid
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  slug              String?
  order             Int
  color             String?
  isClosed          Boolean      @default(false)
  isActive          Boolean      @default(true)
  /// Fixed system milestones: new | assessment_scheduled | quote_sent | won | lost
  isSystemMilestone Boolean      @default(false)

  leads Lead[]

  @@unique([organizationId, order])
  @@unique([organizationId, slug])
  @@index([organizationId])
}

model LossReason {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  leads Lead[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Lead {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  phone           String?
  source          String?
  status          String         @default("new")
  notes           String?        @db.Text
  /// Extra CRM fields (qualification, interactions, followups, address, etc.) for SF UI parity
  metadata        Json?
  pipelineStageId String?        @db.Uuid
  pipelineStage   PipelineStage? @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  ownerId         String?        @db.Uuid
  owner           User?          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lossReasonId    String?        @db.Uuid
  lossReason      LossReason?    @relation(fields: [lossReasonId], references: [id], onDelete: SetNull)
  lostAt          DateTime?
  lastContactedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customers              Customer[]
  siteAssessments        SiteAssessment[]
  meetings               Meeting[]
  mateVoiceConversations MateVoiceConversation[]

  @@index([organizationId])
  @@index([organizationId, pipelineStageId])
  @@index([lossReasonId])
  @@index([ownerId])
}

model Customer {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @db.Uuid
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId               String?      @db.Uuid
  lead                 Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  name                 String
  /// Optional reference code shown as "Name - code" in Jobs/Quotes; never mutates name.
  clientCode           String?
  email                String?
  phone                String?
  /// @deprecated Prefer Property records. Kept for back-compat; do not remove in M1.
  address              String?
  customerType         String       @default("particular") // particular | builder | loja | custom keys from OrgCatalogItem
  /// table = use PricingItem rates for this type; custom = use customPricingRates overrides
  pricingMode          String       @default("table") // table | custom
  /// Map of pricingItemId -> unit rate when pricingMode is custom.
  customPricingRates   Json?
  company              String?
  /// Short name for builder customers. Calendar jobs show this instead of the company name.
  nickname             String?
  notes                String?      @db.Text
  /// Pessoa de contato (responsável) em Builder / Loja
  contactName          String?
  /// Builder/Loja: unknown | yes | no — nem todos têm dumpster
  dumpsterStatus       String?
  /// Detalhe/local do dumpster quando dumpsterStatus = yes
  dumpsterNotes        String?      @db.Text
  /// Builder/Loja: unknown | yes | no — nem todos têm storage
  storageStatus        String?
  /// Detalhe/local do storage quando storageStatus = yes
  storageNotes         String?      @db.Text
  /// Opt-in for marketing blasts (future). Transactional emails ignore this.
  marketingConsent     Boolean      @default(true)
  /// When true, skip transactional automations (quote follow-ups, visit reminders).
  transactionalOptOut  Boolean      @default(false)
  /// Particular who referred this customer (indicação).
  referredByCustomerId String?      @db.Uuid
  referredByCustomer   Customer?    @relation("CustomerReferrals", fields: [referredByCustomerId], references: [id], onDelete: SetNull)
  referredCustomers    Customer[]   @relation("CustomerReferrals")
  /// Short code for sharing (unique per org), e.g. SF-MARIA.
  referralCode         String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  quotes                    Quote[]
  properties                Property[]
  siteAssessments           SiteAssessment[]
  invoices                  QuoteInvoice[]
  projects                  Project[]
  scheduledMessages         ScheduledMessage[]
  communicationLogs         CommunicationLog[]
  workOrders                WorkOrder[]
  partnerUsers              PartnerUser[]
  meetings                  Meeting[]
  builders                  Builder[]
  mateVoiceConversations    MateVoiceConversation[]
  referralRewardsAsReferrer ReferralReward[]        @relation("ReferralRewardReferrer")
  referralRewardsAsReferred ReferralReward[]        @relation("ReferralRewardReferred")
  referralLedgerEntries     ReferralLedgerEntry[]

  @@unique([organizationId, referralCode])
  @@index([organizationId])
  @@index([organizationId, referredByCustomerId])
}

/// Cashback earned when a referred customer's invoice becomes paid (% of invoice = project slice).
model ReferralReward {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @db.Uuid
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referrerCustomerId String       @db.Uuid
  referrerCustomer   Customer     @relation("ReferralRewardReferrer", fields: [referrerCustomerId], references: [id], onDelete: Cascade)
  referredCustomerId String       @db.Uuid
  referredCustomer   Customer     @relation("ReferralRewardReferred", fields: [referredCustomerId], references: [id], onDelete: Cascade)
  invoiceId          String       @db.Uuid
  quoteId            String?      @db.Uuid
  workOrderId        String?      @db.Uuid
  /// Invoice amount used as project base.
  projectAmount      Decimal      @db.Decimal(12, 2)
  percent            Decimal      @db.Decimal(5, 2)
  rewardAmount       Decimal      @db.Decimal(12, 2)
  /// credited | void
  status             String       @default("credited")
  creditedAt         DateTime     @default(now())
  createdAt          DateTime     @default(now())

  ledgerEntry ReferralLedgerEntry?

  @@unique([organizationId, invoiceId])
  @@index([organizationId])
  @@index([organizationId, referrerCustomerId])
  @@index([organizationId, referredCustomerId])
}

/// Ledger for Particular cashback: credit (from referral) / redeem (on their invoice) / adjust / expire.
model ReferralLedgerEntry {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @db.Uuid
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId       String          @db.Uuid
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// credit | redeem | adjust | expire
  type             String
  /// Signed: + for credit/adjust up, − for redeem/expire/adjust down.
  amount           Decimal         @db.Decimal(12, 2)
  referralRewardId String?         @unique @db.Uuid
  referralReward   ReferralReward? @relation(fields: [referralRewardId], references: [id], onDelete: SetNull)
  /// Invoice where cashback was applied as payment.
  invoiceId        String?         @db.Uuid
  invoiceReceiptId String?         @db.Uuid
  notes            String?
  createdAt        DateTime        @default(now())

  @@index([organizationId])
  @@index([organizationId, customerId, createdAt])
}

// ---------------------------------------------------------------------------
// Properties (job site addresses) + immutable activity history
// ---------------------------------------------------------------------------

model Property {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String       @db.Uuid
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label          String?
  line1          String
  line2          String?
  city           String
  state          String
  postalCode     String
  country        String       @default("US")
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  quotes          Quote[]
  siteAssessments SiteAssessment[]
  projects        Project[]

  @@index([organizationId])
  @@index([organizationId, customerId])
}

/// Immutable audit log. Application must never update or delete rows.
model ActivityEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String // quote | project | visit | invoice | payment | lead | customer | property
  entityId       String       @db.Uuid
  actorType      String // user | customer | system
  actorId        String?      @db.Uuid
  action         String // created | status_changed | updated | approved | signed | ...
  changes        Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Checklists (generic) + site assessments (measurement visits)
// ---------------------------------------------------------------------------

model ChecklistTemplate {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// site_assessment | visit
  appliesTo      String
  /// For visit templates: removal | subfloor_prep | installation | sanding_finishing | final_walkthrough | other
  visitPhase     String?
  /// Ordered fields: { id, label, type, options?, required }
  fields         Json
  active         Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  responses ChecklistResponse[]

  @@index([organizationId])
  @@index([organizationId, appliesTo])
}

model ChecklistResponse {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @db.Uuid
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId       String?            @db.Uuid
  template         ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// Snapshot of template fields at fill time (immutable for historical answers)
  templateSnapshot Json
  /// site_assessment | visit | …
  entityType       String
  entityId         String             @db.Uuid
  answers          Json               @default("{}")
  completedAt      DateTime?
  completedById    String?            @db.Uuid
  completedBy      User?              @relation("ChecklistCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  siteAssessments SiteAssessment[]
  visits          Visit[]

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([templateId])
}

model SiteAssessment {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @db.Uuid
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId              String?            @db.Uuid
  lead                Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId          String?            @db.Uuid
  customer            Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  propertyId          String?            @db.Uuid
  property            Property?          @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  scheduledStart      DateTime?
  scheduledEnd        DateTime?
  assignedUserId      String?            @db.Uuid
  assignedUser        User?              @relation("AssessmentAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  /// unscheduled | scheduled | completed | canceled
  status              String             @default("unscheduled")
  instructions        String?            @db.Text
  checklistResponseId String?            @db.Uuid
  checklistResponse   ChecklistResponse? @relation(fields: [checklistResponseId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, assignedUserId])
  @@index([leadId])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Quotes / estimates
// ---------------------------------------------------------------------------

model EstimateRule {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @db.Uuid
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  flooringType        String // hardwood | lvp | laminate | tile | carpet
  wastePercent        Decimal      @db.Decimal(5, 2)
  materialMarkup      Decimal      @db.Decimal(5, 2)
  laborMarkup         Decimal      @db.Decimal(5, 2)
  defaultPricePerSqft Decimal?     @db.Decimal(10, 2)
  defaultLaborPerSqft Decimal?     @db.Decimal(10, 2)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([organizationId, flooringType])
  @@index([organizationId])
}

model Quote {
  id                    String       @id @default(uuid()) @db.Uuid
  organizationId        String       @db.Uuid
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId            String?      @db.Uuid
  customer              Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  propertyId            String?      @db.Uuid
  property              Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  salespersonId         String?      @db.Uuid
  salesperson           User?        @relation("QuoteSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  leadId                String?      @db.Uuid
  builderId             String?      @db.Uuid
  builder               Builder?     @relation(fields: [builderId], references: [id], onDelete: SetNull)
  number                Int
  quoteNumber           String?
  title                 String
  /// draft | sent | changes_requested | approved | converted | archived | expired
  /// Legacy: accepted→approved, rejected→archived (migrated in M2)
  status                String       @default("draft")
  workOrderId           String?      @db.Uuid
  workOrder             WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  flooringType          String       @default("hardwood")
  areaSqft              Decimal      @default(0) @db.Decimal(12, 2)
  wastePercent          Decimal      @default(0) @db.Decimal(5, 2)
  materialCost          Decimal      @default(0) @db.Decimal(12, 2)
  laborCost             Decimal      @default(0) @db.Decimal(12, 2)
  materialMarkup        Decimal      @default(0) @db.Decimal(5, 2)
  laborMarkup           Decimal      @default(0) @db.Decimal(5, 2)
  subtotal              Decimal      @default(0) @db.Decimal(12, 2)
  discountType          String? // percent | fixed
  discountValue         Decimal      @default(0) @db.Decimal(12, 2)
  taxRate               Decimal      @default(0) @db.Decimal(5, 2)
  taxTotal              Decimal      @default(0) @db.Decimal(12, 2)
  total                 Decimal      @default(0) @db.Decimal(12, 2)
  notes                 String?      @db.Text
  clientMessage         String?      @db.Text
  terms                 String?      @db.Text
  /// Flags: showQuantities, showUnitPrices, showLineTotals, showRoomBreakdown
  clientView            Json?
  validUntil            DateTime?
  selectedOptionGroupId String?      @db.Uuid
  archiveReason         String?
  signatureUrl          String?
  signedByName          String?
  signedAt              DateTime?
  approvedIp            String?
  approvedUserAgent     String?
  /// SHA-256 of signature image bytes at approve time (integrity)
  signedDocumentSha256  String?
  approvedLat           Decimal?     @db.Decimal(10, 7)
  approvedLng           Decimal?     @db.Decimal(10, 7)
  approvedGpsAccuracyM  Decimal?     @db.Decimal(10, 2)
  changeRequestNote     String?      @db.Text
  viewedAt              DateTime?
  serviceType           String?
  /// @deprecated M2: prefer PublicAccessToken. Kept for dual-read during migration.
  publicToken           String?      @unique
  /// Full SF quote-builder payload for parity while APIs evolve
  payload               Json?
  invoicePdfPath        String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  lineItems       QuoteLineItem[]
  rooms           QuoteRoom[]
  optionGroups    QuoteOptionGroup[]
  invoices        QuoteInvoice[]
  paymentSchedule PaymentSchedule?
  project         Project?

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, salespersonId])
  @@index([workOrderId])
}

model QuoteRoom {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  quoteId        String  @db.Uuid
  quote          Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name           String
  areaSqft       Decimal @db.Decimal(12, 2)
  notes          String?
  sortOrder      Int     @default(0)

  lineItems QuoteLineItem[]

  @@index([organizationId])
  @@index([quoteId])
}

model QuoteOptionGroup {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  quoteId        String  @db.Uuid
  quote          Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name           String
  flooringType   String?
  sortOrder      Int     @default(0)

  lineItems QuoteLineItem[]

  @@index([organizationId])
  @@index([quoteId])
}

model QuoteLineItem {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  quoteId        String            @db.Uuid
  quote          Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  roomId         String?           @db.Uuid
  room           QuoteRoom?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  optionGroupId  String?           @db.Uuid
  optionGroup    QuoteOptionGroup? @relation(fields: [optionGroupId], references: [id], onDelete: SetNull)
  name           String?
  description    String
  quantity       Decimal           @db.Decimal(12, 2)
  unit           String            @default("sqft")
  unitCost       Decimal           @default(0) @db.Decimal(12, 2)
  unitPrice      Decimal           @db.Decimal(12, 2)
  amount         Decimal           @db.Decimal(12, 2)
  isOptional     Boolean           @default(false)
  isSelected     Boolean           @default(true)
  itemType       String            @default("service") // service | product
  productId      String?           @db.Uuid
  catalogId      String?           @db.Uuid
  sortOrder      Int               @default(0)
  meta           Json?

  budgetLines ProjectBudgetLine[]
  expenses    Expense[]

  @@index([organizationId])
  @@index([quoteId])
  @@index([roomId])
  @@index([optionGroupId])
}

/// Suggested optional add-ons for quotes (Settings → Quotes)
model QuoteAddOn {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  unit           String       @default("each")
  unitCost       Decimal      @default(0) @db.Decimal(12, 2)
  unitPrice      Decimal      @default(0) @db.Decimal(12, 2)
  active         Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

/// Hashed magic-link tokens for public portals (quotes, invoices, …)
model PublicAccessToken {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String // quote | invoice | …
  entityId       String       @db.Uuid
  tokenHash      String
  expiresAt      DateTime
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  viewedAt       DateTime?
  createdAt      DateTime     @default(now())

  @@unique([tokenHash])
  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
}

// ---------------------------------------------------------------------------
// Cadastro / ERP / Builders / Pricing / Payroll / Invoices / Projects
// ---------------------------------------------------------------------------

model Builder {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String       @default("")
  email          String?
  customerId     String?      @db.Uuid
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  phone          String?
  company        String?
  /// Short label shown on the calendar (e.g. CFC for Colorado Floor Company).
  nickname       String?
  type           String       @default("builder")
  status         String       @default("active") // active | pending | inactive
  address        String?
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  quotes       Quote[]
  projects     Project[]
  workOrders   WorkOrder[]
  partnerUsers PartnerUser[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
}

model PricingItem {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  category        String       @default("installation") // supply | installation | sand_finish | custom
  unit            String       @default("sq_ft")
  price           Decimal      @default(0) @db.Decimal(12, 2) // legacy single price
  priceMin        Decimal      @default(0) @db.Decimal(12, 2)
  priceMax        Decimal      @default(0) @db.Decimal(12, 2)
  partnerPrice    Decimal?     @db.Decimal(12, 2)
  /// Unit rates by customer type (Tabela de Valores).
  priceParticular Decimal      @default(0) @db.Decimal(12, 2)
  priceBuilder    Decimal      @default(0) @db.Decimal(12, 2)
  priceContractor Decimal      @default(0) @db.Decimal(12, 2)
  priceLoja       Decimal      @default(0) @db.Decimal(12, 2)
  description     String?      @db.Text
  notes           String?      @db.Text
  isVisible       Boolean      @default(true)
  isLocked        Boolean      @default(false)
  active          Boolean      @default(true)
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  workOrderLines WorkOrderLineItem[]

  @@index([organizationId])
}

model Supplier {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  notes          String?      @db.Text
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  products Product[]

  @@index([organizationId])
}

model Product {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String?      @db.Uuid
  supplier       Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  name           String
  category       String       @default("Hardwood")
  unitType       String       @default("sq_ft")
  costPrice      Decimal      @default(0) @db.Decimal(12, 4)
  sku            String?
  description    String?      @db.Text
  stockQty       Int?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, category])
}

model CategoryMargin {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         String
  marginPercentage Decimal      @db.Decimal(8, 4)
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, category])
  @@index([organizationId])
}

model QuoteCatalogItem {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  serviceType    String?
  unitType       String       @default("sq_ft")
  unitPrice      Decimal      @default(0) @db.Decimal(12, 2)
  description    String?      @db.Text
  active         Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model QuoteInvoice {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @db.Uuid
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Set when issued from an approved quote. Null for invoices issued straight from a job.
  quoteId              String?              @db.Uuid
  quote                Quote?               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  /// Job (ordem de serviço) billed at fixed table prices — no quote involved.
  workOrderId          String?              @db.Uuid
  workOrder            WorkOrder?           @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  customerId           String?              @db.Uuid
  customer             Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Canonical Phase 2 invoice model (evolved from thin QuoteInvoice — avoid dual Invoice stack).
  invoiceNumber        String?
  /// deposit | progress | final | full | other
  invoiceType          String               @default("other")
  status               String               @default("draft") // draft | sent | partially_paid | paid | void
  amount               Decimal              @default(0) @db.Decimal(12, 2)
  dueDate              DateTime?
  issuedAt             DateTime?
  paidAt               DateTime?
  /// First time the client opened the public invoice link.
  viewedAt             DateTime?
  voidedAt             DateTime?
  /// Last e-mail address the invoice was sent to.
  sentTo               String?
  /// Raw public link token (hash lives in PublicAccessToken) so every e-mail reuses the same link.
  publicToken          String?
  publicTokenExpiresAt DateTime?
  pdfPath              String?
  notes                String?              @db.Text
  paymentInstructions  String?              @db.Text
  scheduleItemId       String?              @db.Uuid
  scheduleItem         PaymentScheduleItem? @relation(fields: [scheduleItemId], references: [id], onDelete: SetNull)
  /// Reserved for future payment processor webhooks
  externalPaymentId    String?
  processor            String?
  payload              Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  lineItems InvoiceLineItem[]
  receipts  InvoiceReceipt[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([quoteId])
  @@index([workOrderId])
  @@index([customerId])
  @@index([organizationId, status])
  @@index([scheduleItemId])
}

model InvoiceLineItem {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String       @db.Uuid
  invoice        QuoteInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Decimal      @default(1) @db.Decimal(12, 2)
  unitPrice      Decimal      @default(0) @db.Decimal(12, 2)
  amount         Decimal      @default(0) @db.Decimal(12, 2)
  sortOrder      Int          @default(0)

  @@index([organizationId])
  @@index([invoiceId])
}

/// Manual / processor payment against an invoice (Phase 2 "Payment").
model InvoiceReceipt {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @db.Uuid
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId         String       @db.Uuid
  invoice           QuoteInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// RCT-0001 — allocated from DocumentSequence(kind = receipt).
  receiptNumber     String?
  amount            Decimal      @db.Decimal(12, 2)
  paidAt            DateTime     @default(now())
  /// Last time the receipt was e-mailed to the client.
  sentAt            DateTime?
  sentTo            String?
  createdById       String?      @db.Uuid
  method            String? // cash | check | card | ach | other
  referenceNumber   String?
  notes             String?
  /// Reserved for Stripe/etc.
  externalPaymentId String?
  processor         String?
  createdAt         DateTime     @default(now())

  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([invoiceId])
}

/// Per-org monotonic counters (invoice numbers, etc.) — lock row in tx.
model DocumentSequence {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           String // invoice | project | …
  nextValue      Int          @default(1)

  @@unique([organizationId, kind])
  @@index([organizationId])
}

model OrgPaymentTemplate {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  /// [{ label, percent?, fixedAmount?, trigger, phaseKey?, sortOrder }]
  items          Json
  active         Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model PaymentSchedule {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Quote-owned schedule (editable until locked). Optional after copy to project.
  quoteId          String?      @unique @db.Uuid
  quote            Quote?       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  /// Immutable project copy created on quote→project convert.
  projectId        String?      @unique @db.Uuid
  project          Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lockedAt         DateTime?
  sourceTemplateId String?      @db.Uuid
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  items PaymentScheduleItem[]

  @@index([organizationId])
  @@index([projectId])
}

model PaymentScheduleItem {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scheduleId     String          @db.Uuid
  schedule       PaymentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  label          String
  percent        Decimal?        @db.Decimal(5, 2)
  fixedAmount    Decimal?        @db.Decimal(12, 2)
  /// manual | on_send | on_approve | on_phase_start | on_phase_complete
  trigger        String          @default("manual")
  phaseKey       String?
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  invoices QuoteInvoice[]

  @@index([organizationId])
  @@index([scheduleId])
}

model Project {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         Int?
  quoteId        String?      @unique @db.Uuid
  quote          Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  customerId     String?      @db.Uuid
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  propertyId     String?      @db.Uuid
  property       Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  builderId      String?      @db.Uuid
  builder        Builder?     @relation(fields: [builderId], references: [id], onDelete: SetNull)
  name           String
  /// planning | scheduled | in_progress | needs_invoicing | completed | canceled | active (legacy)
  status         String       @default("planning")
  address        String?
  notes          String?      @db.Text
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  timesheets       PayrollTimesheet[]
  visits           Visit[]
  events           ProjectEvent[]
  paymentSchedule  PaymentSchedule?
  budgetLines      ProjectBudgetLine[]
  materialOrders   MaterialOrder[]
  expenses         Expense[]
  laborEntries     LaborEntry[]
  budgetFrozenAt   DateTime?
  /// Snapshot totals at convert (informational; prefer budgetLines)
  budgetedMaterial Decimal             @default(0) @db.Decimal(12, 2)
  budgetedLabor    Decimal             @default(0) @db.Decimal(12, 2)
  budgetedOther    Decimal             @default(0) @db.Decimal(12, 2)

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([customerId])
}

model ProjectEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String       @db.Uuid
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visitId        String?      @db.Uuid
  visit          Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)
  /// status_changed | visit_created | visit_updated | visit_canceled | phase_started | phase_completed | note | converted
  type           String
  payload        Json?
  actorId        String?      @db.Uuid
  actor          User?        @relation("ProjectEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([projectId, createdAt])
  @@index([visitId])
}

model Visit {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @db.Uuid
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId           String             @db.Uuid
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  crewId              String?            @db.Uuid
  crew                Crew?              @relation(fields: [crewId], references: [id], onDelete: SetNull)
  assignedUserId      String?            @db.Uuid
  assignedUser        User?              @relation("VisitAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  title               String?
  /// removal | subfloor_prep | installation | sanding_finishing | final_walkthrough | other
  phase               String             @default("installation")
  /// scheduled | in_progress | completed | canceled
  status              String             @default("scheduled")
  scheduledStart      DateTime
  scheduledEnd        DateTime
  instructions        String?            @db.Text
  checklistResponseId String?            @db.Uuid
  checklistResponse   ChecklistResponse? @relation(fields: [checklistResponseId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  events       ProjectEvent[]
  laborEntries LaborEntry[]

  @@index([organizationId])
  @@index([organizationId, scheduledStart])
  @@index([projectId])
  @@index([crewId])
  @@index([assignedUserId])
  @@index([organizationId, status])
}

model Crew {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String?
  active         Boolean      @default(true)
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members    CrewMember[]
  visits     Visit[]
  workOrders WorkOrder[]

  @@index([organizationId])
}

model CrewMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  crewId         String       @db.Uuid
  crew           Crew         @relation(fields: [crewId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// lead | member
  role           String       @default("member")

  @@unique([crewId, userId])
  @@index([organizationId])
  @@index([userId])
}

/// Frozen budget line at quote→project convert (immutable for history).
model ProjectBudgetLine {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId       String         @db.Uuid
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quoteLineItemId String?        @db.Uuid
  quoteLineItem   QuoteLineItem? @relation(fields: [quoteLineItemId], references: [id], onDelete: SetNull)
  /// material | labor | other
  category        String
  description     String
  quantity        Decimal        @default(1) @db.Decimal(12, 2)
  unitCost        Decimal        @default(0) @db.Decimal(12, 2)
  amount          Decimal        @default(0) @db.Decimal(12, 2)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())

  @@index([organizationId])
  @@index([projectId])
}

model LaborRate {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?      @db.Uuid
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Fallback when userId is null (e.g. installer, crew_lead)
  roleKey        String?
  label          String?
  hourlyRate     Decimal      @db.Decimal(12, 2)
  effectiveFrom  DateTime     @db.Date
  effectiveTo    DateTime?    @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, userId])
  @@index([organizationId, roleKey])
}

model LaborEntry {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String       @db.Uuid
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String?      @db.Uuid
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitId        String?      @db.Uuid
  visit          Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)
  workDate       DateTime     @db.Date
  hours          Decimal      @db.Decimal(8, 2)
  /// Snapshot of hourly rate at entry time
  rateSnapshot   Decimal      @db.Decimal(12, 2)
  amount         Decimal      @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([userId])
  @@index([visitId])
}

model MaterialOrder {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId        String       @db.Uuid
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description      String
  sku              String?
  vendor           String?
  quantityOrdered  Decimal      @default(0) @db.Decimal(12, 2)
  quantityReceived Decimal      @default(0) @db.Decimal(12, 2)
  quantityUsed     Decimal      @default(0) @db.Decimal(12, 2)
  unitCost         Decimal      @default(0) @db.Decimal(12, 2)
  /// ordered | partial | received | canceled
  status           String       @default("ordered")
  orderedAt        DateTime     @default(now())
  notes            String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  expenses Expense[]

  @@index([organizationId])
  @@index([projectId])
  @@index([organizationId, status])
}

model Expense {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId       String?        @db.Uuid
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// When set, this expense is a payment for a material order — excluded from double-count vs order actuals
  materialOrderId String?        @db.Uuid
  materialOrder   MaterialOrder? @relation(fields: [materialOrderId], references: [id], onDelete: SetNull)
  quoteLineItemId String?        @db.Uuid
  quoteLineItem   QuoteLineItem? @relation(fields: [quoteLineItemId], references: [id], onDelete: SetNull)
  category        String         @default("other") // material | labor | travel | other
  description     String
  amount          Decimal        @db.Decimal(12, 2)
  incurredOn      DateTime       @db.Date
  /// draft | approved | void
  status          String         @default("approved")
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([materialOrderId])
  @@index([quoteLineItemId])
}

/// Company finance module — costs / receipts (manual + OCR scan).
model FinanceCost {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  description    String
  /// materials | services | utilities | travel | equipment | taxes | other
  category       String       @default("other")
  amount         Decimal      @db.Decimal(12, 2)
  incurredOn     DateTime     @db.Date
  vendorName     String?
  /// Job this cost belongs to (material bought for a job), for job margin.
  workOrderId    String?      @db.Uuid
  workOrder      WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  projectId      String?      @db.Uuid
  /// manual | scan | import
  source         String       @default("manual")
  receiptUrl     String?
  receiptKey     String?
  /// none | pending | extracted | failed | skipped
  ocrStatus      String       @default("none")
  ocrVendor      String?
  ocrAmount      Decimal?     @db.Decimal(12, 2)
  ocrDate        DateTime?    @db.Date
  ocrRaw         Json?
  notes          String?      @db.Text
  /// draft | posted | void
  status         String       @default("posted")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, incurredOn])
  @@index([organizationId, status])
  @@index([workOrderId])
}

/// Cash outflow when a payroll period is paid / abated.
model FinancePayrollAbatement {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periodId       String?        @db.Uuid
  period         PayrollPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  label          String
  amount         Decimal        @db.Decimal(12, 2)
  paidOn         DateTime       @db.Date
  method         String? // cash | transfer | ach | check | other
  notes          String?
  /// pending | paid | void
  status         String         @default("paid")
  /// Set when the outflow is one employee's payment (PayrollPayment)
  employeeId     String?        @db.Uuid
  sector         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
  @@index([periodId])
  @@index([organizationId, paidOn])
}

model PayrollEmployee {
  id                         String       @id @default(uuid()) @db.Uuid
  organizationId             String       @db.Uuid
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Optional link to CRM login — used for self-service hour bank
  userId                     String?      @unique @db.Uuid
  user                       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                       String
  email                      String?
  phone                      String?
  roleTitle                  String?
  /// daily | production (legacy: hourly | mixed)
  payType                    String       @default("daily")
  /// installation | sand_finish
  sector                     String?
  dailyRate                  Decimal      @default(0) @db.Decimal(12, 2)
  hourlyRate                 Decimal      @default(0) @db.Decimal(12, 2)
  overtimeRate               Decimal      @default(0) @db.Decimal(12, 2)
  /// $/sqft when payType = production
  productionRate             Decimal      @default(0) @db.Decimal(12, 4)
  allowWorkDateOutsidePeriod Boolean      @default(false)
  /// Default day: "job" = starts at the first scheduled job (fallback scheduleStartTime) | "fixed"
  scheduleStartMode          String       @default("job")
  /// HH:MM, org timezone
  scheduleStartTime          String       @default("07:00")
  /// HH:MM, org timezone — time worked after this is overtime
  scheduleEndTime            String       @default("17:00")
  lunchMinutes               Int          @default(0)
  /// Also count time before the expected start as overtime
  countEarlyStart            Boolean      @default(false)
  /// Day can only be finished with ≥1 photo of today per job
  requirePhotos              Boolean      @default(true)
  requireGps                 Boolean      @default(true)
  /// cash | zelle | check | ach | other
  paymentMethod              String?
  status                     String       @default("active")
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  timesheets        PayrollTimesheet[]
  hourBankEntries   PayrollHourBankEntry[]
  periodAdjustments PayrollPeriodAdjustment[]
  shifts            CampoShift[]
  shiftExpenses     CampoShiftExpense[]
  payments          PayrollPayment[]

  @@index([organizationId])
  @@index([userId])
}

model PayrollPeriod {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  status         String       @default("open") // open | closed
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  timesheets        PayrollTimesheet[]
  adjustments       PayrollPeriodAdjustment[]
  financeAbatements FinancePayrollAbatement[]
  payments          PayrollPayment[]

  @@index([organizationId])
}

model PayrollPeriodAdjustment {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  periodId       String          @db.Uuid
  period         PayrollPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId     String          @db.Uuid
  employee       PayrollEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reimbursement  Decimal         @default(0) @db.Decimal(12, 2)
  discount       Decimal         @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([periodId, employeeId])
  @@index([organizationId])
  @@index([periodId])
}

model PayrollTimesheet {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @db.Uuid
  periodId          String          @db.Uuid
  period            PayrollPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId        String          @db.Uuid
  employee          PayrollEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId         String?         @db.Uuid
  project           Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workDate          DateTime        @db.Date
  /// Total hours equivalent (days*8 + regular + overtime) for simple rollups
  hours             Decimal         @default(0) @db.Decimal(8, 2)
  daysWorked        Decimal         @default(0) @db.Decimal(8, 2)
  regularHours      Decimal         @default(0) @db.Decimal(8, 2)
  overtimeHours     Decimal         @default(0) @db.Decimal(8, 2)
  dailyRateOverride Decimal?        @db.Decimal(12, 2)
  calculatedAmount  Decimal         @default(0) @db.Decimal(12, 2)
  /// Production pay (sqft × productionRate)
  sqft              Decimal         @default(0) @db.Decimal(12, 2)
  /// installation | sand_finish — snapshot from the employee/day
  sector            String?
  /// Dia de trabalho this line came from
  shiftId           String?         @db.Uuid
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([organizationId])
  @@index([periodId])
  @@index([employeeId])
  @@index([shiftId])
}

/// Self-service hour bank — employee logs own hours; admin approves into the timesheet.
model PayrollHourBankEntry {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String          @db.Uuid
  employee       PayrollEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate       DateTime        @db.Date
  /// Rollup for display (days*8 + overtime); production may be 0
  hours          Decimal         @db.Decimal(8, 2)
  daysWorked     Decimal         @default(0) @db.Decimal(8, 2)
  overtimeHours  Decimal         @default(0) @db.Decimal(8, 2)
  /// Production pay — sqft logged by employee
  sqft           Decimal?        @db.Decimal(12, 2)
  notes          String?
  /// pending | approved | rejected
  status         String          @default("pending")
  reviewedAt     DateTime?
  reviewedById   String?         @db.Uuid
  timesheetId    String?         @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
  @@index([employeeId])
  @@index([organizationId, status])
  @@index([organizationId, workDate])
}

// ---------------------------------------------------------------------------
// Communication automations (M7)
// ---------------------------------------------------------------------------

model ScheduledMessage {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// email | sms (sms reserved)
  channel        String       @default("email")
  /// quote_follow_up | visit_reminder
  triggerKey     String
  entityType     String
  entityId       String       @db.Uuid
  customerId     String?      @db.Uuid
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  toAddress      String
  subject        String
  body           String       @db.Text
  scheduledFor   DateTime
  /// pending | processing | sent | canceled | failed | skipped
  status         String       @default("pending")
  attempts       Int          @default(0)
  lastError      String?
  payload        Json?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  logs CommunicationLog[]

  @@index([organizationId])
  @@index([organizationId, status, scheduledFor])
  @@index([entityType, entityId])
  @@index([customerId])
}

model CommunicationLog {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @db.Uuid
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel            String            @default("email")
  direction          String            @default("outbound")
  triggerKey         String?
  entityType         String?
  entityId           String?           @db.Uuid
  customerId         String?           @db.Uuid
  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  toAddress          String
  subject            String?
  body               String            @db.Text
  /// sent | failed | skipped
  status             String
  skipReason         String?
  scheduledMessageId String?           @db.Uuid
  scheduledMessage   ScheduledMessage? @relation(fields: [scheduledMessageId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([customerId])
  @@index([scheduledMessageId])
}

// ---------------------------------------------------------------------------
// Support (tenant → platform)
// ---------------------------------------------------------------------------

/// "Entrar como suporte": a platform admin opens a company's CRM as one of its users.
/// Read-only in this version; payroll and employee data stay hidden.
model SupportSession {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adminId        String       @db.Uuid
  adminName      String
  userId         String       @db.Uuid
  userName       String
  reason         String
  mode           String       @default("read") // read (edit is a later phase)
  ticketId       String?      @db.Uuid
  tokenHash      String       @unique
  tokenExpiresAt DateTime
  startedAt      DateTime?
  expiresAt      DateTime
  endedAt        DateTime?
  endedBy        String? // user | master | expired
  ip             String?
  userAgent      String?
  views          Int          @default(0)
  blocked        Int          @default(0)
  lastPath       String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([adminId, createdAt])
}

model SupportTicket {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @db.Uuid
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUserId String?                @db.Uuid
  createdByUser   User?                  @relation("SupportTicketAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  /// question | suggestion | bug | other
  category        String                 @default("question")
  subject         String
  body            String                 @db.Text
  /// open | waiting (answered, waiting for the company) | closed
  status          String                 @default("open")
  adminNote       String?                @db.Text
  closedAt        DateTime?
  /// low | normal | high
  priority        String                 @default("normal")
  assigneeId      String?                @db.Uuid
  firstResponseAt DateTime?
  lastMessageAt   DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  messages        SupportTicketMessage[]

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Work orders (jobs outside leads/quotes) + meetings (schedule)
// ---------------------------------------------------------------------------

model WorkOrder {
  id                                   String       @id @default(uuid()) @db.Uuid
  organizationId                       String       @db.Uuid
  organization                         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number                               Int?
  title                                String
  /// draft | scheduled | in_progress | completed | canceled
  status                               String       @default("draft")
  /// Campo visit stepper: scheduled | en_route | on_site | completed
  fieldStatus                          String       @default("scheduled")
  /// builder | contractor | internal | other
  sourceType                           String       @default("other")
  sourceName                           String?
  customerId                           String?      @db.Uuid
  customer                             Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  builderId                            String?      @db.Uuid
  builder                              Builder?     @relation(fields: [builderId], references: [id], onDelete: SetNull)
  address                              String?
  /// Client ID for this job only (the quote note). Not stored on the customer.
  clientRef                            String?
  notes                                String?      @db.Text
  /// Highlight for field workers (ATENÇÃO box)
  campoAttention                       String?      @db.Text
  /// Pickup / delivery of leftover material from the job site
  needsDelivery                        Boolean      @default(false)
  /// Where to pick up leftover material (may differ from the job site)
  deliveryPickupAddress                String?
  /// Delivery notes (PO number, instructions, etc.)
  deliveryNotes                        String?      @db.Text
  deliveryAttachmentUrl                String?
  deliveryAttachmentKey                String?
  deliveryAttachmentName               String?
  deliveryAttachmentSharedWithPartners Boolean      @default(false)
  /// Every ObraCam photo / video of the job shows in the builder's portal (on for jobs a builder sent).
  sharePhotosWithPartners              Boolean      @default(false)
  /// [{ id, text, done }]
  campoChecklist                       Json?
  /// [{ id, url, createdAt }]
  campoPhotos                          Json?
  campoProblemNote                     String?      @db.Text
  assignedUserId                       String?      @db.Uuid
  assignedUser                         User?        @relation("WorkOrderAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  crewId                               String?      @db.Uuid
  crew                                 Crew?        @relation(fields: [crewId], references: [id], onDelete: SetNull)
  /// null | installation | sand_finish — routes the job to a Jobs calendar sector
  sector                               String?
  /// Lixa → Instalação (or sibling link). Sand-finish jobs point at the installation job.
  relatedWorkOrderId                   String?      @db.Uuid
  relatedWorkOrder                     WorkOrder?   @relation("WorkOrderRelated", fields: [relatedWorkOrderId], references: [id], onDelete: SetNull)
  relatedChildren                      WorkOrder[]  @relation("WorkOrderRelated")
  scheduledStart                       DateTime?
  scheduledEnd                         DateTime?
  /// Second start when the job is Installation and Sand & Finish.
  sandScheduledStart                   DateTime?
  /// Installation finished on a job that also has Sand & Finish. The job stays open until sand is done too.
  installationDoneAt                   DateTime?
  /// Sand & Finish finished. With installationDoneAt, the job can move to completed.
  sandDoneAt                           DateTime?
  /// All-day start (no specific clock time). Agenda renders in the all-day lane.
  allDay                               Boolean      @default(false)
  /// Set when the pre-start push reminder was sent (dedupe).
  startReminderSentAt                  DateTime?
  /// Set when the "starts now" nudge / office auto-start ran (dedupe).
  startNudgeSentAt                     DateTime?
  createdAt                            DateTime     @default(now())
  updatedAt                            DateTime     @updatedAt

  members            WorkOrderMember[]
  tempWorkers        WorkOrderTempWorker[]
  lineItems          WorkOrderLineItem[]
  campoSegments      CampoSegment[]
  campoManualEntries CampoManualEntry[]
  campoShiftJobs     CampoShiftJob[]
  /// Geocoded job location (distance check for the day's GPS)
  geoLat             Decimal?                  @db.Decimal(10, 7)
  geoLng             Decimal?                  @db.Decimal(10, 7)
  geoCheckedAt       DateTime?
  media              JobMedia[]
  reports            JobReport[]
  quotes             Quote[]
  financeCosts       FinanceCost[]
  invoices           QuoteInvoice[]
  partnerRequests    PartnerJobRequest[]
  partnerMessages    JobPartnerMessage[]
  inspections        JobInspection[]
  measurements       JobMeasurement[]
  chatConversation   ChatConversation?
  chatContexts       ChatConversationContext[]
  chatMessageJobs    ChatMessageJob[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, fieldStatus])
  @@index([organizationId, scheduledStart])
  @@index([organizationId, sector])
  @@index([customerId])
  @@index([builderId])
  @@index([assignedUserId])
  @@index([crewId])
  @@index([relatedWorkOrderId])
}

/// Field job photo/video proof — SHA-256 verified, GPS optional, stages before/during/after.
model JobMedia {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @db.Uuid
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrderId        String       @db.Uuid
  workOrder          WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  authorId           String?      @db.Uuid
  author             User?        @relation("JobMediaAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// photo | video
  type               String       @default("photo")
  storageKey         String
  thumbKey           String?
  url                String
  thumbUrl           String?
  sha256             String
  takenAtDevice      DateTime?
  receivedAtServer   DateTime     @default(now())
  lat                Decimal?     @db.Decimal(10, 7)
  lng                Decimal?     @db.Decimal(10, 7)
  gpsAccuracyM       Decimal?     @db.Decimal(10, 2)
  address            String?
  caption            String?
  /// before | during | after | null
  stage              String?
  annotationsJson    Json?
  isPublic           Boolean      @default(false)
  sharedWithPartners Boolean      @default(false)
  /// Featured on org public portfolio page
  inPortfolio        Boolean      @default(false)
  /// OCR extract from labels / serial plates
  ocrJson            Json?
  /// Client-generated id for offline dedupe
  clientUploadId     String?
  deviceLabel        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  @@index([organizationId])
  @@index([workOrderId])
  @@index([organizationId, workOrderId, deletedAt])
  @@index([organizationId, clientUploadId])
  @@index([sha256])
  @@index([authorId])
}

/// Spoken field inspection: audio narrated while photographing (Phase 5).
model JobInspection {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrderId     String       @db.Uuid
  workOrder       WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  authorId        String?      @db.Uuid
  author          User?        @relation("JobInspectionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// open | processing | done | failed
  status          String       @default("open")
  audioStorageKey String?
  audioUrl        String?
  audioSha256     String?
  durationMs      Int?
  startedAtDevice DateTime?
  endedAtDevice   DateTime?
  transcript      String?      @db.Text
  summary         String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  marks JobInspectionMark[]

  @@index([organizationId])
  @@index([workOrderId])
  @@index([organizationId, workOrderId, status])
  @@index([authorId])
}

model JobInspectionMark {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  inspectionId   String        @db.Uuid
  inspection     JobInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  mediaId        String?       @db.Uuid
  /// Milliseconds from inspection audio start
  offsetMs       Int           @default(0)
  note           String?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([inspectionId])
  @@index([mediaId])
}

/// Experimental field measurements (manual / future AR) behind feature flag.
model JobMeasurement {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrderId    String       @db.Uuid
  workOrder      WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  authorId       String?      @db.Uuid
  author         User?        @relation("JobMeasurementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  label          String
  /// length_ft | width_ft | area_sqft | custom
