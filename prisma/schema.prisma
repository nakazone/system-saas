generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto]
}

// ---------------------------------------------------------------------------
// Platform layer (outside any organization)
// ---------------------------------------------------------------------------

model PlatformAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  status       String   @default("active") // active | disabled
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Organization (tenant root)
// ---------------------------------------------------------------------------

model Organization {
  id               String    @id @default(uuid()) @db.Uuid
  slug             String    @unique
  name             String
  status           String    @default("trial") // trial | active | past_due | canceled
  plan             String    @default("starter")
  logoUrl          String?
  primaryColor     String?
  /// Accent / secondary brand color (maps to SF gold tokens)
  accentColor      String?
  contactEmail     String?
  contactPhone     String?
  /// IANA timezone for displaying visit times (stored UTC in DB)
  timezone         String    @default("America/New_York")
  stripeCustomerId String?
  trialEndsAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  users              User[]
  roles              Role[]
  invitations        Invitation[]
  pipelineStages     PipelineStage[]
  leads              Lead[]
  customers          Customer[]
  properties         Property[]
  activityEvents     ActivityEvent[]
  quotes             Quote[]
  estimateRules      EstimateRule[]
  partnerUsers       PartnerUser[]
  builders           Builder[]
  pricingItems       PricingItem[]
  suppliers          Supplier[]
  products           Product[]
  categoryMargins    CategoryMargin[]
  quoteCatalogItems  QuoteCatalogItem[]
  quoteInvoices      QuoteInvoice[]
  projects           Project[]
  payrollEmployees   PayrollEmployee[]
  payrollPeriods     PayrollPeriod[]
}

// ---------------------------------------------------------------------------
// Auth / staff users
// ---------------------------------------------------------------------------

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email              String
  passwordHash       String
  name               String
  roleId             String?  @db.Uuid
  role               Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  status             String   @default("active") // active | invited | suspended | disabled
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  permissions UserPermission[]
  ownedLeads  Lead[]           @relation("LeadOwner")

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  group       String
  description String?

  userPermissions UserPermission[]
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserPermission {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @db.Uuid
  permissionId String  @db.Uuid
  granted      Boolean @default(true)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model Invitation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  roleId         String   @db.Uuid
  token          String   @unique
  status         String   @default("pending") // pending | accepted | expired
  invitedBy      String?  @db.Uuid
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([token])
}

// ---------------------------------------------------------------------------
// External partner users (JWT auth — model prepared for later portal)
// ---------------------------------------------------------------------------

model PartnerUser {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  passwordHash   String
  name           String
  companyName    String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Leads / pipeline
// ---------------------------------------------------------------------------

model PipelineStage {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String?
  order          Int
  color          String?
  isClosed       Boolean @default(false)
  isActive       Boolean @default(true)

  leads Lead[]

  @@index([organizationId])
  @@unique([organizationId, order])
  @@unique([organizationId, slug])
}

model Lead {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  phone           String?
  source          String?
  status          String   @default("new")
  notes           String?  @db.Text
  pipelineStageId String?  @db.Uuid
  pipelineStage   PipelineStage? @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  ownerId         String?  @db.Uuid
  owner           User?    @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customers Customer[]

  @@index([organizationId])
  @@index([organizationId, pipelineStageId])
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?  @db.Uuid
  lead           Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  name           String
  email          String?
  phone          String?
  /// @deprecated Prefer Property records. Kept for back-compat; do not remove in M1.
  address        String?
  customerType   String   @default("residential") // residential | builder | commercial
  company        String?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quotes     Quote[]
  properties Property[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Properties (job site addresses) + immutable activity history
// ---------------------------------------------------------------------------

model Property {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String   @db.Uuid
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label          String?
  line1          String
  line2          String?
  city           String
  state          String
  postalCode     String
  country        String   @default("US")
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, customerId])
}

/// Immutable audit log. Application must never update or delete rows.
model ActivityEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String // quote | project | visit | invoice | payment | lead | customer | property
  entityId       String   @db.Uuid
  actorType      String // user | customer | system
  actorId        String?  @db.Uuid
  action         String // created | status_changed | updated | approved | signed | ...
  changes        Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Quotes / estimates
// ---------------------------------------------------------------------------

model EstimateRule {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  flooringType     String // hardwood | lvp | laminate | tile | carpet
  wastePercent     Decimal  @db.Decimal(5, 2)
  materialMarkup   Decimal  @db.Decimal(5, 2)
  laborMarkup      Decimal  @db.Decimal(5, 2)
  defaultPricePerSqft Decimal? @db.Decimal(10, 2)
  defaultLaborPerSqft Decimal? @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([organizationId, flooringType])
  @@index([organizationId])
}

model Quote {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String?  @db.Uuid
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId         String?  @db.Uuid
  builderId      String?  @db.Uuid
  builder        Builder? @relation(fields: [builderId], references: [id], onDelete: SetNull)
  number         Int
  quoteNumber    String?
  title          String
  status         String   @default("draft") // draft | sent | accepted | rejected | expired | invoiced
  flooringType   String   @default("hardwood")
  areaSqft       Decimal  @default(0) @db.Decimal(12, 2)
  wastePercent   Decimal  @default(0) @db.Decimal(5, 2)
  materialCost   Decimal  @default(0) @db.Decimal(12, 2)
  laborCost      Decimal  @default(0) @db.Decimal(12, 2)
  materialMarkup Decimal  @default(0) @db.Decimal(5, 2)
  laborMarkup    Decimal  @default(0) @db.Decimal(5, 2)
  subtotal       Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal  @default(0) @db.Decimal(12, 2)
  notes          String?  @db.Text
  terms          String?  @db.Text
  serviceType    String?
  publicToken    String?  @unique
  /// Full SF quote-builder payload for parity while APIs evolve
  payload        Json?
  invoicePdfPath String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lineItems QuoteLineItem[]
  invoices  QuoteInvoice[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([organizationId, status])
}

model QuoteLineItem {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  quoteId        String  @db.Uuid
  quote          Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description    String
  quantity       Decimal @db.Decimal(12, 2)
  unit           String  @default("sqft")
  unitPrice      Decimal @db.Decimal(12, 2)
  amount         Decimal @db.Decimal(12, 2)
  itemType       String  @default("service") // service | product
  productId      String? @db.Uuid
  catalogId      String? @db.Uuid
  sortOrder      Int     @default(0)
  meta           Json?

  @@index([organizationId])
  @@index([quoteId])
}

// ---------------------------------------------------------------------------
// Cadastro / ERP / Builders / Pricing / Payroll / Invoices / Projects
// ---------------------------------------------------------------------------

model Builder {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String   @default("")
  email          String?
  phone          String?
  company        String?
  type           String   @default("builder")
  status         String   @default("active") // active | pending | inactive
  address        String?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quotes   Quote[]
  projects Project[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model PricingItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  category       String   @default("installation") // supply | installation | sand_finish | custom
  unit           String   @default("sq_ft")
  price          Decimal  @default(0) @db.Decimal(12, 2) // legacy single price
  priceMin       Decimal  @default(0) @db.Decimal(12, 2)
  priceMax       Decimal  @default(0) @db.Decimal(12, 2)
  partnerPrice   Decimal? @db.Decimal(12, 2)
  description    String?  @db.Text
  notes          String?  @db.Text
  isVisible      Boolean  @default(true)
  isLocked       Boolean  @default(false)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model Supplier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  notes          String?  @db.Text
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]

  @@index([organizationId])
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String?  @db.Uuid
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  name           String
  category       String   @default("Hardwood")
  unitType       String   @default("sq_ft")
  costPrice      Decimal  @default(0) @db.Decimal(12, 4)
  sku            String?
  description    String?  @db.Text
  stockQty       Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, category])
}

model CategoryMargin {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         String
  marginPercentage Decimal  @db.Decimal(8, 4)
  updatedAt        DateTime @updatedAt

  @@unique([organizationId, category])
  @@index([organizationId])
}

model QuoteCatalogItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  serviceType    String?
  unitType       String   @default("sq_ft")
  unitPrice      Decimal  @default(0) @db.Decimal(12, 2)
  description    String?  @db.Text
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model QuoteInvoice {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteId        String   @db.Uuid
  quote          Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  invoiceNumber  String?
  status         String   @default("draft") // draft | sent | paid | void
  amount         Decimal  @default(0) @db.Decimal(12, 2)
  dueDate        DateTime?
  pdfPath        String?
  notes          String?  @db.Text
  payload        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  receipts InvoiceReceipt[]

  @@index([organizationId])
  @@index([quoteId])
  @@index([organizationId, status])
}

model InvoiceReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  invoiceId      String   @db.Uuid
  invoice        QuoteInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount         Decimal  @db.Decimal(12, 2)
  paidAt         DateTime @default(now())
  method         String?
  notes          String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([invoiceId])
}

model Project {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  builderId      String?  @db.Uuid
  builder        Builder? @relation(fields: [builderId], references: [id], onDelete: SetNull)
  name           String
  status         String   @default("active")
  address        String?
  notes          String?  @db.Text
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  timesheets PayrollTimesheet[]

  @@index([organizationId])
}

model PayrollEmployee {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  roleTitle      String?
  payType        String   @default("hourly") // hourly | salary
  hourlyRate     Decimal  @default(0) @db.Decimal(12, 2)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  timesheets PayrollTimesheet[]

  @@index([organizationId])
}

model PayrollPeriod {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  status         String   @default("open") // open | closed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  timesheets PayrollTimesheet[]

  @@index([organizationId])
}

model PayrollTimesheet {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  periodId       String   @db.Uuid
  period         PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId     String   @db.Uuid
  employee       PayrollEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId      String?  @db.Uuid
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workDate       DateTime @db.Date
  hours          Decimal  @default(0) @db.Decimal(8, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([periodId])
  @@index([employeeId])
}
