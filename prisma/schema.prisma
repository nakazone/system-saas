generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto]
}

// ---------------------------------------------------------------------------
// Platform layer (outside any organization)
// ---------------------------------------------------------------------------

model PlatformAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  status       String   @default("active") // active | disabled
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Organization (tenant root)
// ---------------------------------------------------------------------------

model Organization {
  id               String    @id @default(uuid()) @db.Uuid
  slug             String    @unique
  name             String
  status           String    @default("trial") // trial | active | past_due | canceled
  plan             String    @default("starter")
  logoUrl          String?
  primaryColor     String?
  /// Accent / secondary brand color (maps to SF gold tokens)
  accentColor      String?
  contactEmail     String?
  contactPhone     String?
  /// IANA timezone for displaying visit times (stored UTC in DB)
  timezone         String    @default("America/New_York")
  /// Default quote validity window in days (M2)
  quoteValidityDays Int      @default(30)
  defaultQuoteTerms String?  @db.Text
  quoteTaxRate     Decimal   @default(0) @db.Decimal(5, 2)
  paymentInstructions String? @db.Text
  /// Automation toggles/delays: quoteFollowUpEnabled, quoteFollowUpDays, visitReminderEnabled, visitReminderHours
  automationSettings Json?
  stripeCustomerId String?
  trialEndsAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  users              User[]
  roles              Role[]
  invitations        Invitation[]
  pipelineStages     PipelineStage[]
  lossReasons        LossReason[]
  leads              Lead[]
  customers          Customer[]
  properties         Property[]
  activityEvents     ActivityEvent[]
  quotes             Quote[]
  estimateRules      EstimateRule[]
  partnerUsers       PartnerUser[]
  builders           Builder[]
  pricingItems       PricingItem[]
  suppliers          Supplier[]
  products           Product[]
  categoryMargins    CategoryMargin[]
  quoteCatalogItems  QuoteCatalogItem[]
  quoteAddOns        QuoteAddOn[]
  quoteInvoices      QuoteInvoice[]
  invoiceLineItems   InvoiceLineItem[]
  invoiceReceipts    InvoiceReceipt[]
  publicAccessTokens PublicAccessToken[]
  checklistTemplates ChecklistTemplate[]
  checklistResponses ChecklistResponse[]
  siteAssessments    SiteAssessment[]
  paymentSchedules   PaymentSchedule[]
  paymentScheduleItems PaymentScheduleItem[]
  orgPaymentTemplates OrgPaymentTemplate[]
  documentSequences  DocumentSequence[]
  projects           Project[]
  projectEvents      ProjectEvent[]
  visits             Visit[]
  crews              Crew[]
  crewMembers        CrewMember[]
  laborRates         LaborRate[]
  laborEntries       LaborEntry[]
  materialOrders     MaterialOrder[]
  expenses           Expense[]
  projectBudgetLines ProjectBudgetLine[]
  scheduledMessages  ScheduledMessage[]
  communicationLogs  CommunicationLog[]
  payrollEmployees   PayrollEmployee[]
  payrollPeriods     PayrollPeriod[]
  payrollHourBankEntries PayrollHourBankEntry[]
  financeCosts       FinanceCost[]
  financePayrollAbatements FinancePayrollAbatement[]
  supportTickets     SupportTicket[]
  pushSubscriptions  PushSubscription[]
  workOrders         WorkOrder[]
  workOrderMembers   WorkOrderMember[]
  workOrderTempWorkers WorkOrderTempWorker[]
  workOrderLineItems WorkOrderLineItem[]
  meetings           Meeting[]
}

// ---------------------------------------------------------------------------
// Auth / staff users
// ---------------------------------------------------------------------------

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email              String
  passwordHash       String
  name               String
  roleId             String?  @db.Uuid
  role               Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  status             String   @default("active") // active | invited | suspended | disabled
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  permissions UserPermission[]
  ownedLeads  Lead[]           @relation("LeadOwner")
  salesQuotes Quote[]          @relation("QuoteSalesperson")
  assignedAssessments SiteAssessment[] @relation("AssessmentAssignee")
  completedChecklists ChecklistResponse[] @relation("ChecklistCompleter")
  assignedVisits Visit[] @relation("VisitAssignee")
  crewMemberships CrewMember[]
  projectEvents ProjectEvent[] @relation("ProjectEventActor")
  laborRates LaborRate[]
  laborEntries LaborEntry[]
  supportTickets SupportTicket[] @relation("SupportTicketAuthor")
  pushSubscriptions PushSubscription[]
  assignedWorkOrders WorkOrder[] @relation("WorkOrderAssignee")
  assignedMeetings Meeting[] @relation("MeetingAssignee")
  workOrderMemberships WorkOrderMember[]
  payrollEmployee PayrollEmployee?

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  group       String
  description String?

  userPermissions UserPermission[]
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserPermission {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @db.Uuid
  permissionId String  @db.Uuid
  granted      Boolean @default(true)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model Invitation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  roleId         String   @db.Uuid
  token          String   @unique
  status         String   @default("pending") // pending | accepted | expired
  invitedBy      String?  @db.Uuid
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([token])
}

// ---------------------------------------------------------------------------
// External partner users (JWT auth — model prepared for later portal)
// ---------------------------------------------------------------------------

model PartnerUser {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  passwordHash   String
  name           String
  companyName    String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Leads / pipeline
// ---------------------------------------------------------------------------

model PipelineStage {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String?
  order          Int
  color          String?
  isClosed       Boolean @default(false)
  isActive       Boolean @default(true)
  /// Fixed system milestones: new | assessment_scheduled | quote_sent | won | lost
  isSystemMilestone Boolean @default(false)

  leads Lead[]

  @@index([organizationId])
  @@unique([organizationId, order])
  @@unique([organizationId, slug])
}

model LossReason {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  leads Lead[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Lead {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  phone           String?
  source          String?
  status          String   @default("new")
  notes           String?  @db.Text
  /// Extra CRM fields (qualification, interactions, followups, address, etc.) for SF UI parity
  metadata        Json?
  pipelineStageId String?  @db.Uuid
  pipelineStage   PipelineStage? @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  ownerId         String?  @db.Uuid
  owner           User?    @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lossReasonId    String?  @db.Uuid
  lossReason      LossReason? @relation(fields: [lossReasonId], references: [id], onDelete: SetNull)
  lostAt          DateTime?
  lastContactedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customers Customer[]
  siteAssessments SiteAssessment[]

  @@index([organizationId])
  @@index([organizationId, pipelineStageId])
  @@index([lossReasonId])
  @@index([ownerId])
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?  @db.Uuid
  lead           Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  name           String
  email          String?
  phone          String?
  /// @deprecated Prefer Property records. Kept for back-compat; do not remove in M1.
  address        String?
  customerType   String   @default("residential") // residential | builder | commercial
  company        String?
  notes          String?  @db.Text
  /// Opt-in for marketing blasts (future). Transactional emails ignore this.
  marketingConsent Boolean @default(true)
  /// When true, skip transactional automations (quote follow-ups, visit reminders).
  transactionalOptOut Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quotes     Quote[]
  properties Property[]
  siteAssessments SiteAssessment[]
  invoices   QuoteInvoice[]
  projects   Project[]
  scheduledMessages ScheduledMessage[]
  communicationLogs CommunicationLog[]
  workOrders WorkOrder[]
  meetings   Meeting[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Properties (job site addresses) + immutable activity history
// ---------------------------------------------------------------------------

model Property {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String   @db.Uuid
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label          String?
  line1          String
  line2          String?
  city           String
  state          String
  postalCode     String
  country        String   @default("US")
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, customerId])

  quotes Quote[]
  siteAssessments SiteAssessment[]
  projects Project[]
}

/// Immutable audit log. Application must never update or delete rows.
model ActivityEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String // quote | project | visit | invoice | payment | lead | customer | property
  entityId       String   @db.Uuid
  actorType      String // user | customer | system
  actorId        String?  @db.Uuid
  action         String // created | status_changed | updated | approved | signed | ...
  changes        Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Checklists (generic) + site assessments (measurement visits)
// ---------------------------------------------------------------------------

model ChecklistTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// site_assessment | visit
  appliesTo      String
  /// For visit templates: removal | subfloor_prep | installation | sanding_finishing | final_walkthrough | other
  visitPhase     String?
  /// Ordered fields: { id, label, type, options?, required }
  fields         Json
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  responses ChecklistResponse[]

  @@index([organizationId])
  @@index([organizationId, appliesTo])
}

model ChecklistResponse {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId     String?   @db.Uuid
  template       ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// Snapshot of template fields at fill time (immutable for historical answers)
  templateSnapshot Json
  /// site_assessment | visit | …
  entityType     String
  entityId       String    @db.Uuid
  answers        Json      @default("{}")
  completedAt    DateTime?
  completedById  String?   @db.Uuid
  completedBy    User?     @relation("ChecklistCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  siteAssessments SiteAssessment[]
  visits          Visit[]

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([templateId])
}

model SiteAssessment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?   @db.Uuid
  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId     String?   @db.Uuid
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  propertyId     String?   @db.Uuid
  property       Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  assignedUserId String?   @db.Uuid
  assignedUser   User?     @relation("AssessmentAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  /// unscheduled | scheduled | completed | canceled
  status         String    @default("unscheduled")
  instructions   String?   @db.Text
  checklistResponseId String? @db.Uuid
  checklistResponse   ChecklistResponse? @relation(fields: [checklistResponseId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, assignedUserId])
  @@index([leadId])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Quotes / estimates
// ---------------------------------------------------------------------------

model EstimateRule {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  flooringType     String // hardwood | lvp | laminate | tile | carpet
  wastePercent     Decimal  @db.Decimal(5, 2)
  materialMarkup   Decimal  @db.Decimal(5, 2)
  laborMarkup      Decimal  @db.Decimal(5, 2)
  defaultPricePerSqft Decimal? @db.Decimal(10, 2)
  defaultLaborPerSqft Decimal? @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([organizationId, flooringType])
  @@index([organizationId])
}

model Quote {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String?  @db.Uuid
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  propertyId     String?  @db.Uuid
  property       Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  salespersonId  String?  @db.Uuid
  salesperson    User?    @relation("QuoteSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  leadId         String?  @db.Uuid
  builderId      String?  @db.Uuid
  builder        Builder? @relation(fields: [builderId], references: [id], onDelete: SetNull)
  number         Int
  quoteNumber    String?
  title          String
  /// draft | sent | changes_requested | approved | converted | archived | expired
  /// Legacy: accepted→approved, rejected→archived (migrated in M2)
  status         String   @default("draft")
  flooringType   String   @default("hardwood")
  areaSqft       Decimal  @default(0) @db.Decimal(12, 2)
  wastePercent   Decimal  @default(0) @db.Decimal(5, 2)
  materialCost   Decimal  @default(0) @db.Decimal(12, 2)
  laborCost      Decimal  @default(0) @db.Decimal(12, 2)
  materialMarkup Decimal  @default(0) @db.Decimal(5, 2)
  laborMarkup    Decimal  @default(0) @db.Decimal(5, 2)
  subtotal       Decimal  @default(0) @db.Decimal(12, 2)
  discountType   String?  // percent | fixed
  discountValue  Decimal  @default(0) @db.Decimal(12, 2)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  taxTotal       Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @default(0) @db.Decimal(12, 2)
  notes          String?  @db.Text
  clientMessage  String?  @db.Text
  terms          String?  @db.Text
  /// Flags: showQuantities, showUnitPrices, showLineTotals, showRoomBreakdown
  clientView     Json?
  validUntil     DateTime?
  selectedOptionGroupId String? @db.Uuid
  archiveReason  String?
  signatureUrl   String?
  signedByName   String?
  signedAt       DateTime?
  approvedIp     String?
  approvedUserAgent String?
  changeRequestNote String? @db.Text
  viewedAt       DateTime?
  serviceType    String?
  /// @deprecated M2: prefer PublicAccessToken. Kept for dual-read during migration.
  publicToken    String?  @unique
  /// Full SF quote-builder payload for parity while APIs evolve
  payload        Json?
  invoicePdfPath String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lineItems    QuoteLineItem[]
  rooms        QuoteRoom[]
  optionGroups QuoteOptionGroup[]
  invoices     QuoteInvoice[]
  paymentSchedule PaymentSchedule?
  project      Project?

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, salespersonId])
}

model QuoteRoom {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  quoteId        String  @db.Uuid
  quote          Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name           String
  areaSqft       Decimal @db.Decimal(12, 2)
  notes          String?
  sortOrder      Int     @default(0)

  lineItems QuoteLineItem[]

  @@index([organizationId])
  @@index([quoteId])
}

model QuoteOptionGroup {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  quoteId        String  @db.Uuid
  quote          Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name           String
  flooringType   String?
  sortOrder      Int     @default(0)

  lineItems QuoteLineItem[]

  @@index([organizationId])
  @@index([quoteId])
}

model QuoteLineItem {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  quoteId        String  @db.Uuid
  quote          Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  roomId         String? @db.Uuid
  room           QuoteRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  optionGroupId  String? @db.Uuid
  optionGroup    QuoteOptionGroup? @relation(fields: [optionGroupId], references: [id], onDelete: SetNull)
  name           String?
  description    String
  quantity       Decimal @db.Decimal(12, 2)
  unit           String  @default("sqft")
  unitCost       Decimal @default(0) @db.Decimal(12, 2)
  unitPrice      Decimal @db.Decimal(12, 2)
  amount         Decimal @db.Decimal(12, 2)
  isOptional     Boolean @default(false)
  isSelected     Boolean @default(true)
  itemType       String  @default("service") // service | product
  productId      String? @db.Uuid
  catalogId      String? @db.Uuid
  sortOrder      Int     @default(0)
  meta           Json?

  budgetLines ProjectBudgetLine[]
  expenses    Expense[]

  @@index([organizationId])
  @@index([quoteId])
  @@index([roomId])
  @@index([optionGroupId])
}

/// Suggested optional add-ons for quotes (Settings → Quotes)
model QuoteAddOn {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  unit           String   @default("each")
  unitCost       Decimal  @default(0) @db.Decimal(12, 2)
  unitPrice      Decimal  @default(0) @db.Decimal(12, 2)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

/// Hashed magic-link tokens for public portals (quotes, invoices, …)
model PublicAccessToken {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String // quote | invoice | …
  entityId       String    @db.Uuid
  tokenHash      String
  expiresAt      DateTime
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  viewedAt       DateTime?
  createdAt      DateTime  @default(now())

  @@unique([tokenHash])
  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
}

// ---------------------------------------------------------------------------
// Cadastro / ERP / Builders / Pricing / Payroll / Invoices / Projects
// ---------------------------------------------------------------------------

model Builder {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String   @default("")
  email          String?
  phone          String?
  company        String?
  type           String   @default("builder")
  status         String   @default("active") // active | pending | inactive
  address        String?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quotes   Quote[]
  projects Project[]
  workOrders WorkOrder[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model PricingItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  category       String   @default("installation") // supply | installation | sand_finish | custom
  unit           String   @default("sq_ft")
  price          Decimal  @default(0) @db.Decimal(12, 2) // legacy single price
  priceMin       Decimal  @default(0) @db.Decimal(12, 2)
  priceMax       Decimal  @default(0) @db.Decimal(12, 2)
  partnerPrice   Decimal? @db.Decimal(12, 2)
  description    String?  @db.Text
  notes          String?  @db.Text
  isVisible      Boolean  @default(true)
  isLocked       Boolean  @default(false)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workOrderLines WorkOrderLineItem[]

  @@index([organizationId])
}

model Supplier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  notes          String?  @db.Text
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]

  @@index([organizationId])
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String?  @db.Uuid
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  name           String
  category       String   @default("Hardwood")
  unitType       String   @default("sq_ft")
  costPrice      Decimal  @default(0) @db.Decimal(12, 4)
  sku            String?
