  workOrder      WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  pricingItemId  String?      @db.Uuid
  pricingItem    PricingItem? @relation(fields: [pricingItemId], references: [id], onDelete: SetNull)
  serviceName    String
  /// Optional note for this service line (shown on the job, not required for billing).
  notes          String?
  quantitySqft   Decimal      @default(0) @db.Decimal(12, 2)
  unitPrice      Decimal      @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal      @default(0) @db.Decimal(12, 2)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([workOrderId])
  @@index([pricingItemId])
}

/// CRM users on a job team (multi-select beyond the single responsável).
model WorkOrderMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrderId    String       @db.Uuid
  workOrder      WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([workOrderId, userId])
  @@index([organizationId])
  @@index([userId])
}

/// Temporary / guest worker on a job — no CRM login; share link for job info.
model WorkOrderTempWorker {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @db.Uuid
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrderId         String       @db.Uuid
  workOrder           WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  name                String
  phone               String?
  email               String?
  notes               String?
  /// Raw token of the current ticket link, kept so "copy link" again sends the same URL
  /// instead of revoking the one the worker already has. Hash lives in PublicAccessToken.
  shareToken          String?
  shareTokenExpiresAt DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([organizationId])
  @@index([workOrderId])
}

model Meeting {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  /// scheduled | completed | canceled
  status         String       @default("scheduled")
  scheduledStart DateTime
  scheduledEnd   DateTime
  /// True = spans calendar day(s) without timed slots (Agenda “Dia inteiro”).
  allDay         Boolean      @default(false)
  location       String?
  notes          String?      @db.Text
  customerId     String?      @db.Uuid
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedUserId String?      @db.Uuid
  assignedUser   User?        @relation("MeetingAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  /// Custom agenda id from Organization.scheduleSettings (null = Meetings)
  calendarId     String?      @db.Uuid
  /// Lead visit booked from the lead page (Lead.metadata.visits[].meeting_id points back here).
  leadId         String?      @db.Uuid
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, scheduledStart])
  @@index([organizationId, status])
  @@index([organizationId, calendarId])
  @@index([customerId])
  @@index([assignedUserId])
  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Campo — ponto ao vivo (instaladores / lixadores)
// ---------------------------------------------------------------------------

/// One shift (turno) per user per calendar day. Open until clock-out.
/// userId is null for a day the office logged for an employee without a login.
model CampoShift {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @db.Uuid
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId            String?          @db.Uuid
  user              User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Calendar day in org-local intent (stored as date)
  workDate          DateTime         @db.Date
  clockInAt         DateTime
  clockOutAt        DateTime?
  /// open | closed
  status            String           @default("open")
  /// Dia de trabalho (payroll) ---------------------------------------------
  employeeId        String?          @db.Uuid
  employee          PayrollEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  /// clock | manual | auto_closed
  source            String           @default("clock")
  /// in_progress | pending (admin review) | approved | returned
  reviewStatus      String           @default("in_progress")
  /// Reasons the day needs review: ["manual","far_from_job",...]
  flags             Json?
  note              String?
  reviewNote        String?
  reviewedById      String?          @db.Uuid
  reviewedAt        DateTime?
  submittedAt       DateTime?
  clockInLat        Decimal?         @db.Decimal(10, 7)
  clockInLng        Decimal?         @db.Decimal(10, 7)
  clockInAccuracyM  Decimal?         @db.Decimal(10, 2)
  clockInDistanceM  Int?
  clockInDeviceAt   DateTime?
  clockOutLat       Decimal?         @db.Decimal(10, 7)
  clockOutLng       Decimal?         @db.Decimal(10, 7)
  clockOutAccuracyM Decimal?         @db.Decimal(10, 2)
  clockOutDistanceM Int?
  clockOutDeviceAt  DateTime?
  expectedStartAt   DateTime?
  expectedEndAt     DateTime?
  workedMinutes     Int              @default(0)
  lunchMinutes      Int              @default(0)
  overtimeMinutes   Int              @default(0)
  daysWorked        Decimal          @default(1) @db.Decimal(4, 2)
  sqft              Decimal          @default(0) @db.Decimal(12, 2)
  amount            Decimal          @default(0) @db.Decimal(12, 2)
  sector            String?
  timesheetId       String?          @db.Uuid
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  segments CampoSegment[]
  jobs     CampoShiftJob[]
  expenses CampoShiftExpense[]

  @@unique([organizationId, userId, workDate])
  @@index([organizationId])
  @@index([userId, status])
  @@index([organizationId, status])
  @@index([organizationId, reviewStatus])
  @@index([employeeId, workDate])
}

/// Jobs the employee worked on during a Dia de trabalho.
model CampoShiftJob {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shiftId        String       @db.Uuid
  shift          CampoShift   @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  workOrderId    String       @db.Uuid
  workOrder      WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  arrivedAt      DateTime?
  sqft           Decimal      @default(0) @db.Decimal(12, 2)
  /// Photos of the day by this employee on this job (snapshot at submit)
  photoCount     Int          @default(0)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([shiftId, workOrderId])
  @@index([organizationId])
  @@index([workOrderId])
}

/// Reembolso / desconto ligado a um dia de trabalho (recibo do funcionário ou lançamento do escritório).
model CampoShiftExpense {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shiftId        String          @db.Uuid
  shift          CampoShift      @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employeeId     String          @db.Uuid
  employee       PayrollEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// reimbursement | discount
  kind           String
  amount         Decimal         @db.Decimal(12, 2)
  description    String?
  receiptUrl     String?
  receiptKey     String?
  /// pending | approved | rejected
  status         String          @default("pending")
  /// employee | office
  source         String          @default("employee")
  /// When rolled into PayrollPeriodAdjustment
  appliedAt      DateTime?
  createdById    String?         @db.Uuid
  reviewedById   String?         @db.Uuid
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
  @@index([shiftId])
  @@index([employeeId, status])
  @@index([organizationId, status])
}

/// One employee paid for one period — mirrored as a Finance outflow.
model PayrollPayment {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @db.Uuid
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periodId           String          @db.Uuid
  period             PayrollPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId         String          @db.Uuid
  employee           PayrollEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount             Decimal         @db.Decimal(12, 2)
  paidOn             DateTime        @db.Date
  method             String?
  reference          String?
  notes              String?
  sector             String?
  /// paid | void
  status             String          @default("paid")
  financeAbatementId String?         @db.Uuid
  createdById        String?         @db.Uuid
  voidedAt           DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([organizationId])
  @@index([periodId])
  @@index([employeeId, paidOn])
}

/// Activity segment inside a shift (na obra / deslocamento / compras / pausa).
model CampoSegment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shiftId        String       @db.Uuid
  shift          CampoShift   @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  /// on_site | travel | shopping | break
  activityKind   String
  workOrderId    String?      @db.Uuid
  workOrder      WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  startedAt      DateTime
  endedAt        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([shiftId])
  @@index([workOrderId])
  @@index([shiftId, endedAt])
}

/// Weekly timesheet draft/submit for Campo (Minhas horas).
model CampoWeekSubmission {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Monday of the week (date)
  weekStart      DateTime     @db.Date
  /// draft | submitted
  status         String       @default("draft")
  submittedAt    DateTime?
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId, weekStart])
  @@index([organizationId])
  @@index([userId, status])
}

/// Manual hours or production log (forgot clock / sqft correction).
model CampoManualEntry {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String       @db.Uuid
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workDate        DateTime     @db.Date
  /// hours | production
  entryType       String
  /// on_site | travel | shopping (hours only)
  activityKind    String?
  workOrderId     String?      @db.Uuid
  workOrder       WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  /// hours (decimal) when entryType=hours
  hours           Decimal?     @db.Decimal(8, 2)
  /// sqft when entryType=production
  sqft            Decimal?     @db.Decimal(12, 2)
  reason          String?
  /// pending | submitted
  status          String       @default("pending")
  hourBankEntryId String?      @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@index([userId, workDate])
  @@index([workOrderId])
  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Platform / system settings (no tenant RLS — e.g. VAPID keys)
// ---------------------------------------------------------------------------

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Web Push subscriptions (PWA — iOS Home Screen + Android/Desktop)
// ---------------------------------------------------------------------------

model PushSubscription {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint       String       @db.Text
  p256dh         String
  auth           String
  userAgent      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([endpoint])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, userId])
}

/// In-app inbox (bell) + the source of truth for what was pushed to the PWA.
model StaffNotification {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// lead.created | quote.approved | quote.signed | quote.changes_requested | quote.viewed | invoice.payment | job.assigned | job.updated | job.reminder | chat.message | chat.mention | payroll.returned | payroll.paid | visit.scheduled | mate.brief | job.problem | jobs.nocrew
  type           String
  title          String
  body           String       @db.Text
  url            String?
  dedupeKey      String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId, dedupeKey])
  @@index([organizationId, userId, createdAt])
  @@index([organizationId, userId, readAt])
}

// ---------------------------------------------------------------------------
// Internal chat (DM / group / job channel) — permanent job communication log
// ---------------------------------------------------------------------------

/// dm | group | job
model ChatConversation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// dm | group | job
  type           String
  /// Set when type = job; one channel per work order
  workOrderId    String?      @unique @db.Uuid
  workOrder      WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  name           String?
  /// Sorted "userIdA:userIdB" for DM uniqueness within org
  dmKey          String?
  createdById    String?      @db.Uuid
  createdBy      User?        @relation("ChatConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// When set, conversation is read-only (e.g. job completed/canceled)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members  ChatConversationMember[]
  contexts ChatConversationContext[]
  messages ChatMessage[]

  @@unique([organizationId, dmKey])
  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, archivedAt])
  @@index([workOrderId])
  @@index([createdById])
}

model ChatConversationMember {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @db.Uuid
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId    String           @db.Uuid
  conversation      ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId            String           @db.Uuid
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// member | admin
  role              String           @default("member")
  muted             Boolean          @default(false)
  lastReadAt        DateTime?
  lastReadMessageId String?          @db.Uuid
  joinedAt          DateTime         @default(now())
  leftAt            DateTime?

  @@unique([conversationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([conversationId, lastReadAt])
  @@index([organizationId, userId, leftAt])
}

/// Per-user "talking about" job context in a DM/group
model ChatConversationContext {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId String           @db.Uuid
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String           @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workOrderId    String           @db.Uuid
  workOrder      WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  updatedAt      DateTime         @updatedAt
  createdAt      DateTime         @default(now())

  @@unique([conversationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([workOrderId])
}

model ChatMessage {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId  String           @db.Uuid
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId        String?          @db.Uuid
  author          User?            @relation("ChatMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body            String           @db.Text
  /// Phase 2 threads — reserved
  parentMessageId String?          @db.Uuid
  parentMessage   ChatMessage?     @relation("ChatMessageThread", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies         ChatMessage[]    @relation("ChatMessageThread")
  /// text | system
  type            String           @default("text")
  createdAt       DateTime         @default(now())
  editedAt        DateTime?
  hiddenAt        DateTime?
  hiddenById      String?          @db.Uuid
  hiddenBy        User?            @relation("ChatMessageHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)

  edits       ChatMessageEdit[]
  jobLinks    ChatMessageJob[]
  mentions    ChatMessageMention[]
  attachments ChatAttachment[]
  flags       ChatMessageFlag[]

  @@index([organizationId])
  @@index([conversationId, createdAt])
  @@index([authorId])
  @@index([parentMessageId])
  @@index([organizationId, hiddenAt])
}

model ChatMessageEdit {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messageId      String       @db.Uuid
  message        ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  previousBody   String       @db.Text
  editedById     String?      @db.Uuid
  editedBy       User?        @relation("ChatMessageEditAuthor", fields: [editedById], references: [id], onDelete: SetNull)
  editedAt       DateTime     @default(now())

  @@index([organizationId])
  @@index([messageId, editedAt])
  @@index([editedById])
}

model ChatMessageJob {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messageId      String       @db.Uuid
  message        ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  workOrderId    String       @db.Uuid
  workOrder      WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  linkedById     String?      @db.Uuid
  linkedBy       User?        @relation("ChatMessageJobLinker", fields: [linkedById], references: [id], onDelete: SetNull)
  linkedAt       DateTime     @default(now())
  /// inline | context | retroactive
  source         String       @default("inline")

  @@unique([messageId, workOrderId])
  @@index([organizationId])
  @@index([workOrderId])
  @@index([linkedById])
  @@index([workOrderId, linkedAt])
}

model ChatMessageMention {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messageId      String       @db.Uuid
  message        ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// user | team | all
  mentionType    String       @default("user")
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@unique([messageId, userId])
  @@index([organizationId])
  @@index([userId, readAt])
  @@index([messageId])
}

model ChatAttachment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messageId      String       @db.Uuid
  message        ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storageKey     String
  mimeType       String
  size           Int
  width          Int?
  height         Int?
  thumbnailKey   String?
  capturedAt     DateTime?
  lat            Decimal?     @db.Decimal(10, 7)
  lng            Decimal?     @db.Decimal(10, 7)
  /// Phase 2 — audio transcription
  transcription  String?      @db.Text
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([messageId])
  @@index([organizationId, mimeType])
}

model ChatAuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?      @db.Uuid
  actor          User?        @relation("ChatAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  targetType     String
  targetId       String       @db.Uuid
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
}

/// Phase 2 stub — decision / pending / task flags on messages (no UI yet)
model ChatMessageFlag {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messageId      String       @db.Uuid
  message        ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// decision | pending | task
  type           String
  assigneeId     String?      @db.Uuid
  assignee       User?        @relation("ChatMessageFlagAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate        DateTime?
  /// open | done | canceled
  status         String       @default("open")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([messageId])
  @@index([assigneeId])
  @@index([organizationId, type, status])
}

/// Field Quote (módulo extra): medição e orçamento na casa do cliente, feito no celular.
/// `data` guarda serviços, cômodos, extras, respostas e fotos; vira um Quote de verdade ao gerar.
model FieldQuote {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?      @db.Uuid
  meetingId      String?      @db.Uuid
  quoteId        String?      @db.Uuid
  createdById    String?      @db.Uuid
  /// draft | quoted
  status         String       @default("draft")
  clientName     String
  clientPhone    String?
  clientEmail    String?
  address        String?
  /// particular | builder | contractor | loja (picks the Tabela de Valores column)
  customerType   String       @default("particular")
  data           Json?
  totalSqft      Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @default(0) @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, updatedAt])
  @@index([leadId])
  @@index([quoteId])
}

/// Messages after the first one in a support ticket (company ↔ platform team).
model SupportTicketMessage {
  id             String        @id @default(uuid()) @db.Uuid
  ticketId       String        @db.Uuid
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organizationId String        @db.Uuid
  /// company | platform
  authorType     String
  authorId       String?       @db.Uuid
  authorName     String
  body           String        @db.Text
  createdAt      DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Interface languages (Master › Idiomas)
// ---------------------------------------------------------------------------

/// Word/expression swap in one interface language, e.g. pt: "Orçamento" → "Quote".
model I18nTerm {
  id            String   @id @default(uuid()) @db.Uuid
  locale        String // pt | en | es
  find          String
  replace       String
  findPlural    String?
  replacePlural String?
  matchCase     Boolean  @default(false)
  active        Boolean  @default(true)
  note          String?
  updatedById   String?  @db.Uuid
  updatedByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([locale])
}

/// Edited translation of one interface text (missing row = text from dictionary.json).
model I18nPhrase {
  source        String
  locale        String // pt | en | es
  text          String   @db.Text
  /// true when the text isn't in the base dictionary (added by the Master)
  custom        Boolean  @default(false)
  updatedById   String?  @db.Uuid
  updatedByName String
  updatedAt     DateTime @updatedAt

  @@id([source, locale])
}

/// Browser voice sessions with transcript-only history; raw audio is never stored.
model MateVoiceConversation {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?            @db.Uuid
  createdBy      User?              @relation("MateVoiceConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  leadId         String?            @db.Uuid
  lead           Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId     String?            @db.Uuid
  customer       Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  title          String             @default("Conversa por voz")
  status         String             @default("active") // active | completed | failed
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  endedAt        DateTime?
  messages       MateVoiceMessage[]

  @@index([organizationId, createdById, createdAt])
  @@index([organizationId, createdAt])
  @@index([leadId])
  @@index([customerId])
}

model MateVoiceMessage {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId String                @db.Uuid
  conversation   MateVoiceConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  content        String                @db.Text
  createdAt      DateTime              @default(now())

  @@index([organizationId, conversationId, createdAt])
}

model MateAiConversation {
  id             String       @id @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  /// Plain text of the requests and results, for search.
  searchText     String       @default("")
  /// What came out of it ("Quote Q-1002 criado"), shown under the title.
  outcome        String?
  items          Json
  turns          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, userId, updatedAt])
}

/// ───────────── Builder accounts (platform level, free) ─────────────
/// A builder signs up on its own, invites its team and links the flooring companies it sends work to.
/// Inside each linked company it is a normal Builder row (BuilderLink.tenantBuilderId).
model BuilderAccount {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  phone           String?
  website         String?
  /// Contact details (ObraBuilder › Settings)
  email           String?
  billingEmail    String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  licenseNumber   String?
  logoUrl         String?
  /// Floor plan takeoff settings: { waste: { hardwood: 10, lvp: 10, … }, box_sf: { … } }
  takeoffSettings Json     @default("{}")
  /// active | suspended
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members           BuilderMember[]
  links             BuilderLink[]
  measurements      BuilderMeasurement[]
  pickupLocations   BuilderPickupLocation[]
  priceItems        BuilderPriceItem[]
  notifications     BuilderNotification[]
  jobWatches        BuilderJobWatch[]
  pushSubscriptions BuilderPushSubscription[]
}

model BuilderMember {
  id                  String         @id @default(uuid()) @db.Uuid
  builderAccountId    String         @db.Uuid
  account             BuilderAccount @relation(fields: [builderAccountId], references: [id], onDelete: Cascade)
  email               String         @unique
  name                String
  phone               String?
  passwordHash        String?
  /// Job title shown on the team ("Superintendent", "Purchasing").
  title               String?
  /// admin | manager | office | field
  role                String         @default("office")
  /// pending_email (sign-up not confirmed) | invited | active | disabled
  status              String         @default("pending_email")
  /// Hash of the one-time link (confirm e-mail / accept invite / reset password).
  tokenHash           String?        @unique
  tokenPurpose        String?
  tokenExpiresAt      DateTime?
  invitedById         String?        @db.Uuid
  lastLoginAt         DateTime?
  /// Notifications up to this moment count as seen (bell badge).
  notificationsSeenAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([builderAccountId])
}

/// What happened to the builder's work at a company: accepted & scheduled, photos, on site, done.
model BuilderNotification {
  id               String         @id @default(uuid()) @db.Uuid
  builderAccountId String         @db.Uuid
  account          BuilderAccount @relation(fields: [builderAccountId], references: [id], onDelete: Cascade)
  /// accepted | declined | scheduled | rescheduled | started | photos | completed | report
  kind             String
  title            String
  body             String?
  /// Hash route in the portal, e.g. "#jobs/<id>"
  url              String?
  companyName      String?
  organizationId   String?        @db.Uuid
  workOrderId      String?        @db.Uuid
  requestId        String?        @db.Uuid
  createdAt        DateTime       @default(now())

  @@index([builderAccountId, createdAt])
}

/// Last state the watcher saw for a job or request, to tell what changed.
model BuilderJobWatch {
  id               String         @id @default(uuid()) @db.Uuid
  builderAccountId String         @db.Uuid
  account          BuilderAccount @relation(fields: [builderAccountId], references: [id], onDelete: Cascade)
  /// "job:<workOrderId>" or "req:<requestId>"
  key              String
  status           String?
  scheduledStart   DateTime?
  photos           Int            @default(0)
  reports          Int            @default(0)
  updatedAt        DateTime       @updatedAt
  createdAt        DateTime       @default(now())

  @@unique([builderAccountId, key])
}

/// Web Push devices of builder team members (ObraBuilder app).
model BuilderPushSubscription {
  id               String         @id @default(uuid()) @db.Uuid
  builderAccountId String         @db.Uuid
  account          BuilderAccount @relation(fields: [builderAccountId], references: [id], onDelete: Cascade)
  memberId         String         @db.Uuid
  endpoint         String         @unique
  p256dh           String
  auth             String
  userAgent        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([builderAccountId])
}

model BuilderLink {
  id               String         @id @default(uuid()) @db.Uuid
  builderAccountId String         @db.Uuid
  account          BuilderAccount @relation(fields: [builderAccountId], references: [id], onDelete: Cascade)
  /// Set when the company is on ObraMate (linked or after it signs up from the invite).
  organizationId   String?        @db.Uuid
  /// invited | active | removed
  status           String         @default("invited")
  /// The Builder row inside the company that represents this account.
  tenantBuilderId  String?        @db.Uuid
  companyName      String
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  /// Company sign-up invite created for a company that is not on ObraMate yet.
  signupInviteId   String?        @db.Uuid
  invitedById      String?        @db.Uuid
  invitedAt        DateTime       @default(now())
  activatedAt      DateTime?
  removedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  pendingJobs BuilderPendingJob[]

  @@index([builderAccountId, status])
  @@index([organizationId])
  @@index([signupInviteId])
}

/// Jobs a builder sent to a company that has not joined yet; delivered when it signs up.
model BuilderPendingJob {
  id            String      @id @default(uuid()) @db.Uuid
  builderLinkId String      @db.Uuid
  link          BuilderLink @relation(fields: [builderLinkId], references: [id], onDelete: Cascade)
  memberId      String      @db.Uuid
  /// Same fields as a portal request (title, address, service_type, preferred_date, notes, external_ref, contact…).
  payload       Json
  /// [{ key, name, contentType, size }] stored under builders/<accountId>/pending/
  files         Json        @default("[]")
  deliveredAt   DateTime?
  workOrderId   String?     @db.Uuid
  createdAt     DateTime    @default(now())

  @@index([builderLinkId, deliveredAt])
}

/// Stairs and vents measured by the builder on site, kept until the work order for that address arrives.
model BuilderMeasurement {
  id                  String         @id @default(uuid()) @db.Uuid
  builderAccountId    String         @db.Uuid
  account             BuilderAccount @relation(fields: [builderAccountId], references: [id], onDelete: Cascade)
  address             String
  /// "322 lower ranch view rd" (number + street) — how a work order finds it.
  addressKey          String
  community           String?
  lot                 String?
  notes               String?
  /// Where it was measured (phone location), to suggest it when the builder is on site again.
  geoLat              Float?
  geoLng              Float?
  /// { stairs: [...], vents: [...] } — see src/lib/builders/measurements.ts
  data                Json           @default("{}")
  /// draft | done | used
  status              String         @default("draft")
  createdByMemberId   String         @db.Uuid
  updatedByMemberId   String?        @db.Uuid
  completedByMemberId String?        @db.Uuid
  completedAt         DateTime?
  /// [{ at, member_id, name, action }]
  log                 Json           @default("[]")
  usedAt              DateTime?
  organizationId      String?        @db.Uuid
  workOrderId         String?        @db.Uuid
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([builderAccountId, addressKey])
  @@index([builderAccountId, status])
}

/// Where the builder's crews pick up delivered material (supplier yards, warehouses).
model BuilderPickupLocation {
  id               String         @id @default(uuid()) @db.Uuid
  builderAccountId String         @db.Uuid
  account          BuilderAccount @relation(fields: [builderAccountId], references: [id], onDelete: Cascade)
  name             String
  address          String
  /// Words that identify it on a work order ("TRIWEST", "HEN", "Henderson").
  aliases          String[]       @default([])
  phone            String?
  hours            String?
  notes            String?
  isDefault        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([builderAccountId])
}

/// Prices the builder agreed with one flooring company (per service), used when sending work orders.
model BuilderPriceItem {
  id               String         @id @default(uuid()) @db.Uuid
  builderAccountId String         @db.Uuid
  account          BuilderAccount @relation(fields: [builderAccountId], references: [id], onDelete: Cascade)
  builderLinkId    String         @db.Uuid
  /// Service in the company's catalog this price is for (when linked).
  pricingItemId    String?        @db.Uuid
  name             String
  /// sq_ft | linear_ft | step | each | hour | fixed
  unit             String         @default("each")
  price            Decimal        @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([builderAccountId, builderLinkId])
}
