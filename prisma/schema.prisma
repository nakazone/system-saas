model SupportTicket {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUserId  String?  @db.Uuid
  createdByUser    User?    @relation("SupportTicketAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  /// question | suggestion | bug | other
  category         String   @default("question")
  subject          String
  body             String   @db.Text
  /// open | closed
  status           String   @default("open")
  adminNote        String?  @db.Text
  closedAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Work orders (jobs outside leads/quotes) + meetings (schedule)
// ---------------------------------------------------------------------------

model WorkOrder {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         Int?
  title          String
  /// draft | scheduled | in_progress | completed | canceled
  status         String    @default("draft")
  /// builder | contractor | internal | other
  sourceType     String    @default("other")
  sourceName     String?
  customerId     String?   @db.Uuid
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  builderId      String?   @db.Uuid
  builder        Builder?  @relation(fields: [builderId], references: [id], onDelete: SetNull)
  address        String?
  notes          String?   @db.Text
  assignedUserId String?   @db.Uuid
  assignedUser   User?     @relation("WorkOrderAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  crewId         String?   @db.Uuid
  crew           Crew?     @relation(fields: [crewId], references: [id], onDelete: SetNull)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  members     WorkOrderMember[]
  tempWorkers WorkOrderTempWorker[]
  lineItems   WorkOrderLineItem[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, scheduledStart])
  @@index([customerId])
  @@index([builderId])
  @@index([assignedUserId])
  @@index([crewId])
}

/// Service lines on a job (sqft × unit price from Loja / partner catalog).
model WorkOrderLineItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrderId    String   @db.Uuid
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  pricingItemId  String?  @db.Uuid
  pricingItem    PricingItem? @relation(fields: [pricingItemId], references: [id], onDelete: SetNull)
  serviceName    String
  quantitySqft   Decimal  @default(0) @db.Decimal(12, 2)
  unitPrice      Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([workOrderId])
  @@index([pricingItemId])
}

/// CRM users on a job team (multi-select beyond the single responsável).
model WorkOrderMember {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrderId    String   @db.Uuid
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([workOrderId, userId])
  @@index([organizationId])
  @@index([userId])
}

/// Temporary / guest worker on a job — no CRM login; share link for job info.
model WorkOrderTempWorker {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrderId    String   @db.Uuid
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  email          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([workOrderId])
}

model Meeting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  /// scheduled | completed | canceled
  status         String   @default("scheduled")
  scheduledStart DateTime
  scheduledEnd   DateTime
  location       String?
  notes          String?  @db.Text
  customerId     String?  @db.Uuid
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedUserId String?  @db.Uuid
  assignedUser   User?    @relation("MeetingAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, scheduledStart])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([assignedUserId])
}

// ---------------------------------------------------------------------------
// Platform / system settings (no tenant RLS — e.g. VAPID keys)
// ---------------------------------------------------------------------------

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Web Push subscriptions (PWA — iOS Home Screen + Android/Desktop)
// ---------------------------------------------------------------------------

model PushSubscription {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint       String   @db.Text
  p256dh         String
  auth           String
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([endpoint])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, userId])
}
