  summary             String?      @db.Text
  observationsJson    Json?
  issuesJson          Json?
  recommendationsJson Json?
  nextStepsJson       Json?
  photoIds            Json
  isPublic            Boolean      @default(false)
  sharedWithPartners  Boolean      @default(false)
  /// ai | manual
