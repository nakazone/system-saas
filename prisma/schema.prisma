generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto]
}

// ---------------------------------------------------------------------------
// Platform layer (outside any organization)
// ---------------------------------------------------------------------------

model PlatformAdmin {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  passwordHash        String
  name                String
  status              String    @default("active") // active | invited | disabled
  /// MASTER (exactly one, enforced by a partial unique index) | ADMIN | FINANCE | SUPPORT | READONLY
  role                String    @default("ADMIN")
  /// TOTP secret, AES-256-GCM encrypted with a key derived from SESSION_SECRET
  totpSecretEnc       String?
  totpEnabledAt       DateTime?
  /// bcrypt hashes of one-time recovery codes; used codes are removed
  recoveryCodeHashes  Json?
  /// sha256 of the activation / password-reset token (one use)
  activationTokenHash String?   @unique
  activationExpiresAt DateTime?
  invitedById         String?   @db.Uuid
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginCount    Int       @default(0)
  lockedUntil         DateTime?
  /// Locked by "não fui eu" on a login alert: only a new access link (master:link / invite again) unlocks.
  securityLockedAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/// Append-only log of everything done in the Master area (UPDATE/DELETE blocked by trigger).
model PlatformAuditLog {
  id          BigInt   @id @default(autoincrement())
  at          DateTime @default(now())
  actorId     String?  @db.Uuid
  actorName   String
  /// e.g. auth.login, tenant.extend, tenant.suspend, payment.record
  action      String
  targetType  String?
  targetId    String?
  targetLabel String?
  meta        Json?
  ip          String?
  userAgent   String?
  stepUp      Boolean  @default(false)

  @@index([at])
  @@index([targetType, targetId])
}

/// Subscription payments recorded by the platform team (manual until Stripe billing ships).
model PlatformPayment {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amountCents     Int
  paidAt          DateTime
  /// card | ach | zelle | check | cash | other
  method          String       @default("card")
  periodStart     DateTime?
  periodEnd       DateTime?
  /// paid | failed | refunded
  status          String       @default("paid")
  note            String?
  recordedById    String?      @db.Uuid
  refundedAt      DateTime?
  /// manual | stripe
  source          String       @default("manual")
  stripeInvoiceId String?      @unique
  stripeChargeId  String?
  /// Stripe hosted invoice page / PDF
  invoiceUrl      String?
  invoicePdfUrl   String?
  failureReason   String?
  createdAt       DateTime     @default(now())

  @@index([organizationId, paidAt])
  @@index([paidAt])
}

model PlatformNote {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  body           String       @db.Text
  authorId       String?      @db.Uuid
  authorName     String
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

/// Plan catalog edited in the Master (prices in cents). Annual price is per year.
model Plan {
  id                   String   @id @default(uuid()) @db.Uuid
  key                  String   @unique
  name                 String
  description          String?
  monthlyCents         Int
  annualCents          Int
  /// null = unlimited
  includedUsers        Int?
  trialDays            Int      @default(30)
  /// Shown on the public site and in the company's plan page
  visible              Boolean  @default(true)
  /// Can be chosen for new subscriptions
  active               Boolean  @default(true)
  sortOrder            Int      @default(0)
  stripeProductId      String?
  stripeMonthlyPriceId String?
  stripeAnnualPriceId  String?
  /// Extra modules included: { featureKey: boolean }. Missing key = included.
  features             Json?
  /// Usage limits: { users, photos_month, ai_month, storage_gb }. Missing/null = no limit.
  limits               Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// Global state of each extra module: off (nobody), beta (only companies with an exception), on.
model PlatformFeature {
  key           String   @id
  state         String   @default("on")
  updatedAt     DateTime @updatedAt
  updatedByName String?
}

/// A module turned on or off for one company, overriding its plan. Expired ones are ignored.
model OrgFeatureOverride {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  featureKey     String
  enabled        Boolean
  reason         String
  endsAt         DateTime?
  createdByName  String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, featureKey])
}

/// Latest state of each background job (one row per job, updated every run).
model JobStatus {
  name           String    @id
  label          String
  intervalSec    Int
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lastOk         Boolean?
  lastError      String?
  lastDurationMs Int?
  lastProcessed  Int?
  runs           Int       @default(0)
  failures       Int       @default(0)
  updatedAt      DateTime  @updatedAt
}

/// Result of each external-service check (every 15 min, kept 30 days).
model ServiceCheck {
  id        BigInt   @id @default(autoincrement())
  service   String
  status    String // ok | warn | down | off
  latencyMs Int?
  detail    String?
  checkedAt DateTime @default(now())

  @@index([service, checkedAt])
}

/// Application errors grouped by fingerprint (server 5xx and browser errors from the CRM).
model ErrorGroup {
  fingerprint String    @id
  source      String // server | browser
  message     String
  stackTop    String?
  path        String?
  method      String?
  firstSeen   DateTime  @default(now())
  lastSeen    DateTime  @default(now())
  count       Int       @default(1)
  lastOrgId   String?   @db.Uuid
  lastUserId  String?   @db.Uuid
  /// Last few occurrences: [{ at, path, method, orgId, userId, ua }]
  samples     Json?
  status      String    @default("open") // open | resolved
  resolvedAt  DateTime?

  @@index([lastSeen])
}

/// In-app notice from the platform to companies (Master › Comunicação).
model PlatformAnnouncement {
  id              String                        @id @default(uuid()) @db.Uuid
  title           String
  body            String                        @db.Text
  kind            String                        @default("info") // info | maintenance | urgent (urgent can't be closed)
  audience        String                        @default("all") // all | plans | companies
  plans           String[]                      @default([])
  organizationIds String[]                      @default([]) @db.Uuid
  linkUrl         String?
  linkLabel       String?
  startsAt        DateTime                      @default(now())
  endsAt          DateTime?
  /// Taken down by the Master before endsAt.
  endedAt         DateTime?
  createdById     String?                       @db.Uuid
  createdByName   String
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  receipts        PlatformAnnouncementReceipt[]

  @@index([startsAt])
}

/// Who saw / closed each notice (one row per user).
model PlatformAnnouncementReceipt {
  announcementId String               @db.Uuid
  userId         String               @db.Uuid
  organizationId String               @db.Uuid
  seenAt         DateTime             @default(now())
  dismissedAt    DateTime?
  announcement   PlatformAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([organizationId])
}

/// Master edits of the platform e-mails (missing row = default text from code).
model PlatformEmailTemplate {
  key           String
  locale        String // en | pt
  subject       String
  body          String   @db.Text
  buttonLabel   String?
  updatedById   String?  @db.Uuid
  updatedByName String
  updatedAt     DateTime @updatedAt

  @@id([key, locale])
}

/// Every e-mail the system sends (kept 90 days). Status follows the Resend webhook.
model PlatformEmailLog {
  id             String    @id @default(uuid()) @db.Uuid
  createdAt      DateTime  @default(now())
  /// platform (ObraMate → company) | company (company → its client/team) | internal (to the Master team)
  category       String
  templateKey    String?
  toEmail        String
  subject        String
  organizationId String?   @db.Uuid
  provider       String // resend | console
  providerId     String?
  /// sent | delivered | opened | clicked | delayed | bounced | complained | failed | blocked | console
  status         String
  error          String?
  lastEventAt    DateTime?
  openedAt       DateTime?
  /// [{ type, at }]
  events         Json?

  @@index([createdAt])
  @@index([toEmail])
  @@index([providerId])
  @@index([organizationId, createdAt])
}

/// Addresses the system no longer e-mails (hard bounce, spam complaint or added by hand).
model EmailSuppression {
  email         String   @id
  reason        String // bounce | complaint | manual
  detail        String?
  createdAt     DateTime @default(now())
  createdByName String?
}

/// Copy of all of a company's data (ZIP with CSVs + files). No FK: survives the company's deletion.
model DataExport {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  orgName          String
  orgSlug          String
  /// queued | running | ready | failed | expired
  status           String    @default("queued")
  reason           String?
  privacyRequestId String?   @db.Uuid
  requestedById    String?   @db.Uuid
  requestedByName  String
  fileKey          String?
  sizeBytes        BigInt?
  tables           Int       @default(0)
  rows             Int       @default(0)
  files            Int       @default(0)
  filesMissing     Int       @default(0)
  error            String?
  startedAt        DateTime?
  finishedAt       DateTime?
  expiresAt        DateTime?
  /// sha256 of the download link token sent to the company (null = no link)
  linkTokenHash    String?   @unique
  linkCreatedAt    DateTime?
  downloads        Int       @default(0)
  lastDownloadAt   DateTime?
  createdAt        DateTime  @default(now())

  @@index([organizationId, createdAt])
  @@index([status])
}

/// Access / correction / deletion requests (CCPA and similar), answered within 30 days.
model PrivacyRequest {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @db.Uuid
  orgName        String?
  /// access | correction | deletion | other
  kind           String
  /// company (the whole account) | person (one client, employee or user)
  subjectType    String    @default("person")
  requesterName  String
  requesterEmail String
  subjectEmail   String?
  subjectPhone   String?
  details        String?   @db.Text
  /// received | in_progress | done | rejected
  status         String    @default("received")
  receivedAt     DateTime  @default(now())
  dueAt          DateTime
  response       String?   @db.Text
  closedAt       DateTime?
  createdByName  String
  handledByName  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, dueAt])
  @@index([organizationId])
}

/// Proof of a permanent deletion (company or one person). Holds counts, never the deleted data.
model DataDeletion {
  id               String   @id @default(uuid()) @db.Uuid
  /// company | person
  kind             String
  organizationId   String   @db.Uuid
  orgName          String
  orgSlug          String
  /// person: masked e-mail / phone (j***@gmail.com · ***-1234)
  subjectMasked    String?
  /// person: sha256 of the normalized e-mail/phone, to answer "was X deleted?"
  subjectHash      String?
  /// { "Lead": 3, "Customer": 1, … } rows deleted or anonymized
  counts           Json
  filesDeleted     Int      @default(0)
  reason           String
  privacyRequestId String?  @db.Uuid
  exportId         String?  @db.Uuid
  exportSkippedWhy String?
  performedById    String?  @db.Uuid
  performedByName  String
  createdAt        DateTime @default(now())

  @@index([organizationId])
}

/// Discount codes (Master › Cupons), mirrored in Stripe as coupon + promotion code.
model Coupon {
  id                    String    @id @default(uuid()) @db.Uuid
  code                  String    @unique
  name                  String
  percentOff            Int?
  amountOffCents        Int?
  /// once | repeating | forever
  duration              String
  durationMonths        Int?
  maxRedemptions        Int?
  expiresAt             DateTime?
  /// Empty = every plan
  plans                 String[]  @default([])
  active                Boolean   @default(true)
  stripeCouponId        String?
  stripePromotionCodeId String?
  timesRedeemed         Int       @default(0)
  createdByName         String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

/// Chargebacks opened against ObraMate charges (from the Stripe webhook).
model PlatformDispute {
  id             String    @id
  organizationId String?   @db.Uuid
  orgName        String?
  paymentId      String?   @db.Uuid
  chargeId       String?
  amountCents    Int
  reason         String
  /// warning_needs_response | needs_response | under_review | won | lost | …
  status         String
  evidenceDueBy  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  closedAt       DateTime?

  @@index([status])
  @@index([organizationId])
}

/// Every cancellation (asked by the company, done by the Master or by Stripe). Survives company deletion.
model CancellationEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  orgName        String
  /// company | master | stripe
  source         String
  reasonKey      String
  comment        String?
  /// Monthly value lost (cents) when it was asked
  mrrCents       Int       @default(0)
  requestedAt    DateTime  @default(now())
  /// When access ends (period end) — null = right away
  effectiveAt    DateTime?
  offerShown     Boolean   @default(false)
  offerAccepted  Boolean   @default(false)
  /// The company changed its mind before the end of the period
  undoneAt       DateTime?
  byName         String?

  @@index([requestedAt])
  @@index([organizationId])
}

/// Every sign-in and failed attempt — Master team and company users (kept 180 days).
model LoginEvent {
  id             String    @id @default(uuid()) @db.Uuid
  /// master | user
  kind           String
  adminId        String?   @db.Uuid
  userId         String?   @db.Uuid
  organizationId String?   @db.Uuid
  email          String
  success        Boolean
  /// wrong_password | wrong_2fa | locked | blocked | recovery_code | …
  reason         String?
  /// totp | recovery | password
  method         String?
  ip             String?
  userAgent      String?
  device         String?
  country        String?
  /// sha256 of the device cookie (Master) — new device = never seen for this account in 180 days
  deviceId       String?
  newDevice      Boolean   @default(false)
  /// "Não fui eu" link sent in the login alert (sha256), single use
  alertTokenHash String?   @unique
  alertUsedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([adminId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Daily snapshot of the business numbers (taken after midnight America/Denver). History for Métricas.
model PlatformDailyMetric {
  day       String   @id // YYYY-MM-DD (America/Denver)
  mrrCents  Int
  paying    Int
  trial     Int
  pastDue   Int
  readOnly  Int
  suspended Int
  canceled  Int
  dau       Int      @default(0)
  wau       Int      @default(0)
  mau       Int      @default(0)
  /// { organizationId: monthly cents } for paying companies — used for MRR movement
  orgMrr    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One row per user per day they used the CRM (America/Denver day). Feeds usage frequency and health.
model ActiveDay {
  userId         String   @db.Uuid
  day            String // YYYY-MM-DD
  organizationId String   @db.Uuid
  createdAt      DateTime @default(now())

  @@id([userId, day])
  @@index([organizationId, day])
}

/// Monthly usage counters that can't be counted from other tables (e.g. AI calls).
model UsageCounter {
  organizationId String   @db.Uuid
  metric         String
  period         String // YYYY-MM (America/Denver)
  count          Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@id([organizationId, metric, period])
}

/// Every Stripe webhook event, processed once.
model StripeEvent {
  id             String    @id
  type           String
  organizationId String?   @db.Uuid
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  error          String?
  payload        Json?

  @@index([receivedAt])
}

/// Billing reminder / state change already done for a company and a due date.
model DunningStep {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  /// YYYY-MM-DD of the due date the step belongs to (a new period starts over)
  dueKey         String
  /// e.g. trial-7, trial-0, due-7, due+7
  step           String
  /// email | state | skipped
  action         String
  detail         String?
  sentAt         DateTime @default(now())

  @@unique([organizationId, dueKey, step])
  @@index([sentAt])
}

/// Background job executions (shown in the Master).
model JobRun {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  processed  Int       @default(0)
  detail     Json?
  error      String?
  trigger    String    @default("schedule")

  @@index([name, startedAt])
}

/// Self-service signup waiting for the e-mail link. The company is only created after the link is confirmed.
model SignupRequest {
  id               String    @id @default(uuid()) @db.Uuid
  tokenHash        String    @unique
  email            String
  organizationName String
  slug             String
  adminName        String
  passwordHash     String
  contactPhone     String?
  timezone         String    @default("America/Denver")
  inviteId         String?   @db.Uuid
  ip               String?
  userAgent        String?
  /// Versions of the legal documents accepted on the form ({ terms, privacy, dpa }).
  legalVersions    Json
  sendCount        Int       @default(1)
  lastSentAt       DateTime  @default(now())
  expiresAt        DateTime
  verifiedAt       DateTime?
  organizationId   String?   @db.Uuid
  createdAt        DateTime  @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

/// Invite link created in the Master (beta by invitation).
model SignupInvite {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique
  email          String?
  companyName    String?
  plan           String    @default("starter")
  trialDays      Int       @default(30)
  note           String?
  createdById    String?   @db.Uuid
  expiresAt      DateTime?
  usedAt         DateTime?
  organizationId String?   @db.Uuid
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([createdAt])
}

/// Who accepted which version of the Terms / Privacy Policy / DPA, when and from where.
model LegalAcceptance {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?      @db.Uuid
  userName       String?
  userEmail      String?
  document       String
  version        String
  source         String       @default("signup")
  ip             String?
  userAgent      String?
  acceptedAt     DateTime     @default(now())

  @@index([organizationId, document, acceptedAt])
}

/// One-use "forgot password" link for company users (1 hour).
model PasswordResetToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String    @db.Uuid
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  ip             String?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Persistent rate-limit counter (survives deploys): one row per attempt.
model RateEvent {
  id        BigInt   @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Conversations with a company's owner / billing contact (calls, e-mails, meetings).
model PlatformContactLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// owner | billing
  contactRole    String       @default("owner")
  contactName    String
  /// call | email | whatsapp | meeting
  kind           String
  summary        String       @db.Text
  authorId       String?      @db.Uuid
  authorName     String
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// Organization (tenant root)
// ---------------------------------------------------------------------------

model Organization {
  id                      String    @id @default(uuid()) @db.Uuid
  slug                    String    @unique
  name                    String
  status                  String    @default("trial") // trial | active | past_due | read_only | suspended | canceled
  plan                    String    @default("starter")
  logoUrl                 String?
  primaryColor            String?
  /// Accent / secondary brand color (maps to SF gold tokens)
  accentColor             String?
  contactEmail            String?
  contactPhone            String?
  /// IANA timezone for displaying visit times (stored UTC in DB)
  timezone                String    @default("America/New_York")
  /// Default quote validity window in days (M2)
  quoteValidityDays       Int       @default(30)
  defaultQuoteTerms       String?   @db.Text
  quoteTaxRate            Decimal   @default(0) @db.Decimal(5, 2)
  paymentInstructions     String?   @db.Text
  /// Prefix for quote numbers shown to clients (e.g. "Q-" → Q-1043)
  quoteNumberPrefix       String    @default("Q-")
  /// Minimum for the next quote number (only moves forward)
  quoteNextNumber         Int?
  /// { client_view: {…}, owner_signature: {…}, share_messages: { sms_body, followup_body } }
  quoteSettings           Json?
  /// { share_messages: { sms_body } } — SMS template when sharing an invoice
  invoiceSettings         Json?
  /// { request_mode: "review" | "automatic" } — partner portal job intake policy
  partnerPortalSettings   Json?
  /// Automation toggles/delays: quoteFollowUpEnabled, quoteFollowUpDays, visitReminderEnabled, visitReminderHours
  automationSettings      Json?
  /// Default lead email/SMS templates per pipeline stage (Configurações › Mensagens por fase)
  leadMessageSettings     Json?
  /// Schedule calendars (Jobs/Meetings colors + custom agendas)
  scheduleSettings        Json?
  stripeCustomerId        String?
  trialEndsAt             DateTime?
  // --- Platform billing (managed in the Master area) ---
  /// monthly | annual
  billingCycle            String    @default("monthly")
  /// Overrides the list price of the plan (cents per cycle)
  planPriceCents          Int?
  /// When the current paid period ends (next renewal)
  currentPeriodEnd        DateTime?
  billingContactName      String?
  billingContactEmail     String?
  billingContactPhone     String?
  suspendedAt             DateTime?
  canceledAt              DateTime?
  cancelReason            String?
  /// Stripe subscription mirrored by the webhook
  stripeSubscriptionId    String?   @unique
  /// Subscription set to end at the period end (canceled in Stripe or by the company)
  cancelAtPeriodEnd       Boolean   @default(false)
  /// When the account entered read-only mode (trial ended / unpaid)
  readOnlySince           DateTime?
  /// Billing reminders paused for this company until this date
  dunningPausedUntil      DateTime?
  /// price | missing_feature | closed | competitor | not_used | other (Master › Métricas)
  cancelReasonKey         String?
  /// When the company asked to cancel at the end of the period
  cancelRequestedAt       DateTime?
  /// Coupon applied to the subscription (code from Coupon)
  couponCode              String?
  /// Default card in Stripe (never the number): brand, last 4, expiry
  cardBrand               String?
  cardLast4               String?
  cardExpMonth            Int?
  cardExpYear             Int?
  cardSyncedAt            DateTime?
  /// Feature flags per org, e.g. { "job_media": true }
  featureFlags            Json?
  // --- Company details (Configurações › Dados da empresa) ---
  legalName               String?
  website                 String?
  addressLine1            String?
  addressLine2            String?
  city                    String?
  state                   String?
  postalCode              String?
  country                 String    @default("US")
  /// Hide the address from client portal, e-mails and PDFs
  addressPrivate          Boolean   @default(false)
  licenseNumber           String?
  licenseState            String?
  licenseExpiresOn        DateTime? @db.Date
  showLicenseOnDocuments  Boolean   @default(true)
  insuranceCarrier        String?
  insurancePolicy         String?
  insuranceExpiresOn      DateTime? @db.Date
  insuranceCertificateUrl String?
  /// { mon: { open: true, start: "07:00", end: "17:00" }, … }
  businessHours           Json?
  /// Default UI language for new users (pt-BR | en | es)
  defaultLocale           String    @default("pt-BR")
  /// sq_ft | m2
  areaUnit                String    @default("sq_ft")
  /// monday | sunday
  weekStart               String    @default("monday")
  googleReviewUrl         String?
  /// Indicações: { enabled, percent, credit_validity_days? } — cashback Particular na fatura paga
  referralSettings        Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  users                    User[]
  roles                    Role[]
  invitations              Invitation[]
