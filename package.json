{
  "name": "obramate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ObraMate — multi-tenant SaaS for flooring installation companies",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc && mkdir -p dist/src dist/crm && cp -R src/views dist/src/views && cp -R src/public dist/src/public && cp -R crm/public dist/crm/public && cp -R crm/assets dist/crm/assets",
    "start": "node scripts/migrate-deploy.mjs && node dist/src/server.js",
    "start:with-migrate": "node scripts/migrate-deploy.mjs && node dist/src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "node scripts/migrate-deploy.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.967.0",
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.9",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/pdfkit": "^0.17.6",
    "vitest": "^4.0.17"
  }
}
