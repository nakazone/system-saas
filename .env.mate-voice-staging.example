# Copy to .env.mate-voice-staging. These credentials are only for the isolated local staging stack.
STAGING_POSTGRES_PASSWORD=replace-with-64-hex-characters
STAGING_APP_DB_PASSWORD=replace-with-another-64-hex-characters
STAGING_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
STAGING_JWT_SECRET=replace-with-a-different-random-secret-at-least-32-characters
OPENAI_API_KEY=
