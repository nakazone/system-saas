<%- include('../partials/header') %>
<div class="page-header">
  <h1>Labor rates</h1>
  <a class="btn btn-secondary" href="/settings">Back</a>
</div>
<% if (success) { %><div class="alert alert-ok"><%= success %></div><% } %>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="panel">
  <table>
    <thead><tr><th>Label</th><th>User</th><th>Role</th><th>Rate</th><th>From</th><th>To</th><th></th></tr></thead>
    <tbody>
      <% rates.forEach(r => { %>
        <tr>
          <td><%= r.label || '—' %></td>
          <td><%= r.user ? r.user.name : '—' %></td>
          <td><%= r.roleKey || '—' %></td>
          <td>$<%= Number(r.hourlyRate).toFixed(2) %>/hr</td>
          <td><%= new Date(r.effectiveFrom).toLocaleDateString() %></td>
          <td><%= r.effectiveTo ? new Date(r.effectiveTo).toLocaleDateString() : '—' %></td>
          <td>
            <form method="post" action="/settings/labor-rates/<%= r.id %>/delete" onsubmit="return confirm('Delete rate?')">
              <button type="submit" class="linkish">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="panel" style="max-width:480px">
  <h2>Add rate</h2>
  <form method="post" action="/settings/labor-rates">
    <label>User (optional)</label>
    <select name="userId">
      <option value="">— role-based —</option>
      <% users.forEach(u => { %><option value="<%= u.id %>"><%= u.name %></option><% }) %>
    </select>
    <label>Role key (if no user)</label>
    <input name="roleKey" placeholder="installer" />
    <label>Label</label>
    <input name="label" placeholder="Standard installer" />
    <label>Hourly rate</label>
    <input name="hourlyRate" type="number" step="0.01" min="0" required />
    <label>Effective from</label>
    <input name="effectiveFrom" type="date" required />
    <label>Effective to</label>
    <input name="effectiveTo" type="date" />
    <button class="btn" type="submit">Save</button>
  </form>
</div>
<%- include('../partials/footer') %>
