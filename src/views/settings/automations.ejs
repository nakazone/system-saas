<%- include('../partials/header') %>
<div class="page-header">
  <h1>Automations</h1>
  <a class="btn btn-secondary" href="/settings">Back</a>
</div>
<% if (success) { %><div class="alert alert-ok"><%= success %></div><% } %>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="panel" style="max-width:520px">
  <h2>Email automations</h2>
  <p class="muted">SMS channel is reserved for later. Transactional emails respect customer opt-out.</p>
  <form method="post" action="/settings/automations">
    <label style="font-weight:500">
      <input type="checkbox" name="quoteFollowUpEnabled" <%= settings.quoteFollowUpEnabled ? 'checked' : '' %> style="width:auto" />
      Quote follow-up after send
    </label>
    <label>Follow-up delay (days)</label>
    <input name="quoteFollowUpDays" type="number" min="0" max="90" value="<%= settings.quoteFollowUpDays %>" />

    <label style="font-weight:500;margin-top:1rem;display:block">
      <input type="checkbox" name="visitReminderEnabled" <%= settings.visitReminderEnabled ? 'checked' : '' %> style="width:auto" />
      Visit reminder before start
    </label>
    <label>Reminder lead time (hours)</label>
    <input name="visitReminderHours" type="number" min="0" max="168" value="<%= settings.visitReminderHours %>" />

    <hr style="margin:1.25rem 0;border:0;border-top:1px solid #e5e7eb" />
    <h3 style="margin:0 0 0.5rem;font-size:1rem">Jobs agendados</h3>
    <p class="muted" style="margin-top:0">Avisa a equipe no celular e, na hora, marca o job como em progresso no escritório — sem avançar o Campo (eles confirmam “a caminho” / “no local”).</p>

    <label style="font-weight:500;margin-top:0.75rem;display:block">
      <input type="checkbox" name="jobStartReminderEnabled" <%= settings.jobStartReminderEnabled ? 'checked' : '' %> style="width:auto" />
      Lembrete push antes do horário
    </label>
    <label>Minutos antes do início</label>
    <input name="jobStartReminderMinutesBefore" type="number" min="0" max="1440" value="<%= settings.jobStartReminderMinutesBefore %>" />

    <label style="font-weight:500;margin-top:1rem;display:block">
      <input type="checkbox" name="jobStartAtTimeNudgeEnabled" <%= settings.jobStartAtTimeNudgeEnabled ? 'checked' : '' %> style="width:auto" />
      Notificar na hora (“hora de começar”)
    </label>

    <label style="font-weight:500;margin-top:1rem;display:block">
      <input type="checkbox" name="jobStartAutoOfficeStatus" <%= settings.jobStartAutoOfficeStatus ? 'checked' : '' %> style="width:auto" />
      Na hora, passar status do escritório para Em progresso
    </label>

    <button class="btn" type="submit" style="margin-top:1rem">Save</button>
  </form>
  <form method="post" action="/settings/automations/run-due" style="margin-top:0.75rem">
    <button class="btn btn-secondary" type="submit">Run due messages now</button>
  </form>
</div>

<div class="panel">
  <h2>Pending</h2>
  <% if (!pending.length) { %><p class="muted">None queued.</p><% } else { %>
  <table>
    <thead><tr><th>When</th><th>Trigger</th><th>To</th><th>Subject</th></tr></thead>
    <tbody>
      <% pending.forEach(m => { %>
        <tr>
          <td><%= new Date(m.scheduledFor).toLocaleString() %></td>
          <td><%= m.triggerKey %></td>
          <td><%= m.toAddress %></td>
          <td><%= m.subject %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<div class="panel">
  <h2>Recent log</h2>
  <% if (!logs.length) { %><p class="muted">No sends yet.</p><% } else { %>
  <table>
    <thead><tr><th>At</th><th>Status</th><th>Trigger</th><th>To</th><th>Note</th></tr></thead>
    <tbody>
      <% logs.forEach(l => { %>
        <tr>
          <td><%= new Date(l.createdAt).toLocaleString() %></td>
          <td><%= l.status %></td>
          <td><%= l.triggerKey || '—' %></td>
          <td><%= l.toAddress %></td>
          <td class="muted"><%= l.skipReason || '—' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
<%- include('../partials/footer') %>
