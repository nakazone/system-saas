<%- include('../partials/header') %>

<section class="auth-card-wrap">
  <div class="auth-card su-center">
    <div class="su-mail" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/></svg>
    </div>
    <p class="mkt-eyebrow">Step 2 of 3</p>
    <h1>Check your e-mail</h1>
    <p class="mkt-lead">We sent a link to <strong><%= email %></strong>. Open it to confirm your e-mail and create your workspace.</p>

    <% if (notice) { %><div class="alert su-notice" role="status"><%= notice %></div><% } %>
    <% if (problem) { %><div class="alert alert-error" role="alert"><%= problem %></div><% } %>

    <ul class="su-tips">
      <li>The link works for 48 hours.</li>
      <li>Didn’t get it? Check spam or promotions, or send it again.</li>
    </ul>

    <div class="mkt-cta-row su-center-row">
      <% if (canResend) { %>
      <form method="post" action="/signup/resend" class="inline">
        <button class="btn btn-secondary" type="submit">Send the link again</button>
      </form>
      <% } %>
      <a class="btn btn-secondary" href="/signup">Use a different e-mail</a>
    </div>

    <% if (devLink) { %>
      <p class="su-dev">Test mode — confirmation link: <a href="<%= devLink %>"><%= devLink %></a></p>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
