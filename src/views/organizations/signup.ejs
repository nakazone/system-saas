<%- include('../partials/header') %>

<section class="signup-layout">
  <aside class="signup-aside">
    <p class="mkt-eyebrow"><%= productName %></p>
    <h1>Create your company workspace</h1>
    <p class="mkt-lead">
      <% if (typeof subdomainTenants !== 'undefined' && subdomainTenants) { %>
        Get a dedicated workspace at <code>sua-empresa.<%= appRootDomain %></code>, invite your team, and start quoting jobs today.
      <% } else { %>
        Create your company workspace, invite your team, and start quoting jobs today.
      <% } %>
    </p>
    <ul class="trust-list">
      <li>30-day free trial — no card required</li>
      <li>Your data stays isolated to your organization</li>
      <li>Brand the workspace with your logo and colors</li>
      <li>Invite staff with roles and permissions</li>
    </ul>
  </aside>

  <div class="signup-form-panel auth-card">
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form method="post" action="/signup" class="auth-form" id="signupForm">
      <fieldset>
        <legend>Company</legend>
        <label for="organizationName">Organization name</label>
        <input id="organizationName" name="organizationName" required value="<%= values.organizationName || '' %>" />

        <label for="slug">Subdomain slug</label>
        <input
          id="slug"
          name="slug"
          required
          pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
          value="<%= values.slug || '' %>"
          placeholder="acme-floors"
        />
        <p class="slug-live muted">
          Workspace URL:
          <% if (typeof subdomainTenants !== 'undefined' && subdomainTenants) { %>
            <strong><span id="slugPreview">your-company</span>.<%= appRootDomain %></strong>
          <% } else { %>
            sign in on this site as workspace <strong><span id="slugPreview">your-company</span></strong>
          <% } %>
        </p>
      </fieldset>

      <fieldset>
        <legend>Admin account</legend>
        <label for="adminName">Your name</label>
        <input id="adminName" name="adminName" required value="<%= values.adminName || '' %>" />

        <label for="adminEmail">Work email</label>
        <input id="adminEmail" type="email" name="adminEmail" required value="<%= values.adminEmail || '' %>" />

        <label for="password">Password</label>
        <input id="password" type="password" name="password" required minlength="8" />
      </fieldset>

      <fieldset>
        <legend>Contact <span class="muted">(optional)</span></legend>
        <label for="contactEmail">Public contact email</label>
        <input id="contactEmail" type="email" name="contactEmail" value="<%= values.contactEmail || '' %>" />

        <label for="contactPhone">Public contact phone</label>
        <input id="contactPhone" name="contactPhone" value="<%= values.contactPhone || '' %>" />
      </fieldset>

      <button class="btn" type="submit">Create workspace</button>
      <p class="auth-alt muted">Already have a workspace? <a href="/find-workspace">Sign in</a></p>
    </form>
  </div>
</section>

<script>
  (function () {
    const input = document.getElementById('slug');
    const preview = document.getElementById('slugPreview');
    const nameInput = document.getElementById('organizationName');
    if (!input || !preview) return;

    const toSlug = (value) =>
      value
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 48);

    const sync = () => {
      const value = (input.value || 'your-company').toLowerCase().trim() || 'your-company';
      preview.textContent = value;
    };

    input.addEventListener('input', sync);
    if (nameInput) {
      nameInput.addEventListener('input', () => {
        if (!input.dataset.touched) {
          input.value = toSlug(nameInput.value);
          sync();
        }
      });
      input.addEventListener('input', () => {
        input.dataset.touched = '1';
      });
    }
    sync();
  })();
</script>

<%- include('../partials/footer') %>
