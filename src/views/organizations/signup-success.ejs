<%- include('../partials/header') %>

<section class="auth-card-wrap">
  <div class="auth-card success-card">
    <p class="mkt-eyebrow">You’re all set</p>
    <h1><%= organizationName %> is ready</h1>
    <p class="mkt-lead">Your workspace was created. Open it with the link below.</p>

    <div class="workspace-link-box">
      <label>Workspace</label>
      <a class="workspace-link" href="<%= workspaceUrl %>"><%= workspaceUrl %></a>
      <p class="muted" style="margin:0.5rem 0 0">Slug: <strong><%= slug %></strong></p>
    </div>

    <div class="mkt-cta-row">
      <a class="btn" href="<%= workspaceUrl %>">Go to your workspace</a>
      <a class="btn btn-secondary" href="/">Back to home</a>
    </div>

    <% if (!subdomainTenants) { %>
    <p class="mkt-fineprint">
      You’re on the shared Railway hostname, so workspaces open on this same domain
      (not <code><%= slug %>.<%= appRootDomain %></code> — that URL has no valid TLS certificate).
      Next time, use <a href="/find-workspace">Find your workspace</a> and enter <strong><%= slug %></strong>.
    </p>
    <% } else { %>
    <p class="mkt-fineprint">
      Bookmark your workspace URL. You can also use <a href="/find-workspace">Find your workspace</a> anytime.
    </p>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
