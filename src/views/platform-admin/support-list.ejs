<%- include('../partials/header') %>
<%
  const catLabel = { question: 'Dúvida', suggestion: 'Sugestão', bug: 'Problema', other: 'Outro' };
%>
<div class="page-header" style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap">
  <h1>Mensagens de suporte</h1>
  <nav style="display:flex;gap:0.75rem;flex-wrap:wrap">
    <a href="/" class="btn btn-secondary">Organizações</a>
    <a href="/support" class="btn">Suporte</a>
  </nav>
</div>

<form method="get" action="/support" class="panel" style="display:flex;gap:0.75rem;align-items:end;flex-wrap:wrap;max-width:480px">
  <div>
    <label for="status">Status</label>
    <select id="status" name="status">
      <option value="open" <%= filterStatus === 'open' ? 'selected' : '' %>>Abertos</option>
      <option value="closed" <%= filterStatus === 'closed' ? 'selected' : '' %>>Fechados</option>
      <option value="all" <%= filterStatus === 'all' ? 'selected' : '' %>>Todos</option>
    </select>
  </div>
  <button type="submit" class="btn btn-secondary">Filtrar</button>
</form>

<div class="panel">
  <% if (!tickets.length) { %>
    <p class="muted">Nenhuma mensagem neste filtro.</p>
  <% } else { %>
  <table>
    <thead>
      <tr>
        <th>Quando</th>
        <th>Empresa</th>
        <th>Tipo</th>
        <th>Assunto</th>
        <th>De</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% tickets.forEach(t => { %>
        <tr>
          <td><%= t.createdAt.toISOString().slice(0, 16).replace('T', ' ') %></td>
          <td><%= t.organization.name %><br><code><%= t.organization.slug %></code></td>
          <td><%= catLabel[t.category] || t.category %></td>
          <td><%= t.subject %></td>
          <td><%= t.createdByUser ? t.createdByUser.name : '—' %></td>
          <td><%= t.status %></td>
          <td><a class="btn btn-secondary" href="/support/<%= t.id %>">Abrir</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
<%- include('../partials/footer') %>
