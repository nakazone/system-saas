<%- include('../partials/header') %>

<section class="mkt-page-hero">
  <h1>Pricing</h1>
  <p class="mkt-lead">Start free. Upgrade when you need more seats and operational depth.</p>
</section>

<section class="pricing-grid">
  <article class="price-card price-card-featured">
    <p class="plan-badge">Available now</p>
    <h2>Starter</h2>
    <p class="price-line"><span class="price">$0</span> <span class="muted">/ 30-day trial</span></p>
    <ul class="plan-features">
      <li>Organization workspace + subdomain</li>
      <li>Leads &amp; pipeline stages</li>
      <li>Customers &amp; flooring quotes</li>
      <li>Team invites &amp; roles</li>
      <li>Logo &amp; brand color</li>
    </ul>
    <a class="btn" href="/signup">Start free trial</a>
  </article>

  <article class="price-card price-card-soon">
    <p class="plan-badge muted-badge">Coming soon</p>
    <h2>Professional</h2>
    <p class="price-line"><span class="price">—</span></p>
    <ul class="plan-features">
      <li>Everything in Starter</li>
      <li>More seats &amp; custom roles</li>
      <li>Advanced estimate libraries</li>
      <li>Priority support</li>
    </ul>
    <button class="btn btn-secondary" type="button" disabled>Coming soon</button>
  </article>

  <article class="price-card price-card-soon">
    <p class="plan-badge muted-badge">Coming soon</p>
    <h2>Business</h2>
    <p class="price-line"><span class="price">—</span></p>
    <ul class="plan-features">
      <li>Everything in Professional</li>
      <li>Projects &amp; scheduling (roadmap)</li>
      <li>Partner portal (roadmap)</li>
      <li>Billing &amp; invoicing (roadmap)</li>
    </ul>
    <button class="btn btn-secondary" type="button" disabled>Coming soon</button>
  </article>
</section>

<p class="mkt-fineprint pricing-note">
  Billing is not charged yet — Starter is the trial experience available in the product today.
  Professional and Business are shown for roadmap clarity only.
</p>

<%- include('../partials/footer') %>
