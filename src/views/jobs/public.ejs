<%
  const initials = (n) => String(n || '?').trim().split(/\s+/).filter(Boolean).map((p, i, a) => (i === 0 || i === a.length - 1) ? p[0] : '').join('').slice(0, 2).toUpperCase();
  const safeColor = (c, d) => /^#[0-9a-fA-F]{3,8}$/.test(String(c || '')) ? c : d;
  const ink = safeColor(org.ink, '#211d1a');
  const accent = safeColor(org.accent, '#e8792c');
%><!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <meta name="theme-color" content="<%= ink %>" />
  <title><%= job.number != null ? ('#' + job.number + ' · ') : '' %><%= job.title %> · <%= org.name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink: <%= ink %>;
      --accent: <%= accent %>;
      --ink-2: #4a433d;
      --muted: #8a8074;
      --line: #e8dfd2;
      --cream: #f7f4ee;
      --card: #ffffff;
      --accent-soft: color-mix(in srgb, var(--accent) 11%, #fff);
      --accent-line: color-mix(in srgb, var(--accent) 40%, #fff);
      --accent-ink: color-mix(in srgb, var(--accent) 70%, #000);
    }
    * { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body {
      margin: 0;
      font-family: "Plus Jakarta Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
      background: var(--cream);
      color: var(--ink);
      line-height: 1.45;
      font-size: 16px;
    }
    a { color: inherit; }
    .wrap { max-width: 560px; margin: 0 auto; padding: 0 16px; }

    /* Header */
    .top { background: var(--ink); color: #fff; padding: 14px 0 64px; }
    .top .wrap { display: flex; align-items: center; gap: 12px; }
    .logo { width: 40px; height: 40px; border-radius: 10px; object-fit: cover; background: #fff; flex: none; }
    .logo--fb { display: grid; place-items: center; background: var(--accent); color: #fff; font-weight: 800; font-size: 18px; }
    .top__org { font-weight: 800; font-size: 16px; line-height: 1.2; }
    .top__sub { font-size: 12.5px; opacity: .7; font-weight: 600; letter-spacing: .02em; }

    /* Hero card overlaps the header */
    .hero { margin-top: -50px; background: var(--card); border-radius: 18px; padding: 18px 18px 16px; box-shadow: 0 6px 24px rgba(33,29,26,.10); }
    .hero__hello { margin: 0 0 10px; font-size: 14px; color: var(--muted); font-weight: 600; }
    .hero__meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 6px; }
    .num { font-weight: 800; font-size: 13px; color: var(--muted); letter-spacing: .02em; }
    .pill { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 800; padding: 3px 10px; border-radius: 999px; }
    .pill::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
    .pill--info { background: #eef1f6; color: #3d4b63; }
    .pill--accent { background: var(--accent-soft); color: var(--accent-ink); }
    .pill--done { background: #ebe7e2; color: var(--ink); }
    .pill--muted { background: #f1ede6; color: var(--muted); }
    .hero h1 { margin: 0; font-size: 22px; line-height: 1.25; font-weight: 800; letter-spacing: -.01em; }
    .hero__client { margin: 4px 0 0; color: var(--ink-2); font-size: 14.5px; font-weight: 600; }

    /* When */
    .when { margin-top: 14px; display: flex; gap: 14px; align-items: stretch; border-top: 1px solid var(--line); padding-top: 14px; }
    .when__time { font-size: 34px; font-weight: 800; line-height: 1; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
    .when__zone { font-size: 12px; font-weight: 700; color: var(--muted); margin-left: 4px; letter-spacing: .02em; }
    .when__day { font-weight: 700; font-size: 15px; margin-top: 6px; }
    .when__until { font-size: 13.5px; color: var(--ink-2); margin-top: 2px; }
    .when__rel { align-self: flex-start; margin-left: auto; background: var(--accent); color: #fff; font-weight: 800; font-size: 12.5px; padding: 5px 10px; border-radius: 8px; white-space: nowrap; }
    .when--none { color: var(--muted); font-weight: 600; font-size: 14px; }

    /* Sections */
    .sec { margin-top: 14px; background: var(--card); border-radius: 16px; padding: 16px 18px; border: 1px solid var(--line); }
    .sec h2 { margin: 0 0 10px; font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .sec h2 small { font-size: 12px; letter-spacing: 0; text-transform: none; color: var(--ink-2); font-weight: 700; }

    .addr { font-size: 17px; font-weight: 700; line-height: 1.35; margin: 0 0 12px; }
    .btn { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; border-radius: 12px; font-weight: 800; font-size: 15px; text-decoration: none; border: 0; width: 100%; }
    .btn--accent { background: var(--accent); color: #fff; }
    .btn--ghost { background: #fff; color: var(--ink); border: 1.5px solid var(--line); }
    .btn svg { flex: none; }

    .lockbox { display: flex; align-items: center; gap: 12px; margin-top: 12px; padding: 12px 14px; border-radius: 12px; background: var(--ink); color: #fff; }
    .lockbox__ico { width: 36px; height: 36px; border-radius: 9px; background: rgba(255,255,255,.12); display: grid; place-items: center; flex: none; }
    .lockbox__lbl { font-size: 12px; font-weight: 700; opacity: .75; }
    .lockbox__code { font-size: 24px; font-weight: 800; letter-spacing: .12em; font-variant-numeric: tabular-nums; line-height: 1.1; }

    .attn { margin-top: 14px; border-radius: 16px; padding: 14px 16px 14px 14px; background: var(--accent-soft); border: 1px solid var(--accent-line); display: flex; gap: 12px; }
    .attn__ico { width: 30px; height: 30px; border-radius: 50%; background: var(--accent); color: #fff; display: grid; place-items: center; flex: none; font-weight: 900; }
    .attn b { display: block; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--accent-ink); margin-bottom: 2px; }
    .attn p { margin: 0; font-weight: 600; white-space: pre-wrap; }

    .notes { margin: 0; white-space: pre-wrap; color: var(--ink-2); font-size: 15px; }
    .notes a { color: var(--accent-ink); font-weight: 700; white-space: nowrap; }

    .list { list-style: none; margin: 0; padding: 0; }
    .list li { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 10px 0; border-top: 1px solid var(--line); }
    .list li:first-child { border-top: 0; padding-top: 2px; }
    .list .q { font-weight: 800; white-space: nowrap; font-variant-numeric: tabular-nums; }

    .ck li { justify-content: flex-start; align-items: flex-start; }
    .ck__box { width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--line); flex: none; display: grid; place-items: center; margin-top: 1px; }
    .ck__box--on { background: var(--ink); border-color: var(--ink); color: #fff; }
    .ck__txt--on { color: var(--muted); text-decoration: line-through; }
    .ck__cam { font-size: 11.5px; font-weight: 700; color: var(--muted); margin-left: 6px; white-space: nowrap; }
    .bar { height: 6px; border-radius: 99px; background: var(--line); overflow: hidden; margin: -2px 0 10px; }
    .bar i { display: block; height: 100%; background: var(--ink); border-radius: 99px; }

    .team { display: flex; flex-wrap: wrap; gap: 8px; }
    .who { display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px 4px 4px; border-radius: 999px; background: var(--cream); font-weight: 700; font-size: 14px; }
    .who i { width: 28px; height: 28px; border-radius: 50%; background: var(--ink); color: #fff; font-style: normal; font-size: 11.5px; font-weight: 800; display: grid; place-items: center; }
    .who--me { background: var(--accent-soft); }
    .who--me i { background: var(--accent); }

    .photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .photos a { position: relative; display: block; aspect-ratio: 1; border-radius: 12px; overflow: hidden; background: var(--line); }
    .photos img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .stg { position: absolute; top: 8px; left: 8px; background: rgba(33,29,26,.82); color: #fff; font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 999px; }
    .cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 18px 8px 7px; color: #fff; font-size: 12px; font-weight: 700; background: linear-gradient(transparent, rgba(0,0,0,.7)); }

    .btn--ink { background: var(--ink); color: #fff; cursor: pointer; }
    .up { margin-bottom: 12px; }
    .seg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; padding: 4px; background: var(--cream); border-radius: 12px; margin-bottom: 10px; }
    .seg__b { min-height: 40px; border: 0; border-radius: 9px; background: transparent; font: inherit; font-weight: 800; font-size: 14px; color: var(--ink-2); cursor: pointer; }
    .seg__b[aria-checked="true"] { background: #fff; color: var(--ink); box-shadow: 0 1px 3px rgba(33,29,26,.15); }
    .up__hint { margin: 8px 0 0; text-align: center; font-size: 12.5px; color: var(--muted); font-weight: 600; }
    .empty { margin: 0; color: var(--muted); font-size: 14px; font-weight: 600; text-align: center; padding: 6px 0 2px; }
    .photos .pend { display: grid; place-items: center; }
    .photos .pend img { opacity: .55; }
    .photos .pend .st { position: absolute; inset: auto 8px 8px 8px; background: rgba(33,29,26,.82); color: #fff; font-size: 11.5px; font-weight: 800; padding: 4px 8px; border-radius: 8px; text-align: center; }
    .photos .pend.err .st { background: #b42318; cursor: pointer; }
    .photos .pend.ok img { opacity: 1; }
    .toast { position: fixed; left: 50%; bottom: calc(18px + env(safe-area-inset-bottom)); transform: translateX(-50%); background: var(--ink); color: #fff; padding: 10px 16px; border-radius: 12px; font-weight: 700; font-size: 14px; box-shadow: 0 6px 20px rgba(0,0,0,.2); z-index: 9; max-width: calc(100% - 32px); }
    .rep + .rep { border-top: 1px solid var(--line); margin-top: 10px; padding-top: 10px; }
    .rep b { display: block; }
    .rep span { font-size: 12.5px; color: var(--muted); font-weight: 600; }
    .rep p { margin: 4px 0 0; white-space: pre-wrap; color: var(--ink-2); font-size: 14.5px; }

    .contact { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .contact .btn { min-height: 46px; font-size: 14.5px; }
    .contact__phone { grid-column: 1 / -1; font-size: 13px; color: var(--muted); font-weight: 600; margin: 0 0 2px; }

    .foot { text-align: center; color: var(--muted); font-size: 12.5px; padding: 22px 8px calc(28px + env(safe-area-inset-bottom)); }
    .foot b { color: var(--ink-2); }
    .foot p { margin: 0 0 4px; }
  </style>
</head>
<body>
  <header class="top">
    <div class="wrap">
      <% if (org.logoUrl) { %>
        <img class="logo" src="<%= org.logoUrl %>" alt="" width="40" height="40" />
      <% } else { %>
        <div class="logo logo--fb" aria-hidden="true"><%= String(org.name || 'O').charAt(0).toUpperCase() %></div>
      <% } %>
      <div>
        <div class="top__org"><%= org.name %></div>
        <div class="top__sub">Ticket de serviço</div>
      </div>
    </div>
  </header>

  <main class="wrap">
    <section class="hero">
      <p class="hero__hello">Olá<%= worker.firstName ? ', ' + worker.firstName : '' %>! Aqui está o seu trabalho.</p>
      <div class="hero__meta">
        <% if (job.number != null) { %><span class="num">JOB #<%= job.number %></span><% } %>
        <span class="pill pill--<%= job.status.tone %>"><%= job.status.label %></span>
      </div>
      <h1><%= job.title %></h1>
      <% if (job.client) { %><p class="hero__client"><%= job.client %></p><% } %>

      <% if (job.when) { %>
        <div class="when">
          <div>
            <div class="when__time"><%= job.when.start %><% if (job.when.zone) { %><span class="when__zone"><%= job.when.zone %></span><% } %></div>
            <div class="when__day"><%= job.when.day %></div>
            <% if (job.when.until) { %><div class="when__until"><%= job.when.until %></div><% } %>
          </div>
          <span class="when__rel"><%= job.when.relative %></span>
        </div>
      <% } else { %>
        <div class="when when--none">Data ainda não definida — o escritório vai avisar.</div>
      <% } %>
    </section>

    <% if (job.attention) { %>
      <section class="attn" role="note">
        <span class="attn__ico" aria-hidden="true">!</span>
        <div><b>Atenção</b><p><%= job.attention %></p></div>
      </section>
    <% } %>

    <% if (job.address || job.lockbox) { %>
      <section class="sec">
        <h2>Local</h2>
        <% if (job.address) { %>
          <p class="addr"><%= job.address %></p>
          <a class="btn btn--accent" href="<%= job.mapsUrl %>" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
            Abrir no mapa
          </a>
        <% } %>
        <% if (job.lockbox) { %>
          <div class="lockbox">
            <span class="lockbox__ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/><circle cx="12" cy="16" r="1.2" fill="currentColor" stroke="none"/></svg></span>
            <div>
              <div class="lockbox__lbl">Código da lockbox</div>
              <div class="lockbox__code"><%= job.lockbox %></div>
            </div>
          </div>
        <% } %>
      </section>
    <% } %>

    <% if (job.notesHtml) { %>
      <section class="sec">
        <h2>Instruções</h2>
        <p class="notes"><%- job.notesHtml %></p>
      </section>
    <% } %>

    <% if (job.services.length) { %>
      <section class="sec">
        <h2>Serviços</h2>
        <ul class="list">
          <% job.services.forEach(function (s) { %>
            <li><span><%= s.name %></span><% if (s.qty) { %><span class="q"><%= s.qty %></span><% } %></li>
          <% }) %>
        </ul>
      </section>
    <% } %>

    <% if (job.checklist.length) { %>
      <section class="sec">
        <h2>Checklist <small><%= job.checklistDone %> de <%= job.checklist.length %> feito<%= job.checklistDone === 1 ? '' : 's' %></small></h2>
        <div class="bar" aria-hidden="true"><i style="width: <%= Math.round(job.checklistDone / job.checklist.length * 100) %>%"></i></div>
        <ul class="list ck">
          <% job.checklist.forEach(function (c) { %>
            <li>
              <span class="ck__box<%= c.done ? ' ck__box--on' : '' %>" aria-label="<%= c.done ? 'Feito' : 'Pendente' %>"><% if (c.done) { %><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><% } %></span>
              <span><span class="<%= c.done ? 'ck__txt--on' : '' %>"><%= c.text %></span><% if (c.photo && !c.done) { %><span class="ck__cam">· foto</span><% } %></span>
            </li>
          <% }) %>
        </ul>
      </section>
    <% } %>

    <section class="sec">
      <h2>Equipe</h2>
      <div class="team">
        <% job.team.forEach(function (n) { %>
          <span class="who"><i><%= initials(n) %></i><%= n %></span>
        <% }) %>
        <span class="who who--me"><i><%= initials(worker.name) %></i><%= worker.name %> (você)</span>
      </div>
    </section>

    <% if (job.photos.length || canUpload) { %>
      <section class="sec" id="fotos">
        <h2>Fotos <small id="phCount"><%= job.photos.length || '' %></small></h2>
        <% if (canUpload) { %>
          <div class="up" id="up" data-url="<%= uploadUrl %>">
            <div class="seg" role="radiogroup" aria-label="Momento da foto">
              <% [['before','Antes'],['during','Durante'],['after','Depois']].forEach(function (o) { %>
                <button type="button" role="radio" class="seg__b" data-stage="<%= o[0] %>" aria-checked="<%= o[0] === defaultStage ? 'true' : 'false' %>"><%= o[1] %></button>
              <% }) %>
            </div>
            <label class="btn btn--ink up__btn">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5A2.5 2.5 0 0 1 5.5 6h1.6l1.4-2h7l1.4 2h1.6A2.5 2.5 0 0 1 21 8.5v9A2.5 2.5 0 0 1 18.5 20h-13A2.5 2.5 0 0 1 3 17.5z"/><circle cx="12" cy="13" r="3.6"/></svg>
              Adicionar fotos
              <input type="file" id="phInput" accept="image/*" multiple hidden />
            </label>
            <p class="up__hint">Vão direto para o ObraCam do escritório.</p>
          </div>
        <% } %>
        <div class="photos" id="phGrid"<%= job.photos.length ? '' : ' hidden' %>>
          <% job.photos.forEach(function (p) { %>
            <a href="<%= p.url %>" target="_blank" rel="noopener">
              <img src="<%= p.thumbUrl %>" alt="<%= p.caption || 'Foto do job' %>" loading="lazy" />
              <% if (p.stageLabel) { %><span class="stg"><%= p.stageLabel %></span><% } %>
              <% if (p.caption) { %><span class="cap"><%= p.caption %></span><% } %>
            </a>
          <% }) %>
        </div>
        <% if (!job.photos.length) { %><p class="empty" id="phEmpty">Nenhuma foto ainda. Tire fotos de antes, durante e depois do serviço.</p><% } %>
      </section>
    <% } %>

    <% if (job.reports.length) { %>
      <section class="sec">
        <h2>Relatórios</h2>
        <% job.reports.forEach(function (r) { %>
          <div class="rep">
            <b><%= r.title %></b>
            <% if (r.date) { %><span><%= r.date %></span><% } %>
            <% if (r.summary) { %><p><%= r.summary %></p><% } %>
          </div>
        <% }) %>
      </section>
    <% } %>

    <% if (org.tel) { %>
      <section class="sec">
        <h2>Dúvidas? Fale com o escritório</h2>
        <div class="contact">
          <p class="contact__phone"><%= org.name %> · <%= org.phone %></p>
          <a class="btn btn--ghost" href="<%= org.tel %>">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
            Ligar
          </a>
          <a class="btn btn--ghost" href="<%= org.whatsapp %>" target="_blank" rel="noopener">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>
            WhatsApp
          </a>
        </div>
      </section>
    <% } %>

    <footer class="foot">
      <p><b>Link pessoal de <%= worker.name %></b> — não encaminhe.</p>
      <% if (validUntil) { %><p>Válido até <%= validUntil %>.</p><% } %>
      <p>Atualiza sozinho: abra de novo para ver mudanças.</p>
    </footer>
  </main>
<% if (canUpload) { %>
<script>
(function () {
  var box = document.getElementById("up");
  if (!box) return;
  var url = box.getAttribute("data-url");
  var input = document.getElementById("phInput");
  var grid = document.getElementById("phGrid");
  var count = document.getElementById("phCount");
  var LABEL = { before: "Antes", during: "Durante", after: "Depois" };
  var sel = box.querySelector('[aria-checked="true"]');
  var stage = sel ? sel.getAttribute("data-stage") : "during";
  var total = grid.querySelectorAll("a").length;

  box.querySelector(".seg").addEventListener("click", function (e) {
    var b = e.target.closest("[data-stage]");
    if (!b) return;
    stage = b.getAttribute("data-stage");
    box.querySelectorAll("[data-stage]").forEach(function (x) { x.setAttribute("aria-checked", x === b ? "true" : "false"); });
  });

  function toast(msg) {
    var t = document.createElement("div");
    t.className = "toast"; t.textContent = msg; t.setAttribute("role", "status");
    document.body.appendChild(t);
    setTimeout(function () { t.remove(); }, 3200);
  }

  function shrink(file) {
    return new Promise(function (resolve, reject) {
      var img = new Image();
      var src = URL.createObjectURL(file);
      img.onload = function () {
        var max = 1920, w = img.naturalWidth, h = img.naturalHeight;
        var k = Math.min(1, max / Math.max(w, h));
        var c = document.createElement("canvas");
        c.width = Math.round(w * k); c.height = Math.round(h * k);
        c.getContext("2d").drawImage(img, 0, 0, c.width, c.height);
        URL.revokeObjectURL(src);
        resolve(c.toDataURL("image/jpeg", 0.82));
      };
      img.onerror = function () { URL.revokeObjectURL(src); reject(new Error("Não deu para ler esta foto.")); };
      img.src = src;
    });
  }

  function tile(preview, st) {
    var a = document.createElement("a");
    a.className = "pend";
    a.innerHTML = '<img alt="" /><span class="stg"></span><span class="st">Enviando…</span>';
    a.querySelector("img").src = preview;
    a.querySelector(".stg").textContent = LABEL[st] || "";
    grid.hidden = false;
    var empty = document.getElementById("phEmpty");
    if (empty) empty.remove();
    grid.insertBefore(a, grid.firstChild);
    return a;
  }

  function send(job) {
    job.el.className = "pend";
    job.el.querySelector(".st").textContent = "Enviando…";
    return fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ data_url: job.data, stage: job.stage, client_upload_id: job.id, taken_at_device: job.taken })
    }).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (j) {
        if (!r.ok || !j.success) throw new Error(j.error || "Falha no envio");
        return j.data;
      });
    }).then(function (d) {
      job.el.className = "pend ok";
      job.el.href = d.url; job.el.target = "_blank"; job.el.rel = "noopener";
      job.el.querySelector(".st").remove();
      total += 1; count.textContent = total;
      return true;
    }).catch(function (err) {
      job.el.className = "pend err";
      job.el.querySelector(".st").textContent = "Falhou — tocar para tentar de novo";
      job.el.onclick = function (e) { e.preventDefault(); job.el.onclick = null; send(job); };
      toast(err.message || "Falha no envio");
      return false;
    });
  }

  input.addEventListener("change", function () {
    var files = Array.prototype.slice.call(input.files || []);
    input.value = "";
    if (!files.length) return;
    var st = stage, ok = 0;
    var chain = Promise.resolve();
    files.forEach(function (f) {
      chain = chain.then(function () {
        return shrink(f).then(function (data) {
          var job = { data: data, stage: st, taken: f.lastModified ? new Date(f.lastModified).toISOString() : null,
            id: (Date.now().toString(36) + Math.random().toString(36).slice(2, 8)) };
          job.el = tile(data, st);
          return send(job).then(function (good) { if (good) ok += 1; });
        }, function (err) { toast(err.message); });
      });
    });
    chain.then(function () {
      if (ok) toast(ok === 1 ? "Foto enviada ao escritório." : ok + " fotos enviadas ao escritório.");
    });
  });
})();
</script>
<% } %>
</body>
</html>
