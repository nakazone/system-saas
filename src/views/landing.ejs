<script>
(function () {
  // Feature tabs
  const tabsRoot = document.querySelector('[data-feature-tabs]');
  if (tabsRoot) {
    const tabs = Array.from(tabsRoot.querySelectorAll('.feature-tab'));
    const panels = Array.from(tabsRoot.querySelectorAll('.feature-panel'));
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.getAttribute('data-tab');
        tabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        panels.forEach((panel) => {
          const match = panel.getAttribute('data-panel') === id;
          panel.classList.toggle('is-active', match);
          panel.hidden = !match;
        });
      });
    });
  }

  // Mirrors src/lib/quotes/calculate.ts
  function calculateQuote(input) {
    const billableArea = input.areaSqft * (1 + input.wastePercent / 100);
    const materialCost = billableArea * input.pricePerSqft;
    const laborCost = input.areaSqft * input.laborPerSqft;
    const materialWithMarkup = materialCost * (1 + input.materialMarkup / 100);
    const laborWithMarkup = laborCost * (1 + input.laborMarkup / 100);
    const total = materialWithMarkup + laborWithMarkup;
    const round2 = (n) => Math.round(n * 100) / 100;
    return {
      billableArea: round2(billableArea),
      materialWithMarkup: round2(materialWithMarkup),
      laborWithMarkup: round2(laborWithMarkup),
      total: round2(total),
    };
  }

  function money(n) {
    return '$' + n.toFixed(2);
  }

  const calcRoot = document.querySelector('[data-estimate-calculator]');
  if (calcRoot) {
    const flooring = calcRoot.querySelector('[data-calc-flooring]');
    const areaInput = calcRoot.querySelector('[data-calc-area]');
    const meta = calcRoot.querySelector('[data-calc-meta]');
    const billableEl = calcRoot.querySelector('[data-calc-billable]');
    const materialEl = calcRoot.querySelector('[data-calc-material]');
    const laborEl = calcRoot.querySelector('[data-calc-labor]');
    const totalEl = calcRoot.querySelector('[data-calc-total]');

    const sync = () => {
      const opt = flooring.selectedOptions[0];
      if (!opt) return;
      const areaSqft = Math.max(0, Number(areaInput.value) || 0);
      const wastePercent = Number(opt.dataset.waste);
      const pricePerSqft = Number(opt.dataset.price);
      const laborPerSqft = Number(opt.dataset.labor);
      const materialMarkup = Number(opt.dataset.mm);
      const laborMarkup = Number(opt.dataset.lm);
      meta.textContent =
        'Defaults: waste ' + wastePercent + '%, material markup ' + materialMarkup +
        '%, labor markup ' + laborMarkup + '%, $' + pricePerSqft.toFixed(2) + '/sqft material, $' +
        laborPerSqft.toFixed(2) + '/sqft labor';
      const result = calculateQuote({
        areaSqft,
        wastePercent,
        pricePerSqft,
        laborPerSqft,
        materialMarkup,
        laborMarkup,
      });
      billableEl.textContent = result.billableArea.toFixed(2) + ' sqft';
      materialEl.textContent = money(result.materialWithMarkup);
      laborEl.textContent = money(result.laborWithMarkup);
      totalEl.textContent = money(result.total);
    };

    flooring.addEventListener('change', sync);
    areaInput.addEventListener('input', sync);
    sync();
  }
})();
</script>

