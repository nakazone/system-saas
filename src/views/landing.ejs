<%- include('partials/header') %>

<div class="progress" id="progress"></div>

<header class="nav" id="nav">
  <div class="wrap nav-in">
    <a href="/" class="logo" aria-label="<%= productName %> home">
      <img src="/assets/obramate-logo.png" alt="<%= productName %>" />
    </a>
    <nav class="nav-links" id="links">
      <a href="#features">Features</a>
      <a href="#calculator">Estimate calculator</a>
      <a href="#compare">Compare</a>
      <a href="/pricing">Pricing</a>
      <a href="/login.html">Sign in</a>
      <a href="/signup" class="btn btn-primary">Start free trial</a>
    </nav>
    <button type="button" class="burger" id="burger" aria-label="Menu" aria-expanded="false" aria-controls="links">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<section class="hero">
  <div class="blob b1"></div><div class="blob b2"></div>
  <div class="wrap hero-grid">
    <div>
      <span class="pill reveal"><b>NEW</b> Built by a real flooring installer — 30 days free</span>
      <h1 class="reveal d1">Run your <span class="rot" id="rot"><span>flooring</span></span><br/>company from one workspace</h1>
      <p class="lead reveal d2">Capture leads, move deals through a sales pipeline, convert customers, and build accurate estimates — with every company’s data isolated on its own subdomain.</p>
      <div class="cta-row reveal d3">
        <a href="/signup" class="btn btn-primary">Start 30-day free trial
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
        <a href="#calculator" class="btn btn-ghost">Try the estimate calculator</a>
      </div>
      <p class="fine reveal d3">No credit card required. After signup, <a href="/login.html">sign in with your email</a>.</p>
      <div class="checks reveal d3">
        <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Data isolated per company</span>
        <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>No credit card</span>
        <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>30-day free trial</span>
      </div>
    </div>

    <div class="reveal d2">
      <div class="board" id="board">
        <div class="board-bar">
          <i style="background:#F16B5F"></i><i style="background:#F5BF4F"></i><i style="background:#5FC454"></i>
          <span class="t">yourcompany.<%= appRootDomain %> / pipeline</span>
          <span class="live">LIVE</span>
        </div>
        <div class="cols" id="cols">
          <div class="col" data-stage="0"><h5>New <em>0</em></h5></div>
          <div class="col" data-stage="1"><h5>Contacted <em>0</em></h5></div>
          <div class="col" data-stage="2"><h5>Proposal <em>0</em></h5></div>
          <div class="col" data-stage="3"><h5>Won <em>0</em></h5></div>
        </div>
        <div class="float-est">
          <div class="ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></div>
          <div><small>Won this month</small><strong id="wonTotal">$4,280</strong></div>
        </div>
        <div class="float-won" id="floatWon">🎉 Deal won</div>
      </div>
      <p class="board-hint">Drag a card between columns — or just watch the pipeline move.</p>
    </div>
  </div>

  <div class="wrap">
    <div class="stats">
      <div class="stat reveal"><div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></div><div><strong><span data-count="5">0</span> flooring types</strong><span>Preloaded estimate rules</span></div></div>
      <div class="stat reveal d1"><div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></div><div><strong>Row-level isolation</strong><span>Enforced at the database layer</span></div></div>
      <div class="stat reveal d2"><div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div><div><strong><span data-count="30">0</span> days free</strong><span>No card needed to start</span></div></div>
    </div>
  </div>
</section>

<section class="block" id="fit">
  <div class="wrap">
    <div class="head reveal"><span class="eyebrow">Is this for you?</span><h2>Check your fit in 20 seconds</h2><p class="sub">Answer yes or no. We’d rather you know now than after signing up.</p></div>
    <div class="fit">
      <div class="fit-list reveal" id="quiz"></div>
      <aside class="fit-result reveal d1">
        <div class="gauge">
          <svg viewBox="0 0 180 100" aria-hidden="true"><path d="M15 95a75 75 0 0 1 150 0" fill="none" stroke="#3A332E" stroke-width="14" stroke-linecap="round"/><path id="garc" d="M15 95a75 75 0 0 1 150 0" fill="none" stroke="#E8792C" stroke-width="14" stroke-linecap="round" stroke-dasharray="236" stroke-dashoffset="236" style="transition:stroke-dashoffset .7s cubic-bezier(.22,1,.36,1),stroke .4s"/></svg>
          <div class="val" id="gval">–</div>
        </div>
        <h4 id="ftitle">Answer the questions</h4>
        <p id="fdesc">Your fit score updates as you go.</p>
        <a href="/signup" class="btn btn-primary" id="fbtn">Start free trial</a>
      </aside>
    </div>
  </div>
</section>

<section class="block" id="features">
  <div class="wrap">
    <div class="head reveal"><span class="eyebrow">Explore the product</span><h2>What works today — and what doesn’t yet</h2><p class="sub"><b>Available now</b> means it works in the product today. <b>Roadmap</b> means it does not.</p></div>
    <div class="feat">
      <div class="tabs reveal" id="tabs">
        <button type="button" class="tab active" data-i="0"><div class="tt">Leads & Pipeline<span class="badge">Available</span></div><div class="desc">Capture inquiries, assign owners, and move deals through stages your company defines.</div><i class="bar"></i></button>
        <button type="button" class="tab" data-i="1"><div class="tt">Smart Estimates<span class="badge">Available</span></div><div class="desc">Waste percent and markups come from organization settings — not hardcoded guesswork.</div><i class="bar"></i></button>
        <button type="button" class="tab" data-i="2"><div class="tt">Customers & Quotes<span class="badge">Available</span></div><div class="desc">Convert a lead to a customer, then attach numbered quotes with material and labor line items.</div><i class="bar"></i></button>
        <button type="button" class="tab" data-i="3"><div class="tt">Team & Permissions<span class="badge">Available</span></div><div class="desc">Invite staff by email. Roles and permission keys take effect immediately — including custom roles.</div><i class="bar"></i></button>
        <button type="button" class="tab" data-i="4"><div class="tt">Roadmap<span class="badge road">Not yet</span></div><div class="desc">Planned, not in the current product. We won’t pretend they ship in the trial.</div><i class="bar"></i></button>
      </div>
      <div class="stage reveal d1">
        <div class="pane show"><div class="mock"><h6>Pipeline <span>This week</span></h6>
          <div class="row"><i class="dot" style="background:var(--gray)"></i>New lead · Website form<span class="r">2m ago</span></div>
          <div class="row"><i class="dot" style="background:var(--blue)"></i>Contacted · Follow-up tomorrow<span class="r">Maria</span></div>
          <div class="row"><i class="dot" style="background:var(--brand)"></i>Proposal · Quote sent<span class="r">$3,120</span></div>
          <div class="row"><i class="dot" style="background:var(--green)"></i>Won · Hardwood install booked<span class="r">$4,280</span></div>
        </div></div>
        <div class="pane"><div class="mock"><h6>Estimate <span>Draft</span></h6>
          <div class="row">Flooring type<span class="r"><span class="chip">LVP</span></span></div>
          <div class="row">Area<span class="r">420 sqft</span></div>
          <div class="row">Waste (org setting)<span class="r">8%</span></div>
          <div class="row">Material markup<span class="r">35%</span></div>
          <div class="row" style="border-color:var(--brand);background:var(--brand-50)"><b>Estimated total</b><span class="r" style="color:var(--ink);font-weight:800">$4,219.53</span></div>
          <a href="#calculator" class="btn btn-ghost" style="margin-top:6px">Try the live calculator ↓</a>
        </div></div>
        <div class="pane"><div class="mock"><h6>Customer <span>Rivera Residence</span></h6>
          <div class="row"><span class="av" style="background:var(--brand)">RR</span>Rivera Residence<span class="r">Converted from lead</span></div>
          <div class="row">Quote #12 · Hardwood<span class="r"><span class="chip">Draft</span></span></div>
          <div class="row">Material · 385 sqft<span class="r">$4,254.25</span></div>
          <div class="row">Labor · install<span class="r">$1,715.00</span></div>
          <div class="row">🔗 Public link<span class="r">Share when ready</span></div>
        </div></div>
        <div class="pane"><div class="mock"><h6>Roles <span>Leads · Quotes · Settings</span></h6>
          <div class="row"><span class="av" style="background:var(--ink)">A</span>Admin<span class="perm"><i class="y">✓</i><i class="y">✓</i><i class="y">✓</i></span></div>
          <div class="row"><span class="av" style="background:var(--brand)">S</span>Sales rep<span class="perm"><i class="y">✓</i><i class="y">✓</i><i class="n">–</i></span></div>
          <div class="row"><span class="av" style="background:var(--blue)">V</span>Support · view only<span class="perm"><i class="y">👁</i><i class="y">👁</i><i class="n">–</i></span></div>
          <div class="row"><span class="av" style="background:var(--green)">+</span>Custom role<span class="r">You define the keys</span></div>
        </div></div>
        <div class="pane"><div class="mock"><h6>Roadmap <span>Honest status</span></h6>
          <div class="row"><i class="dot" style="background:var(--green)"></i>Leads, estimates, customers, team<span class="r" style="color:var(--green);font-weight:700">Live</span></div>
          <div class="row road-row"><i class="dot" style="background:var(--gray)"></i>Projects & job execution<span class="r">Planned</span></div>
          <div class="row road-row"><i class="dot" style="background:var(--gray)"></i>Crew scheduling<span class="r">Planned</span></div>
          <div class="row road-row"><i class="dot" style="background:var(--gray)"></i>Financials / invoicing · Field payroll<span class="r">Planned</span></div>
          <div class="row road-row"><i class="dot" style="background:var(--gray)"></i>Partner / builder portal<span class="r">Planned</span></div>
        </div></div>
      </div>
    </div>
  </div>
</section>

<section class="block" id="calculator">
  <div class="wrap">
    <div class="head center reveal"><span class="eyebrow">Live estimate calculator</span><h2>Quote a floor in seconds</h2><p class="sub">The same default waste and markup rules used when a new organization is created. Tweak anything — it recalculates instantly.</p></div>
    <div class="calc reveal">
      <div class="calc-in">
        <div class="lbl">Flooring type</div>
        <div class="types" id="types"></div>
        <div class="lbl">Area <span style="font-weight:500;color:var(--muted)">drag or type</span></div>
        <div class="area-box"><input type="number" id="area" value="350" min="10" max="5000" aria-label="Area in square feet" /><span>sqft</span></div>
        <input type="range" id="areaR" min="10" max="3000" step="10" value="350" aria-label="Area slider" />
        <div class="presets">
          <button type="button" data-a="150">Bedroom · 150</button>
          <button type="button" data-a="350">Living room · 350</button>
          <button type="button" data-a="900">Main floor · 900</button>
          <button type="button" data-a="2000">Whole house · 2,000</button>
        </div>
        <details class="adv">
          <summary>Adjust rules (like in Settings)</summary>
          <div class="knobs" id="knobs"></div>
        </details>
      </div>
      <div class="calc-out">
        <div class="out-top"><small id="outType">Hardwood · 350 sqft</small></div>
        <div class="total" id="total">$0</div>
        <div class="per" id="per">$0.00 per sqft installed</div>
        <div class="stack"><div id="sMat" style="background:var(--brand)"></div><div id="sLab" style="background:#F4C39A"></div></div>
        <div class="lines">
          <div class="line"><span>Billable area (incl. waste)</span><strong id="billable">0</strong></div>
          <div class="line"><span><i style="background:var(--brand)"></i>Material (with markup)</span><strong id="mat">$0</strong></div>
          <div class="line"><span><i style="background:#F4C39A"></i>Labor (with markup)</span><strong id="lab">$0</strong></div>
        </div>
        <p class="note">Illustrative defaults only. Each organization can change these rules in Settings.</p>
        <a href="/signup" class="btn btn-primary">Save quotes like this — start free</a>
      </div>
    </div>
  </div>
</section>

<section class="block" id="how">
  <div class="wrap">
    <div class="head center reveal"><span class="eyebrow">How it works</span><h2>From signup to first quote in minutes</h2></div>
    <div class="steps" id="steps">
      <div class="track"><i id="track"></i></div>
      <div class="step"><div class="n">1</div><h4>Create your organization</h4><p>Choose a company name and subdomain. You become the first admin.</p></div>
      <div class="step"><div class="n">2</div><h4>Invite your team</h4><p>Send invitations and assign roles — permissions take effect immediately.</p></div>
      <div class="step"><div class="n">3</div><h4>Run the pipeline</h4><p>Add leads, convert customers, and generate estimates with your flooring rules.</p></div>
    </div>
    <div class="story reveal"><div class="q-ic">“</div><p>This platform grew out of the day-to-day system used by a real flooring installation company — not a generic template. We’re opening it up to other flooring companies while we’re still early, which is exactly why the first 30 days are free.</p></div>
  </div>
</section>

<section class="block" id="compare">
  <div class="wrap">
    <div class="head reveal"><span class="eyebrow">How we compare</span><h2>Where <%= productName %> fits</h2><p class="sub">High-level categories — not an exhaustive vendor review. Pick a category to compare side by side.</p></div>
    <div class="cmp-toggle reveal" id="cmpT">
      <button type="button" class="on" data-c="all">All</button>
      <button type="button" data-c="1">Flooring ERPs</button>
      <button type="button" data-c="2">Field service apps</button>
      <button type="button" data-c="3">Construction suites</button>
    </div>
    <div class="tbl-wrap reveal">
      <table id="cmp">
        <thead>
          <tr>
            <th>Capability</th>
            <th class="c-om"><%= productName %></th>
            <th>Flooring ERPs<small>Dedicated flooring business systems</small></th>
            <th>Field service apps<small>Generic scheduling tools</small></th>
            <th>Construction suites<small>General contractor platforms</small></th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
    <p class="cmp-note">Comparisons are directional. Vendor feature sets change — validate against your own requirements.</p>
  </div>
</section>

<section class="block" id="faq">
  <div class="wrap two">
    <div>
      <div class="head reveal" style="margin-bottom:20px"><span class="eyebrow">FAQ</span><h2>Straight answers</h2><p class="sub">Where the product is today — no spin.</p></div>
      <div class="reveal" id="faqs"></div>
    </div>
    <div class="price reveal d1" id="price">
      <span class="tag">Simple pricing</span>
      <h3>Starter</h3>
      <div class="amt">Free <small>· 30-day trial</small></div>
      <ul>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Leads & pipeline</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Customers & quotes</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Team invites & roles</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Your branding</li>
      </ul>
      <a href="/signup" class="btn btn-primary">Start free trial</a>
      <a href="/pricing" class="more">Compare all plans →</a>
    </div>
  </div>
</section>

<div class="wrap">
  <div class="final reveal">
    <h2>Your next quote could be in <%= productName %> by lunch</h2>
    <p>30 days free. No credit card. Your own subdomain.</p>
    <div class="cta-row">
      <a href="/signup" class="btn btn-primary">Start 30-day free trial</a>
      <a href="/login.html" class="btn btn-ghost">Sign in</a>
    </div>
  </div>
  <footer>
    <img src="/assets/obramate-logo.png" alt="<%= productName %>" style="height:24px" />
    <nav>
      <a href="/pricing">Pricing</a>
      <a href="/signup">Start free trial</a>
      <a href="/login.html">Sign in</a>
    </nav>
    <span>© <%= new Date().getFullYear() %> <%= productName %></span>
  </footer>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
  window.__ESTIMATE_RULES__ = <%- JSON.stringify(estimateRules) %>;
</script>
<script src="/assets/js/landing.js" defer></script>

<%- include('partials/footer') %>
