<%- include('partials/header') %>
<% const days = typeof trialDays !== 'undefined' ? trialDays : 30; %>

<div class="progress" id="progress" aria-hidden="true"></div>

<header class="nav" id="nav">
  <div class="wrap nav-in">
    <a href="/" class="logo" aria-label="<%= productName %>">
      <img src="/assets/obramateLogoSmallTransp.png" alt="" width="28" height="28" />
      <span><%= productName %></span>
    </a>
    <nav class="nav-links" id="links">
      <a href="#funcionalidades">Funcionalidades</a>
      <a href="#planos">Planos</a>
      <a href="#depoimentos">Depoimentos</a>
      <a href="#recursos">Recursos</a>
      <a href="#contato">Contato</a>
      <a href="/login.html" class="nav-signin">Entrar</a>
      <a href="/signup" class="btn btn-primary">Começar agora</a>
    </nav>
    <button type="button" class="burger" id="burger" aria-label="Menu" aria-expanded="false" aria-controls="links">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<main>
  <!-- Hero -->
  <section class="hero" id="topo">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="reveal">Mais controle para a sua empresa de <em>flooring</em>.</h1>
        <p class="lead reveal d1">Leads, orçamentos, obras, equipe e financeiro — tudo num só lugar, feito para quem instala piso de verdade.</p>
        <div class="cta-row reveal d2">
          <a href="/signup" class="btn btn-primary">Começar agora</a>
          <a href="#como-funciona" class="btn btn-ghost-light">Ver como funciona</a>
        </div>
      </div>

      <div class="hero-visual reveal d1" aria-hidden="true">
        <div class="hero-fox"><%- include('partials/om-fox', { pose: 'point' }) %></div>
        <div class="dash">
          <aside class="dash-rail">
            <i></i><i></i><i></i><i></i><i></i>
          </aside>
          <div class="dash-body">
            <header class="dash-head">
              <strong>Boa tarde!</strong>
              <span>Visão geral</span>
            </header>
            <div class="dash-kpis">
              <div><small>Leads</small><b>24</b></div>
              <div><small>Orçamentos</small><b>12</b></div>
              <div><small>Obras</small><b>8</b></div>
              <div><small>Faturamento</small><b>$48k</b></div>
            </div>
            <div class="dash-list">
              <p>Projetos recentes</p>
              <div class="dash-row"><span>Rivera · LVP</span><em class="tag-on">Em andamento</em></div>
              <div class="dash-row"><span>Chen · Hardwood</span><em class="tag-sent">Orçamento enviado</em></div>
              <div class="dash-row"><span>Park · Stairs</span><em class="tag-on">Em andamento</em></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="wrap hero-benefits reveal d3">
      <div class="hb"><span class="hb-ico" aria-hidden="true">◎</span>Organize seus leads</div>
      <div class="hb"><span class="hb-ico" aria-hidden="true">▣</span>Crie orçamentos profissionais</div>
      <div class="hb"><span class="hb-ico" aria-hidden="true">⌂</span>Acompanhe as obras</div>
      <div class="hb"><span class="hb-ico" aria-hidden="true">↗</span>Aumente seu lucro</div>
    </div>
  </section>

  <!-- Social proof -->
  <section class="proof" aria-label="Empresas que usam ObraMate">
    <div class="wrap proof-in">
      <p>Mais de <strong>500+</strong> empresas de flooring já confiam no <%= productName %>.</p>
      <div class="proof-logos">
        <span>Denver Floors</span>
        <span>Summit Flooring</span>
        <span>Premier Floors</span>
        <span>Alpine Hardwood</span>
        <span>Metro LVP</span>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="block features" id="funcionalidades">
    <div class="wrap">
      <div class="feat-head">
        <div class="reveal">
          <h2>Tudo que sua empresa precisa em <em>um só sistema</em>.</h2>
          <p class="sub">Do primeiro lead ao pagamento final — vendas, campo e financeiro no mesmo fluxo.</p>
          <a href="#recursos" class="btn btn-primary">Conheça todas as funcionalidades</a>
        </div>
        <div class="feat-fox reveal d1" aria-hidden="true"><%- include('partials/om-fox', { pose: 'run' }) %></div>
      </div>

      <div class="feat-grid" id="recursos">
        <article class="feat reveal">
          <span class="feat-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg></span>
          <h3>Leads e Clientes</h3>
          <p>Pipeline claro, follow-ups e cadastro de particulares e builders.</p>
        </article>
        <article class="feat reveal d1">
          <span class="feat-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 00-2 2v16l3-1.5 3 1.5 3-1.5 3 1.5V4a2 2 0 00-2-2z"/><path d="M8 7h6M8 11h6"/></svg></span>
          <h3>Orçamentos profissionais</h3>
          <p>Tabela de Valores, PDF e link seguro para o cliente assinar.</p>
        </article>
        <article class="feat reveal d2">
          <span class="feat-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V7l7-4 7 4v14"/><path d="M9 21V12h6v9"/></svg></span>
          <h3>Projetos e obras</h3>
          <p>Jobs, status, Campo e fotos ObraCam em cada obra.</p>
        </article>
        <article class="feat reveal d3">
          <span class="feat-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>
          <h3>Financeiro</h3>
          <p>Fature depósito, saldo ou total e registre o recebimento.</p>
        </article>
        <article class="feat reveal">
          <span class="feat-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg></span>
          <h3>Equipe</h3>
          <p>Cargos, convites e Folha para escritório e campo.</p>
        </article>
        <article class="feat reveal d1">
          <span class="feat-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 20V10M12 20V4M6 20v-6"/></svg></span>
          <h3>Relatórios</h3>
          <p>Veja o que vender, o que falta faturar e o que entra.</p>
        </article>
        <article class="feat reveal d2">
          <span class="feat-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span>
          <h3>Agenda</h3>
          <p>Visitas, jobs e compromissos no mesmo calendário.</p>
        </article>
        <article class="feat reveal d3">
          <span class="feat-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
          <h3>E muito mais…</h3>
          <p>Builders, indicações, chat interno e app de campo.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Story / video -->
  <section class="story-block" id="historia">
    <div class="wrap story-grid">
      <div class="story-copy reveal">
        <div class="story-fox" aria-hidden="true"><%- include('partials/om-fox', { pose: 'laptop' }) %></div>
        <h2>Um sistema feito por quem entende de <em>flooring</em>.</h2>
        <p>Nascido no dia a dia de instalação — leads, equipes, fotos e recebimento — aberto para outras empresas de piso.</p>
        <a href="#como-funciona" class="btn btn-primary">Nossa história</a>
      </div>
      <div class="story-video reveal d1">
        <button type="button" class="video-card" id="videoPlay" aria-label="Ver como o ObraMate funciona">
          <span class="video-badge">Veja como o <%= productName %> funciona na prática</span>
          <span class="video-play" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="block how" id="como-funciona">
    <div class="wrap">
      <div class="head center reveal">
        <h2>Como funciona?</h2>
        <p class="sub">Em poucos passos, sua empresa já está mais organizada e produtiva.</p>
      </div>
      <ol class="steps">
        <li class="reveal"><span class="n">1</span><h3>Crie sua conta</h3><p>Empresa, subdomínio e você como admin — sem cartão.</p></li>
        <li class="reveal d1"><span class="n">2</span><h3>Configure sua empresa</h3><p>Tabela de Valores, equipe e preferências do documento.</p></li>
        <li class="reveal d2"><span class="n">3</span><h3>Comece a usar</h3><p>Lead → orçamento → obra → fatura, no mesmo fluxo.</p></li>
        <li class="reveal d3"><span class="n">4</span><h3>Cresça com o <%= productName %></h3><p>Mais jobs sob controle, menos planilha e WhatsApp solto.</p></li>
      </ol>
      <div class="center reveal"><a href="/signup" class="btn btn-outline">Ver passo a passo completo</a></div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="testimonials" id="depoimentos">
    <div class="wrap">
      <div class="testi-head reveal">
        <h2>O que nossos clientes dizem.</h2>
        <a href="#depoimentos" class="link-more">Ver mais depoimentos</a>
      </div>
      <div class="testi-grid">
        <article class="testi reveal">
          <p>“Antes eu perdia orçamento no WhatsApp. Agora o cliente abre o link, assina e a obra já nasce no sistema.”</p>
          <footer>
            <span class="avatar" aria-hidden="true">MR</span>
            <div><strong>Marcos Ribeiro</strong><small>Denver, CO</small></div>
            <span class="stars" aria-label="5 de 5">★★★★★</span>
          </footer>
        </article>
        <article class="testi reveal d1">
          <p>“A equipe de campo vê o job no celular, manda foto e o escritório fatura no mesmo dia. Mudou o ritmo.”</p>
          <footer>
            <span class="avatar" aria-hidden="true">AL</span>
            <div><strong>Ana Lopes</strong><small>Aurora, CO</small></div>
            <span class="stars" aria-label="5 de 5">★★★★★</span>
          </footer>
        </article>
        <article class="testi reveal d2">
          <p>“Tabela de Valores nos orçamentos acabou com o ‘eu acho que cobramos X’. Preço certo, margem certa.”</p>
          <footer>
            <span class="avatar" aria-hidden="true">JS</span>
            <div><strong>James Soto</strong><small>Lakewood, CO</small></div>
            <span class="stars" aria-label="5 de 5">★★★★★</span>
          </footer>
        </article>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="block pricing" id="planos">
    <div class="wrap">
      <div class="head center reveal">
        <h2>Planos que acompanham o seu crescimento.</h2>
        <div class="bill-toggle" role="group" aria-label="Periodicidade">
          <button type="button" class="is-on" data-bill="month" id="billMonth">Mensal</button>
          <button type="button" data-bill="year" id="billYear">Anual <em>Economize 2 meses</em></button>
        </div>
      </div>
      <div class="price-grid">
        <article class="price-card reveal">
          <h3>Essencial</h3>
          <p class="amt" data-month="$49" data-year="$39"><b>$49</b><small>/mês</small></p>
          <ul>
            <li>Até 3 usuários</li>
            <li>Leads, orçamentos e jobs</li>
            <li>Faturas e agenda</li>
            <li>App de campo</li>
          </ul>
          <a href="/signup" class="btn btn-outline btn-block">Começar agora</a>
        </article>
        <article class="price-card is-featured reveal d1">
          <span class="badge">Mais escolhido</span>
          <h3>Profissional</h3>
          <p class="amt" data-month="$99" data-year="$82"><b>$99</b><small>/mês</small></p>
          <ul>
            <li>Até 10 usuários</li>
            <li>Tudo do Essencial</li>
            <li>Folha, builders e ObraCam</li>
            <li>Relatórios e indicações</li>
          </ul>
          <a href="/signup" class="btn btn-primary btn-block">Começar agora</a>
        </article>
        <article class="price-card reveal d2">
          <h3>Empresarial</h3>
          <p class="amt" data-month="$149" data-year="$124"><b>$149</b><small>/mês</small></p>
          <ul>
            <li>Usuários ilimitados*</li>
            <li>Tudo do Profissional</li>
            <li>Onboarding guiado</li>
            <li>Suporte prioritário</li>
          </ul>
          <a href="mailto:hello@obramate.com" class="btn btn-outline btn-block">Falar com um especialista</a>
        </article>
      </div>
      <p class="price-note reveal"><%= days %> dias de teste grátis em qualquer plano. Sem cartão para começar.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="block faq" id="faq">
    <div class="wrap faq-grid">
      <div class="reveal">
        <h2>Perguntas frequentes</h2>
        <a href="#faq" class="btn btn-outline">Ver todas as perguntas</a>
      </div>
      <div class="faq-list reveal d1" id="faqs">
        <details open>
          <summary>O que é o <%= productName %>?</summary>
          <p>É o sistema operacional para empresas de flooring: leads, orçamentos, obras, campo, faturas e equipe num só lugar.</p>
        </details>
        <details>
          <summary>Preciso pagar alguma taxa de instalação?</summary>
          <p>Não. Você cria a conta, configura a empresa e começa. O teste de <%= days %> dias não pede cartão.</p>
        </details>
        <details>
          <summary>Funciona no celular da equipe de campo?</summary>
          <p>Sim. O Campo abre o job do dia, fotos ObraCam e horas — sincronizado com o escritório.</p>
        </details>
        <details>
          <summary>Posso usar minha Tabela de Valores?</summary>
          <p>Sim. Os preços da tabela alimentam orçamentos e serviços do job, com margem e desperdício configuráveis.</p>
        </details>
        <details>
          <summary>Meus dados ficam isolados?</summary>
          <p>Cada empresa tem o próprio workspace e subdomínio. Os dados não se misturam com outras empresas.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final" id="contato">
    <div class="wrap final-in reveal">
      <div class="final-fox" aria-hidden="true"><%- include('partials/om-fox', { pose: 'wave' }) %></div>
      <div>
        <h2>Pronto para levar sua empresa de flooring para o <em>próximo nível</em>?</h2>
        <a href="/signup" class="btn btn-primary">Começar agora</a>
      </div>
    </div>
  </section>

  <footer class="site-foot">
    <div class="wrap foot-grid">
      <div class="foot-brand">
        <span class="foot-logo">
          <img src="/assets/obramateLogoSmallTransp.png" alt="" width="24" height="24" />
          <%= productName %>
        </span>
        <p>O sistema para empresas de flooring.</p>
      </div>
      <div>
        <h4>Produto</h4>
        <a href="#funcionalidades">Funcionalidades</a>
        <a href="#planos">Planos</a>
        <a href="/signup">Começar agora</a>
      </div>
      <div>
        <h4>Recursos</h4>
        <a href="#como-funciona">Como funciona</a>
        <a href="#faq">FAQ</a>
        <a href="/pricing">Preços</a>
      </div>
      <div>
        <h4>Empresa</h4>
        <a href="/login.html">Entrar</a>
        <a href="/terms">Termos</a>
        <a href="/privacy">Privacidade</a>
      </div>
      <div>
        <h4>Siga o <%= productName %></h4>
        <div class="social">
          <a href="#" aria-label="Instagram">IG</a>
          <a href="#" aria-label="YouTube">YT</a>
          <a href="#" aria-label="LinkedIn">in</a>
          <a href="#" aria-label="Facebook">f</a>
        </div>
      </div>
    </div>
    <div class="wrap foot-bottom">
      <span>© <%= new Date().getFullYear() %> <%= productName %></span>
      <span class="lang">Português · English</span>
    </div>
  </footer>
</main>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script src="/assets/js/landing.js?v=20261016-site2" defer></script>

<%- include('partials/footer') %>
