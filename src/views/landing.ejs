<%- include('partials/header') %>

<div class="progress" id="progress" aria-hidden="true"></div>

<header class="nav" id="nav">
  <div class="wrap nav-in">
    <a href="/" class="logo" aria-label="<%= productName %> home">
      <img src="/assets/obramate-logo.png" alt="<%= productName %>" width="140" height="32" />
    </a>
    <nav class="nav-links" id="links">
      <a href="#product">Product</a>
      <a href="#calculator">Estimator</a>
      <a href="#how">How it works</a>
      <a href="/pricing">Pricing</a>
      <a href="/login.html">Sign in</a>
      <a href="/signup" class="btn btn-primary">Start free trial</a>
    </nav>
    <button type="button" class="burger" id="burger" aria-label="Menu" aria-expanded="false" aria-controls="links">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<main>
  <!-- Hero: one composition — brand, headline, proof line, CTAs, product stage -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="brand-mark reveal"><%= productName %></p>
        <h1 class="reveal d1">The operating system for flooring companies</h1>
        <p class="lead reveal d2">From first lead to paid invoice — quotes, jobs, field crews, and cash in one workspace built for installers.</p>
        <div class="cta-row reveal d3">
          <a href="/signup" class="btn btn-primary">
            Start <%= typeof trialDays !== 'undefined' ? trialDays : 30 %>-day free trial
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a href="#product" class="btn btn-ghost">See how it works</a>
        </div>
        <ul class="trust-line reveal d3">
          <li>No credit card</li>
          <li>Your company data isolated</li>
          <li>Office + field in sync</li>
        </ul>
      </div>

      <div class="hero-stage reveal d2" aria-hidden="true">
        <div class="stage-shell">
          <div class="stage-bar">
            <i></i><i></i><i></i>
            <span>yourcompany.<%= appRootDomain %></span>
          </div>
          <div class="stage-flow" id="stageFlow">
            <article class="stage-card is-on" data-step="0">
              <span class="stage-k">Lead</span>
              <strong>Rivera Residence</strong>
              <p>LVP · Living + hall</p>
              <em>$4,280 estimated</em>
            </article>
            <article class="stage-card" data-step="1">
              <span class="stage-k">Quote</span>
              <strong>Q-184 sent</strong>
              <p>Tabela · waste 8%</p>
              <em>Client viewing…</em>
            </article>
            <article class="stage-card" data-step="2">
              <span class="stage-k">Job #42</span>
              <strong>Install in progress</strong>
              <p>Crew · ObraCam photos</p>
              <em>Deposit paid</em>
            </article>
            <article class="stage-card" data-step="3">
              <span class="stage-k">Invoice</span>
              <strong>INV-091 · Balance due</strong>
              <p>Services + deposit applied</p>
              <em class="ok">Ready to collect</em>
            </article>
          </div>
          <div class="stage-rail">
            <span class="is-on" data-rail="0">Sell</span>
            <span data-rail="1">Quote</span>
            <span data-rail="2">Field</span>
            <span data-rail="3">Paid</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="strip" aria-label="What you run in ObraMate">
    <div class="wrap strip-in">
      <span>Leads</span>
      <span>Quotes</span>
      <span>Jobs</span>
      <span>Invoices</span>
      <span>Campo</span>
      <span>ObraCam</span>
      <span>Folha</span>
      <span>Builders</span>
    </div>
  </section>

  <!-- Outcome: one problem, one system -->
  <section class="block" id="why">
    <div class="wrap why-grid">
      <div class="reveal">
        <span class="eyebrow">Why <%= productName %></span>
        <h2>Stop running the company across chats, spreadsheets, and memory</h2>
      </div>
      <div class="why-list reveal d1">
        <div>
          <h3>Sell with your real prices</h3>
          <p>Tabela de Valores, waste, and markups feed every quote and job — not a one-off estimate in a notebook.</p>
        </div>
        <div>
          <h3>Run the job, not the chaos</h3>
          <p>Schedule crews, open Campo tickets, collect ObraCam photos, and keep the office in the loop.</p>
        </div>
        <div>
          <h3>Get paid without losing the thread</h3>
          <p>Deposit, progress, or full invoices from the job. Send the link, record baixa, close the balance.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Product tour -->
  <section class="block" id="product">
    <div class="wrap">
      <div class="head reveal">
        <span class="eyebrow">Product</span>
        <h2>One flow from lead to cash</h2>
        <p class="sub">What flooring companies actually use day to day — not a generic “project tool” with flooring bolted on.</p>
      </div>

      <div class="tour">
        <div class="tabs reveal" id="tabs" role="tablist" aria-label="Product areas">
          <button type="button" class="tab active" role="tab" aria-selected="true" data-i="0">
            <span class="tt">Sell <b>Leads & Quotes</b></span>
            <span class="desc">Pipeline, proposals, and public quote links with your brand.</span>
          </button>
          <button type="button" class="tab" role="tab" aria-selected="false" data-i="1">
            <span class="tt">Deliver <b>Jobs & Campo</b></span>
            <span class="desc">Jobs, schedule, field tickets, hours, and ObraCam photos.</span>
          </button>
          <button type="button" class="tab" role="tab" aria-selected="false" data-i="2">
            <span class="tt">Collect <b>Invoices</b></span>
            <span class="desc">Deposit or full from the job — e-mail the client and record payment.</span>
          </button>
          <button type="button" class="tab" role="tab" aria-selected="false" data-i="3">
            <span class="tt">Operate <b>Team & money</b></span>
            <span class="desc">Roles, Folha, fluxo de caixa, builders, and referrals.</span>
          </button>
        </div>

        <div class="stage reveal d1" id="productStage">
          <div class="pane show" data-pane="0">
            <div class="mock">
              <header><span>Pipeline</span><em>This week</em></header>
              <div class="row"><i class="dot d-muted"></i>New · Website form<span>2m</span></div>
              <div class="row"><i class="dot d-blue"></i>Contacted · Measure booked<span>Maria</span></div>
              <div class="row"><i class="dot d-brand"></i>Quote Q-184 sent<span>$4,280</span></div>
              <div class="row"><i class="dot d-ok"></i>Won · Converted to job<span>Today</span></div>
            </div>
          </div>
          <div class="pane" data-pane="1">
            <div class="mock">
              <header><span>Job #42</span><em>In field</em></header>
              <div class="row">Client · Rivera Residence<span>LVP</span></div>
              <div class="row">Crew · Assigned<span>Campo open</span></div>
              <div class="row">ObraCam · Before / during<span>12 photos</span></div>
              <div class="row">Hours logged<span>6.5 h</span></div>
            </div>
          </div>
          <div class="pane" data-pane="2">
            <div class="mock">
              <header><span>Faturar job</span><em>Choose amount</em></header>
              <div class="row hi">Depósito 50%<span>$2,140</span></div>
              <div class="row">Outro valor<span>Custom</span></div>
              <div class="row">Valor total<span>$4,280</span></div>
              <div class="row"><b>Services listed on the invoice</b><span>Total Services</span></div>
            </div>
          </div>
          <div class="pane" data-pane="3">
            <div class="mock">
              <header><span>Operations</span><em>Office</em></header>
              <div class="row">Roles & invites<span>Admin · Sales · Crew</span></div>
              <div class="row">Folha · field hours<span>Payroll ready</span></div>
              <div class="row">Fluxo · cash position<span>This week</span></div>
              <div class="row">Builders · Tabela<span>B2B pricing</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Live calculator — conversion tool -->
  <section class="block calc-block" id="calculator">
    <div class="wrap">
      <div class="head center reveal">
        <span class="eyebrow">Live estimator</span>
        <h2>Feel the quote before you sign up</h2>
        <p class="sub">Same waste and markup ideas your workspace can tune. Change the area — watch the total move.</p>
      </div>
      <div class="calc reveal">
        <div class="calc-in">
          <div class="lbl">Flooring type</div>
          <div class="types" id="types"></div>
          <div class="lbl">Area <span>sq ft</span></div>
          <div class="area-box"><input type="number" id="area" value="350" min="10" max="5000" aria-label="Area in square feet" /><span>sqft</span></div>
          <input type="range" id="areaR" min="10" max="3000" step="10" value="350" aria-label="Area slider" />
          <div class="presets">
            <button type="button" data-a="150">Bedroom · 150</button>
            <button type="button" data-a="350">Living · 350</button>
            <button type="button" data-a="900">Main floor · 900</button>
            <button type="button" data-a="2000">Whole house · 2,000</button>
          </div>
          <details class="adv">
            <summary>Adjust waste & markups</summary>
            <div class="knobs" id="knobs"></div>
          </details>
        </div>
        <div class="calc-out">
          <div class="out-top"><small id="outType">Hardwood · 350 sqft</small></div>
          <div class="total" id="total">$0</div>
          <div class="per" id="per">$0.00 per sqft installed</div>
          <div class="stack"><div id="sMat"></div><div id="sLab"></div></div>
          <div class="lines">
            <div class="line"><span>Billable area (incl. waste)</span><strong id="billable">0</strong></div>
            <div class="line"><span><i class="i-mat"></i>Material</span><strong id="mat">$0</strong></div>
            <div class="line"><span><i class="i-lab"></i>Labor</span><strong id="lab">$0</strong></div>
          </div>
          <p class="note">Illustrative defaults. In <%= productName %>, each company sets its own Tabela and rules.</p>
          <a href="/signup" class="btn btn-primary btn-block">Save real quotes — start free</a>
        </div>
      </div>
    </div>
  </section>

  <section class="block" id="how">
    <div class="wrap">
      <div class="head center reveal">
        <span class="eyebrow">How it works</span>
        <h2>Live in minutes, not months</h2>
      </div>
      <ol class="steps" id="steps">
        <li class="step reveal"><span class="n">1</span><h3>Create your company</h3><p>Name, subdomain, and you as admin. No card required.</p></li>
        <li class="step reveal d1"><span class="n">2</span><h3>Invite the team</h3><p>Sales, office, and crew — with roles that stick.</p></li>
        <li class="step reveal d2"><span class="n">3</span><h3>Run the next job</h3><p>Quote → schedule → Campo → invoice → paid.</p></li>
      </ol>
      <blockquote class="story reveal">
        <p><%= productName %> grew out of a real flooring installer’s day-to-day — leads, crews, photos, and getting paid — opened for other flooring companies.</p>
      </blockquote>
    </div>
  </section>

  <section class="block" id="faq">
    <div class="wrap faq-grid">
      <div>
        <div class="head reveal" style="margin-bottom:1.25rem">
          <span class="eyebrow">FAQ</span>
          <h2>Straight answers</h2>
        </div>
        <div class="reveal" id="faqs"></div>
      </div>
      <aside class="price-card reveal d1" id="price">
        <span class="tag">Start here</span>
        <h3>Free trial</h3>
        <p class="amt"><%= typeof trialDays !== 'undefined' ? trialDays : 30 %> <small>days · no card</small></p>
        <ul>
          <li>Leads, quotes &amp; customers</li>
          <li>Jobs, schedule &amp; Campo</li>
          <li>Invoices &amp; payments</li>
          <li>ObraCam, Folha &amp; team roles</li>
        </ul>
        <a href="/signup" class="btn btn-primary btn-block">Start free trial</a>
        <a href="/pricing" class="more">See pricing →</a>
      </aside>
    </div>
  </section>

  <section class="final-wrap">
    <div class="wrap">
      <div class="final reveal">
        <img src="/assets/obramate-logo.png" alt="<%= productName %>" class="final-logo" width="160" height="36" />
        <h2>Your next install should already be in <%= productName %></h2>
        <p><%= typeof trialDays !== 'undefined' ? trialDays : 30 %> days free. Office and field on the same page.</p>
        <div class="cta-row">
          <a href="/signup" class="btn btn-primary">Start free trial</a>
          <a href="/login.html" class="btn btn-ghost">Sign in</a>
        </div>
      </div>
      <footer class="site-foot">
        <nav>
          <a href="/pricing">Pricing</a>
          <a href="/signup">Start free trial</a>
          <a href="/login.html">Sign in</a>
          <a href="/terms">Terms</a>
          <a href="/privacy">Privacy</a>
        </nav>
        <span>© <%= new Date().getFullYear() %> <%= productName %></span>
      </footer>
    </div>
  </section>
</main>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
  window.__ESTIMATE_RULES__ = <%- JSON.stringify(estimateRules) %>;
</script>
<script src="/assets/js/landing.js?v=20261015-site1" defer></script>

<%- include('partials/footer') %>
