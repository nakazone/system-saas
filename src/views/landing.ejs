<%- include('partials/header') %>
<% const days = typeof trialDays !== 'undefined' ? trialDays : 30; %>

<div class="progress" id="progress" aria-hidden="true"></div>

<header class="nav" id="nav">
  <div class="wrap nav-in">
    <a href="/" class="logo" aria-label="<%= productName %>">
      <img src="/assets/obramateLogoSmallTransp.png" alt="" width="28" height="28" />
      <span><%= productName %></span>
    </a>
    <nav class="nav-links" id="links" aria-label="Navegação principal">
      <a href="#funcionalidades">Recursos</a>
      <a href="#como-funciona">Como funciona</a>
      <a href="#planos">Planos</a>
      <a href="#faq">Perguntas</a>
      <a href="/login.html" class="nav-signin">Entrar</a>
      <a href="/signup" class="btn btn-primary">Começar grátis</a>
    </nav>
    <button type="button" class="burger" id="burger" aria-label="Abrir menu" aria-expanded="false" aria-controls="links">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<main>
  <section class="hero" id="topo">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Feito para empresas de flooring</p>
        <h1>Da primeira oportunidade à fatura final, <em>sua operação em ordem.</em></h1>
        <p class="lead">Leads, orçamentos, obras, equipe e financeiro em um sistema feito para instaladores de piso.</p>
        <div class="cta-row">
          <a href="/signup" class="btn btn-primary">Começar teste grátis</a>
          <a href="#funcionalidades" class="text-link">Explorar recursos</a>
        </div>
        <p class="trial-note"><%= days %> dias para testar · Sem cartão de crédito</p>
      </div>

      <div class="hero-visual">
        <div class="dashboard-preview" role="img" aria-label="Prévia do painel ObraMate com leads, orçamentos, obras e recebimentos">
          <aside class="dashboard-rail" aria-hidden="true">
            <strong class="rail-mark">O</strong>
            <span class="rail-active">Visão geral</span>
            <span>Leads</span>
            <span>Orçamentos</span>
            <span>Obras</span>
            <span>Financeiro</span>
          </aside>
          <div class="dashboard-body">
            <div class="dashboard-heading">
              <div><small>Visão geral</small><strong>Boa tarde, Carlos</strong></div>
              <span class="demo-period">Últimos 30 dias</span>
            </div>
            <div class="dashboard-kpis">
              <div><small>Leads</small><strong>12</strong><span>3 novos</span></div>
              <div><small>Orçamentos</small><strong>8</strong><span>5 enviados</span></div>
              <div><small>Obras ativas</small><strong>5</strong><span>2 esta semana</span></div>
              <div><small>A receber</small><strong>US$ 12.480</strong><span>4 faturas</span></div>
            </div>
            <div class="dashboard-list-head"><strong>Obras em andamento</strong><a href="#funcionalidades">Explorar sistema</a></div>
            <div class="dashboard-row"><span>Rivera · Piso vinílico</span><span class="status status-progress">Em andamento</span></div>
            <div class="dashboard-row"><span>Chen · Madeira</span><span class="status status-sent">Orçamento enviado</span></div>
            <div class="dashboard-row"><span>Park · Escadas</span><span class="status status-progress">Em andamento</span></div>
          </div>
        </div>
        <img class="hero-mate" src="/assets/img/mascot/mate-hero.webp" alt="" width="268" height="480" fetchpriority="high" />
      </div>
    </div>
    <div class="wrap hero-proof" aria-label="Benefícios">
      <span>Sem cartão de crédito</span>
      <span><%= days %> dias de teste</span>
      <span>Feito para equipes de flooring</span>
    </div>
  </section>

  <section class="explorer" id="funcionalidades" aria-labelledby="explorer-title">
    <div class="wrap">
      <div class="section-heading">
        <h2 id="explorer-title">Explore o ObraMate por dentro</h2>
        <p>Selecione um recurso e veja como as informações do escritório e do campo se conectam.</p>
      </div>

      <div class="feature-explorer" data-feature-explorer>
        <div class="feature-tabs" role="tablist" aria-label="Recursos do ObraMate">
          <button type="button" class="feature-tab" id="tab-leads" role="tab" aria-selected="false" aria-controls="panel-leads" tabindex="-1" data-feature-tab="leads">Leads</button>
          <button type="button" class="feature-tab is-active" id="tab-quotes" role="tab" aria-selected="true" aria-controls="panel-quotes" tabindex="0" data-feature-tab="quotes">Orçamentos</button>
          <button type="button" class="feature-tab" id="tab-jobs" role="tab" aria-selected="false" aria-controls="panel-jobs" tabindex="-1" data-feature-tab="jobs">Obras</button>
          <button type="button" class="feature-tab" id="tab-finance" role="tab" aria-selected="false" aria-controls="panel-finance" tabindex="-1" data-feature-tab="finance">Financeiro</button>
          <button type="button" class="feature-tab" id="tab-team" role="tab" aria-selected="false" aria-controls="panel-team" tabindex="-1" data-feature-tab="team">Equipe e agenda</button>
        </div>
        <p class="demo-hint">Use as abas e os controles da prévia para explorar os recursos.</p>

        <section class="feature-panel" id="panel-leads" role="tabpanel" aria-labelledby="tab-leads" tabindex="0" data-feature-panel="leads" hidden>
          <div class="panel-copy">
            <p class="eyebrow">Leads e clientes</p>
            <h3>Saiba quem precisa de retorno.</h3>
            <p>Organize novos contatos, acompanhe cada etapa e mantenha o próximo passo visível para a equipe.</p>
            <ul class="benefit-list"><li>Pipeline por etapa</li><li>Próximo contato em destaque</li><li>Cadastro de clientes e builders</li></ul>
          </div>
          <div class="product-window" aria-label="Demonstração de leads">
            <div class="window-topbar"><div><small>VENDAS</small><strong>Pipeline de leads</strong></div><button type="button" class="btn btn-small btn-primary" data-demo-action="new-lead">Novo lead</button></div>
            <div class="lead-table-head"><span>Cliente</span><span>Projeto</span><span>Etapa</span><span>Próxima ação</span></div>
            <div class="lead-row"><div><strong>Amanda Silva</strong><small>Denver, CO</small></div><span>Piso vinílico · 120 ft²</span><span class="status status-new">Novo lead</span><button type="button" class="row-action" data-demo-action="follow-up">Marcar retorno</button></div>
            <div class="lead-row"><div><strong>Marco Rivera</strong><small>Aurora, CO</small></div><span>Madeira · 860 ft²</span><span class="status status-sent">Em contato</span><span class="row-muted">Hoje, 14h</span></div>
            <div class="lead-row"><div><strong>Chen Family</strong><small>Lakewood, CO</small></div><span>Escadas · 14 degraus</span><span class="status status-progress">Visita marcada</span><span class="row-muted">Amanhã</span></div>
          </div>
        </section>

        <section class="feature-panel" id="panel-quotes" role="tabpanel" aria-labelledby="tab-quotes" tabindex="0" data-feature-panel="quotes">
          <div class="panel-copy">
            <p class="eyebrow">Orçamentos</p>
            <h3>Crie propostas profissionais em minutos.</h3>
            <p>Monte o orçamento com materiais, mão de obra e medidas. Revise o total e envie um link para o cliente.</p>
            <ul class="benefit-list"><li>Itens e quantidades organizados</li><li>Materiais e mão de obra no mesmo orçamento</li><li>Total em USD antes do envio</li></ul>
            <p class="panel-footnote">Prévia demonstrativa com valores de exemplo.</p>
          </div>
          <div class="product-window quote-window" aria-label="Demonstração interativa de orçamento">
            <div class="window-topbar quote-topbar">
              <div><small>ORÇAMENTO #1024</small><strong>Residência Rivera</strong></div>
              <span class="status status-draft" data-quote-status>Rascunho</span>
              <div class="window-actions"><button type="button" class="btn btn-small btn-outline" data-demo-action="save-draft">Salvar rascunho</button><button type="button" class="btn btn-small btn-primary" data-demo-action="send-quote">Enviar ao cliente</button></div>
            </div>
            <div class="quote-meta">
              <label>Cliente<input value="Marco Rivera" readonly /></label>
              <label>Tipo de piso<select aria-label="Tipo de piso"><option>Piso vinílico</option><option>Madeira</option><option>Laminado</option></select></label>
              <label>Área (ft²)<input id="quote-area" type="number" min="1" step="1" value="120" inputmode="numeric" /></label>
            </div>
            <div class="quote-table-wrap">
              <table class="quote-table">
                <thead><tr><th>Item</th><th>Tipo</th><th>Quantidade</th><th>Preço unitário</th><th>Total</th></tr></thead>
                <tbody>
                  <tr><td>Piso vinílico</td><td>Material</td><td data-quote-quantity>120 ft²</td><td>US$ 3,20</td><td data-quote-line="3.2">US$ 384,00</td></tr>
                  <tr><td>Instalação</td><td>Mão de obra</td><td data-quote-quantity>120 ft²</td><td>US$ 4,50</td><td data-quote-line="4.5">US$ 540,00</td></tr>
                </tbody>
              </table>
            </div>
            <div class="quote-total"><span>Total da proposta</span><strong id="quote-total" aria-live="polite">US$ 924,00</strong></div>
          </div>
        </section>

        <section class="feature-panel" id="panel-jobs" role="tabpanel" aria-labelledby="tab-jobs" tabindex="0" data-feature-panel="jobs" hidden>
          <div class="panel-copy">
            <p class="eyebrow">Obras e campo</p>
            <h3>Acompanhe o que está acontecendo na obra.</h3>
            <p>Organize o trabalho do dia, registre o andamento e mantenha o escritório informado sobre cada etapa.</p>
            <ul class="benefit-list"><li>Etapas da instalação em um só lugar</li><li>Fotos e atualizações do Campo</li><li>Progresso visível para o escritório</li></ul>
          </div>
          <div class="product-window" aria-label="Demonstração de acompanhamento de obra">
            <div class="window-topbar"><div><small>OBRA #1024</small><strong>Residência Rivera · Denver, CO</strong></div><span class="status status-progress">Em andamento</span></div>
            <div class="job-summary"><div><small>Equipe</small><strong>Equipe Norte</strong></div><div><small>Início</small><strong>Hoje, 8h</strong></div><div><small>Progresso</small><strong data-job-progress-label>2 de 4 etapas</strong></div></div>
            <div class="progress-track" role="progressbar" aria-label="Progresso da instalação" aria-valuemin="0" aria-valuemax="4" aria-valuenow="2" data-job-progress><span style="width:50%"></span></div>
            <div class="job-checklist">
              <label><input type="checkbox" checked data-job-step /><span><strong>Preparação do ambiente</strong><small>Concluída · 8:15</small></span></label>
              <label><input type="checkbox" checked data-job-step /><span><strong>Remoção do piso antigo</strong><small>Concluída · 9:40</small></span></label>
              <label><input type="checkbox" data-job-step /><span><strong>Instalação do piso</strong><small>Marque quando finalizar</small></span></label>
              <label><input type="checkbox" data-job-step /><span><strong>Revisão e limpeza</strong><small>Pendente</small></span></label>
            </div>
          </div>
        </section>

        <section class="feature-panel" id="panel-finance" role="tabpanel" aria-labelledby="tab-finance" tabindex="0" data-feature-panel="finance" hidden>
          <div class="panel-copy">
            <p class="eyebrow">Faturas e recebimentos</p>
            <h3>Tenha clareza sobre o que entrou e o que falta.</h3>
            <p>Emita faturas ligadas à obra e acompanhe depósitos, saldos e pagamentos sem perder o histórico.</p>
            <ul class="benefit-list"><li>Faturas conectadas aos jobs</li><li>Status de pagamento visível</li><li>Valores a receber organizados</li></ul>
          </div>
          <div class="product-window" aria-label="Demonstração de faturas e recebimentos">
            <div class="window-topbar"><div><small>FINANCEIRO</small><strong>Faturas recentes</strong></div><span class="demo-period">Este mês</span></div>
            <div class="finance-summary"><span><small>A receber</small><strong>US$ 4.820,00</strong></span><span><small>Recebido no mês</small><strong>US$ 8.640,00</strong></span></div>
            <div class="invoice-row"><div><strong>Fatura #1024</strong><small>Residência Rivera · Saldo final</small></div><strong>US$ 924,00</strong><span class="status status-pending" data-invoice-status>Em aberto</span><button type="button" class="row-action" data-demo-action="record-payment">Registrar recebimento</button></div>
            <div class="invoice-row"><div><strong>Fatura #1021</strong><small>Chen Family · Depósito</small></div><strong>US$ 1.500,00</strong><span class="status status-paid">Recebida</span><span class="row-muted">18 out</span></div>
            <div class="invoice-row"><div><strong>Fatura #1018</strong><small>Park Home · Pagamento final</small></div><strong>US$ 2.396,00</strong><span class="status status-paid">Recebida</span><span class="row-muted">16 out</span></div>
          </div>
        </section>

        <section class="feature-panel" id="panel-team" role="tabpanel" aria-labelledby="tab-team" tabindex="0" data-feature-panel="team" hidden>
          <div class="panel-copy">
            <p class="eyebrow">Equipe e agenda</p>
            <h3>Todo mundo sabe onde precisa estar.</h3>
            <p>Distribua visitas e obras no calendário e mantenha escritório e equipe de campo alinhados.</p>
            <ul class="benefit-list"><li>Visitas e obras na mesma agenda</li><li>Responsáveis definidos por atividade</li><li>Atualizações acessíveis pelo celular</li></ul>
          </div>
          <div class="product-window" aria-label="Demonstração de agenda da equipe">
            <div class="window-topbar"><div><small>AGENDA DA EQUIPE</small><strong>Hoje · Terça-feira</strong></div><span class="demo-period">Denver, CO</span></div>
            <div class="schedule-row"><time>8:00</time><div><strong>Instalação · Rivera</strong><small>Piso vinílico · 120 ft²</small></div><span class="schedule-person" data-assigned-person>Equipe Norte</span></div>
            <div class="schedule-row"><time>11:30</time><div><strong>Visita · Chen Family</strong><small>Medidas para novo orçamento</small></div><span class="schedule-person">Carlos</span></div>
            <div class="schedule-row"><time>14:00</time><div><strong>Instalação · Park Home</strong><small>Revisão final</small></div><span class="schedule-person">Equipe Sul</span></div>
            <div class="assign-demo"><label for="team-assignee">Reatribuir a obra Rivera</label><select id="team-assignee"><option>Equipe Norte</option><option>Equipe Sul</option><option>Carlos</option></select><button type="button" class="btn btn-small btn-primary" data-demo-action="assign-team">Atualizar equipe</button></div>
          </div>
        </section>
      </div>
      <p class="explorer-cta"><a class="btn btn-primary" href="/signup">Começar teste grátis</a></p>
    </div>
  </section>

  <section class="workflow" id="como-funciona" aria-labelledby="workflow-title">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Um fluxo simples</p>
        <h2 id="workflow-title">Do lead ao pagamento, sem perder o fio da obra.</h2>
        <p>As informações acompanham o serviço do primeiro contato até o recebimento.</p>
      </div>
      <ol class="workflow-steps">
        <li><span class="step-number">01</span><h3>Organize o lead</h3><p>Registre o cliente e acompanhe o próximo contato.</p></li>
        <li><span class="step-number">02</span><h3>Envie o orçamento</h3><p>Monte materiais e mão de obra em uma proposta clara.</p></li>
        <li><span class="step-number">03</span><h3>Acompanhe a obra</h3><p>Compartilhe etapas, equipe e atualizações do campo.</p></li>
        <li><span class="step-number">04</span><h3>Registre o pagamento</h3><p>Conecte faturas e recebimentos ao trabalho concluído.</p></li>
      </ol>
    </div>
  </section>

  <section class="pricing" id="planos" aria-labelledby="pricing-title">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Planos</p>
        <h2 id="pricing-title">Escolha o plano para o tamanho da sua equipe.</h2>
        <p>Todos incluem <%= days %> dias de teste grátis. Sem cartão para começar.</p>
        <div class="bill-toggle" role="group" aria-label="Periodicidade de cobrança">
          <button type="button" class="is-on" data-bill="month" aria-pressed="true">Mensal</button>
          <button type="button" data-bill="year" aria-pressed="false">Anual <em>Economize 2 meses</em></button>
        </div>
      </div>
      <div class="price-grid">
        <article class="price-card">
          <h3>Essencial</h3><p class="plan-for">Para começar organizado</p>
          <p class="amt" data-month="$49" data-year="$39"><b>$49</b><small>/mês</small></p>
          <ul><li>Até 3 usuários</li><li>Leads, orçamentos e obras</li><li>Faturas e agenda</li><li>App de campo</li></ul>
          <a href="/signup" class="btn btn-outline btn-block">Começar teste grátis</a>
        </article>
        <article class="price-card is-featured">
          <span class="badge">Mais escolhido</span><h3>Profissional</h3><p class="plan-for">Para equipes em crescimento</p>
          <p class="amt" data-month="$99" data-year="$82"><b>$99</b><small>/mês</small></p>
          <ul><li>Até 10 usuários</li><li>Tudo do Essencial</li><li>Folha, builders e ObraCam</li><li>Relatórios e indicações</li></ul>
          <a href="/signup" class="btn btn-primary btn-block">Começar teste grátis</a>
        </article>
        <article class="price-card">
          <h3>Empresarial</h3><p class="plan-for">Para operações maiores</p>
          <p class="amt" data-month="$149" data-year="$124"><b>$149</b><small>/mês</small></p>
          <ul><li>Usuários ilimitados*</li><li>Tudo do Profissional</li><li>Onboarding guiado</li><li>Suporte prioritário</li></ul>
          <a href="mailto:hello@obramate.com" class="btn btn-outline btn-block">Falar com um especialista</a>
        </article>
      </div>
      <p class="price-note">Os valores anuais são apresentados por mês, com cobrança anual.</p>
    </div>
  </section>

  <section class="faq" id="faq" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <div class="faq-intro"><p class="eyebrow">Dúvidas comuns</p><h2 id="faq-title">Perguntas frequentes</h2><a href="mailto:hello@obramate.com" class="text-link">Fale com a equipe</a></div>
      <div class="faq-list">
        <details open><summary>O que é o <%= productName %>?</summary><p>É o sistema operacional para empresas de flooring: leads, orçamentos, obras, campo, faturas e equipe num só lugar.</p></details>
        <details><summary>Preciso pagar alguma taxa de instalação?</summary><p>Não. Você cria a conta, configura a empresa e começa. O teste de <%= days %> dias não pede cartão.</p></details>
        <details><summary>Funciona no celular da equipe de campo?</summary><p>Sim. O Campo abre o job do dia, fotos ObraCam e horas, sincronizados com o escritório.</p></details>
        <details><summary>Posso usar minha Tabela de Valores?</summary><p>Sim. Os preços da tabela alimentam orçamentos e serviços do job, com margem e desperdício configuráveis.</p></details>
        <details><summary>Meus dados ficam isolados?</summary><p>Cada empresa tem o próprio workspace e subdomínio. Os dados não se misturam com outras empresas.</p></details>
      </div>
    </div>
  </section>

  <section class="final" id="contato">
    <div class="wrap final-in">
      <div class="final-copy"><p class="eyebrow">Comece hoje</p><h2>Leve mais organização para o seu próximo trabalho.</h2><p>Teste o ObraMate e acompanhe leads, obras e recebimentos em um só lugar.</p><a href="/signup" class="btn btn-primary">Começar teste grátis</a><small><%= days %> dias para testar · Sem cartão de crédito</small></div>
      <img class="final-mate" src="/assets/img/mascot/mate-thumbs.webp" alt="" width="144" height="134" loading="lazy" decoding="async" />
    </div>
  </section>

  <footer class="site-foot">
    <div class="wrap foot-grid">
      <div class="foot-brand"><a class="foot-logo" href="/" aria-label="<%= productName %>"><img src="/assets/obramateLogoSmallTransp.png" alt="" width="24" height="24" /><strong><%= productName %></strong></a><p>Gestão para empresas de flooring.</p></div>
      <div><h3>Produto</h3><a href="#funcionalidades">Recursos</a><a href="#como-funciona">Como funciona</a><a href="#planos">Planos</a></div>
      <div><h3>Ajuda</h3><a href="#faq">Perguntas frequentes</a><a href="mailto:hello@obramate.com">Contato</a></div>
      <div><h3>Conta</h3><a href="/signup">Começar teste grátis</a><a href="/login.html">Entrar</a><a href="/terms">Termos</a><a href="/privacy">Privacidade</a></div>
    </div>
    <div class="wrap foot-bottom"><span>© <%= new Date().getFullYear() %> <%= productName %></span><span>Feito para quem instala piso.</span></div>
  </footer>
</main>

<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script src="/assets/js/landing.js?v=20261027-explorer1" defer></script>

<%- include('partials/footer') %>
