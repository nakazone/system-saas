<section class="mkt-section" id="calculator">
  <div class="mkt-section-head">
    <h2>Live estimate calculator</h2>
    <p>
      Same default waste and markup rules used when a new organization is created.
      Change the flooring type or area to recalculate instantly.
    </p>
  </div>

  <div class="calc-card" data-estimate-calculator>
    <div class="calc-controls">
      <label for="calcFlooring">Flooring type</label>
      <select id="calcFlooring" data-calc-flooring>
        <% estimateRules.forEach(function (rule) { %>
          <option
            value="<%= rule.flooringType %>"
            data-waste="<%= rule.wastePercent %>"
            data-price="<%= rule.defaultPricePerSqft %>"
            data-labor="<%= rule.defaultLaborPerSqft %>"
            data-mm="<%= rule.materialMarkup %>"
            data-lm="<%= rule.laborMarkup %>"
          ><%= rule.flooringType %></option>
        <% }) %>
      </select>

      <label for="calcArea">Area (sqft)</label>
      <input id="calcArea" type="number" min="1" step="1" value="350" data-calc-area />

      <p class="calc-meta muted" data-calc-meta></p>
    </div>

    <div class="calc-results">
      <div class="calc-result-row"><span>Billable area (incl. waste)</span><strong data-calc-billable>—</strong></div>
      <div class="calc-result-row"><span>Material (with markup)</span><strong data-calc-material>—</strong></div>
      <div class="calc-result-row"><span>Labor (with markup)</span><strong data-calc-labor>—</strong></div>
      <div class="calc-result-row calc-total"><span>Estimated total</span><strong data-calc-total>—</strong></div>
      <p class="mkt-fineprint">Illustrative defaults only. Each organization can change these rules in Settings.</p>
    </div>
  </div>
</section>

