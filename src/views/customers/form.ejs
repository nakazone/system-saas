<%- include('../partials/header') %>
<div class="page-header">
  <h1><%= customer ? 'Edit customer' : 'New customer' %></h1>
</div>
<div class="panel" style="max-width:560px">
  <form method="post" action="<%= customer ? '/customers/' + customer.id : '/customers' %>">
    <label>Name</label>
    <input name="name" required value="<%= customer ? customer.name : '' %>" />
    <label>Email</label>
    <input type="email" name="email" value="<%= customer && customer.email ? customer.email : '' %>" />
    <label>Phone</label>
    <input name="phone" value="<%= customer && customer.phone ? customer.phone : '' %>" />
    <label>Address</label>
    <input name="address" value="<%= customer && customer.address ? customer.address : '' %>" />
    <label style="font-weight:500;margin-top:0.75rem;display:block">
      <input type="checkbox" name="marketingConsent" <%= !customer || customer.marketingConsent !== false ? 'checked' : '' %> style="width:auto" />
      Marketing consent
    </label>
    <label style="font-weight:500;display:block">
      <input type="checkbox" name="transactionalOptOut" <%= customer && customer.transactionalOptOut ? 'checked' : '' %> style="width:auto" />
      Opt out of transactional emails (quotes, visit reminders)
    </label>
    <div class="form-actions">
      <button class="btn" type="submit">Save</button>
      <a class="btn btn-secondary" href="/customers">Cancel</a>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
