<%
  const accent = /^#[0-9a-fA-F]{6}$/.test(organization.accentColor || '') ? organization.accentColor : '#e8792c';
  const ink = /^#[0-9a-fA-F]{6}$/.test(organization.primaryColor || '') ? organization.primaryColor : '#211d1a';
  const fmt = (n) => (Number(n) < 0 ? '-$' : '$') + Math.abs(Number(n || 0)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const fdate = (d) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : '—';
  const st = money.displayStatus;
  const instructions = invoice.paymentInstructions || organization.paymentInstructions;
  const orgBlock = typeof docOrg !== 'undefined' && docOrg ? docOrg : null;
  const summary = typeof contractSummary !== 'undefined' && contractSummary ? contractSummary : null;
  const lines = (typeof lineItems !== 'undefined' && lineItems.length ? lineItems : invoice.lineItems) || [];
%><!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex" />
  <title><%= title %> · <%= organization.name %></title>
  <style>
    :root { --accent: <%= accent %>; --ink: <%= ink %>; --muted: #6b645c; --rule: #e2d9cc; --panel: #f7f4ee; --stamp: #c1652f; --muted-light: #8a8074; }
    * { box-sizing: border-box; }
    body { font-family: Helvetica, Arial, sans-serif; margin: 0; background: #f3f0ea; color: var(--ink); }
    .bar { height: 5px; background: var(--accent); }
    main { max-width: 816px; margin: 0 auto; padding: 24px 16px 48px; }
    .paper { position: relative; background: #fff; border: 1px solid var(--rule); border-radius: 4px; padding: 48px; overflow: hidden; }
    .top { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-bottom: 18px; border-bottom: 1px solid var(--rule); }
    .org { display: flex; gap: 12px; align-items: flex-start; max-width: 340px; }
    .org img, .org .ini { width: 44px; height: 44px; object-fit: contain; border-radius: 6px; flex-shrink: 0; }
    .org .ini { display: flex; align-items: center; justify-content: center; background: var(--ink); color: #fff; font-weight: 700; font-size: 15px; }
    .org b { font-size: 14px; display: block; margin-bottom: 2px; }
    .org span { color: var(--muted); font-size: 12px; display: block; line-height: 1.35; }
    .doc-title { text-align: right; }
    .doc-title h1 { margin: 0; font-size: 24px; letter-spacing: .02em; }
    .doc-title p { margin: 6px 0 0; color: var(--muted); font-size: 14px; }
    .label { color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; margin: 0 0 4px; }
    .grid { display: grid; grid-template-columns: 1fr auto; gap: 24px; margin-top: 28px; }
    .meta { display: grid; grid-template-columns: auto auto; gap: 6px 16px; font-size: 13px; align-content: start; }
    .meta dt { color: var(--muted-light); } .meta dd { margin: 0; text-align: right; font-weight: 700; max-width: 180px; }
    .bill strong { font-size: 15px; }
    .bill .sub { color: var(--muted); font-size: 13px; margin-top: 2px; line-height: 1.35; }
    table { width: 100%; border-collapse: collapse; margin-top: 22px; font-size: 14px; }
    th { text-align: left; color: var(--ink); font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; border-bottom: none; padding: 8px 10px; background: #e8eaee; }
    th:first-child { border-radius: 6px 0 0 6px; }
    th:last-child { border-radius: 0 6px 6px 0; }
    td { padding: 12px 0; border-bottom: 1px solid #f0ebe3; vertical-align: top; }
    .r { text-align: right; }
    .totals { margin-left: auto; width: min(320px, 100%); margin-top: 16px; font-size: 14px; }
    .totals div { display: flex; justify-content: space-between; gap: 12px; padding: 5px 0; color: var(--muted); }
    .totals .grand { color: var(--ink); font-weight: 700; font-size: 15px; border-top: 2px solid var(--ink); margin-top: 6px; padding-top: 10px; }
    .totals .after { color: var(--muted); font-size: 12px; font-weight: 600; padding-top: 2px; }
    .box { margin-top: 24px; }
    .box p { margin: 0; white-space: pre-line; line-height: 1.5; font-size: 14px; }
    .actions { display: flex; gap: 10px; margin-top: 20px; flex-wrap: wrap; }
    .btn { display: inline-flex; align-items: center; gap: 8px; padding: 11px 18px; border-radius: 9px; font-weight: 600; text-decoration: none; font-size: 14px; border: 1px solid var(--rule); color: var(--ink); background: #fff; cursor: pointer; }
    .btn.primary { background: var(--ink); color: #fff; border-color: var(--ink); }
    .totals-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 16px; }
    .totals-row .totals { margin-top: 0; }
    .stamp { position: relative; margin-left: 12px; flex-shrink: 0; transform: rotate(-12deg); border: 3px solid var(--stamp); color: var(--stamp); border-radius: 7px; padding: 8px 18px; text-align: center; font-weight: 800; letter-spacing: .1em; opacity: .85; pointer-events: none; box-shadow: inset 0 0 0 1px #fff, inset 0 0 0 2px var(--stamp); }
    .stamp b { display: block; font-size: 34px; line-height: 1; }
    .stamp small { display: block; font-size: 11px; margin-top: 4px; }
    .stamp.partial b { font-size: 16px; }
    .foot { text-align: center; color: var(--muted); font-size: 12px; margin-top: 18px; line-height: 1.5; }
    .foot .made { color: var(--muted-light); font-size: 11px; margin-top: 4px; }
    @media (max-width: 640px) {
      .paper { padding: 22px 18px; }
      .grid { grid-template-columns: 1fr; }
      .meta dd { text-align: left; max-width: none; }
      .doc-title { text-align: left; }
      .totals-row { flex-direction: column-reverse; align-items: stretch; }
      .stamp { align-self: center; margin: 10px 0 0; }
      .stamp b { font-size: 28px; }
    }
    @media print {
      body { background: #fff; }
      main { padding: 0; max-width: none; }
      .actions, .foot .made { display: none; }
      .paper { border: 0; border-radius: 0; padding: 36px; }
    }
  </style>
  <link rel="stylesheet" href="/om-stable-viewport.css?v=20261007-stable1" id="om-stable-viewport-css" />
</head>
<body>
  <div class="bar"></div>
  <main>
    <article class="paper">
      <div class="top">
        <div class="org">
          <% if (organization.logoUrl) { %>
            <img src="<%= organization.logoUrl %>" alt="" />
          <% } else {
            const parts = String(organization.name || '').trim().split(/\s+/).filter(Boolean);
            const ini = parts.length >= 2 ? (parts[0][0] + parts[1][0]).toUpperCase() : (organization.name || 'OM').replace(/[^A-Za-z0-9]/g, '').slice(0, 2).toUpperCase() || 'OM';
          %>
            <div class="ini" aria-hidden="true"><%= ini %></div>
          <% } %>
          <div>
            <b><%= organization.name %></b>
            <% if (orgBlock && orgBlock.address) { %><span><%= orgBlock.address %></span><% } %>
            <% if (orgBlock && orgBlock.contact) { %><span><%= orgBlock.contact %></span><% }
               else if (organization.contactPhone || organization.contactEmail) { %>
              <span><%= [organization.contactPhone, organization.contactEmail].filter(Boolean).join(' · ') %></span>
            <% } %>
            <% if (orgBlock && orgBlock.license) { %><span><%= orgBlock.license %></span><% } %>
          </div>
        </div>
        <div class="doc-title">
          <h1>INVOICE</h1>
          <p><%= invoice.invoiceNumber %></p>
        </div>
      </div>

      <div class="grid">
        <div class="bill">
          <p class="label">Bill to</p>
          <strong><%= client.name || 'Client' %></strong>
          <% if (client.address) { %><div class="sub"><%= client.address %></div><% } %>
          <% if (client.email) { %><div class="sub"><%= client.email %></div><% } %>
          <% if (client.phone) { %><div class="sub"><%= client.phone %></div><% } %>
        </div>
        <dl class="meta">
          <dt>Invoice #</dt><dd><%= invoice.invoiceNumber %></dd>
          <dt>Issue date</dt><dd><%= fdate(invoice.issuedAt || invoice.createdAt) %></dd>
          <dt>Due date</dt><dd><%= fdate(invoice.dueDate) %></dd>
          <% if (quoteNumber) { %><dt>Quote #</dt><dd><%= quoteNumber %></dd><% } %>
          <% if (typeof jobNumber !== 'undefined' && jobNumber) { %><dt>Job</dt><dd><%= jobNumber %></dd><% } %>
          <% if (typeof projectName !== 'undefined' && projectName) { %><dt>Project</dt><dd><%= projectName %></dd><% } %>
        </dl>
      </div>

      <table>
        <thead>
          <tr>
            <th>Description</th>
            <th class="r">Qty</th>
            <th class="r">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% lines.forEach(li => {
            const raw = String(li.description || '');
            const nl = raw.indexOf('\n');
            const dash = nl < 0 ? raw.search(/\s+—\s+/) : -1;
            let name = raw;
            let note = '';
            if (nl >= 0) { name = raw.slice(0, nl).trim(); note = raw.slice(nl + 1).trim(); }
            else if (dash >= 0) { name = raw.slice(0, dash).trim(); note = raw.slice(dash).replace(/^\s+—\s+/, '').trim(); }
            const qty = Number(li.quantity);
          %>
            <tr>
              <td>
                <span style="display:block;font-weight:700"><%= name || 'Item' %></span>
                <% if (note) { %><span style="display:block;margin-top:3px;font-size:12px;color:var(--muted);font-weight:500;white-space:pre-line"><%= note %></span><% } %>
              </td>
              <td class="r"><%= qty.toLocaleString('en-US', { maximumFractionDigits: 2 }) %></td>
              <td class="r"><strong><%= fmt(li.amount) %></strong></td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <div class="totals-row">
      <% if (st === 'paid') { %>
        <div class="stamp" aria-label="Paid"><b>PAID</b><% if (invoice.paidAt) { %><small><%= fdate(invoice.paidAt).toUpperCase() %></small><% } %></div>
      <% } else if (money.paid > 0 && st !== 'void') { %>
        <div class="stamp partial" aria-label="Partially paid"><b>PARTIALLY PAID</b><small><%= fmt(money.paid) %> RECEIVED</small></div>
      <% } else if (st === 'void') { %>
        <div class="stamp" aria-label="Void" style="border-color:#8a8074;color:#8a8074;box-shadow:inset 0 0 0 1px #fff, inset 0 0 0 2px #8a8074"><b>VOID</b></div>
      <% } else { %><span></span><% } %>

      <div class="totals">
        <div><span>Total Services</span><span><%= fmt(typeof servicesTotal !== 'undefined' ? servicesTotal : money.amount) %></span></div>
        <% payments.forEach(p => { %>
          <div><span>Payment <%= fdate(p.paidAt) %> · <%= p.method %></span><span>–<%= fmt(p.amount) %></span></div>
        <% }) %>
        <div class="grand"><span>Balance Due on this invoice</span><span><%= fmt(balance) %></span></div>
        <% const remAfter = summary && Number(summary.remainingAfterThisInvoice) > 0.004 ? Number(summary.remainingAfterThisInvoice) : 0; %>
        <% if (remAfter > 0) { %>
          <div class="after"><span>Balance Due after this invoice</span><span><%= fmt(remAfter) %></span></div>
        <% } %>
      </div>
      </div>

      <% if (instructions && balance > 0) { %>
        <div class="box"><p class="label">How to pay</p><p><%= instructions %></p></div>
      <% } %>
      <% if (invoice.notes) { %>
        <div class="box"><p class="label">Notes</p><p><%= invoice.notes %></p></div>
      <% } %>

      <div class="actions">
        <a class="btn primary" href="<%= pdfUrl %>" target="_blank" rel="noopener">Download PDF</a>
        <button class="btn" type="button" onclick="window.print()">Print</button>
      </div>
    </article>
    <p class="foot">
      <%= organization.name %> - Invoice - Thank You!
      <span class="made">Made with ObraMate</span>
    </p>
  </main>
</body>
</html>
