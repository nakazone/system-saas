<%- include('_auth-top') %>
<% if (invalid) { %>
  <div><h2>Link inválido ou vencido</h2><p class="lead">Links de acesso valem 48 horas e só funcionam uma vez. Peça um novo ao Master.</p></div>
  <a class="btn btn-dark btn-block" href="/master/entrar">Ir para o login</a>
<% } else { %>
  <div>
    <div class="step">ATIVAR ACESSO · <%= admin.role.toUpperCase() %></div>
    <h2>Crie sua senha</h2>
    <p class="lead"><%= admin.email %> · depois você configura o 2FA.</p>
  </div>
  <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
  <form method="post">
    <label class="field">Seu nome<input class="input" name="name" required maxlength="80" value="<%= admin.name %>" autocomplete="name"></label>
    <label class="field">Senha (mínimo 12 caracteres)<input class="input" type="password" name="password" minlength="12" required autocomplete="new-password" autofocus></label>
    <label class="field">Repita a senha<input class="input" type="password" name="confirm" minlength="12" required autocomplete="new-password"></label>
    <button class="btn btn-dark btn-block" type="submit">Continuar para o 2FA</button>
  </form>
<% } %>
<%- include('_auth-bottom') %>
