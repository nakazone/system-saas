<%- include('_top', { pageTitle: 'Contatos' }) %>
<div class="page-head"><div><h1>Contatos</h1><div class="page-sub">Dono e financeiro de cada empresa · histórico das conversas</div></div></div>
<div class="grid-2">
  <section class="card" style="overflow:hidden">
    <form method="get" action="/master/contatos" data-autosubmit role="search" style="padding:14px 16px;display:flex;flex-direction:column;gap:10px;border-bottom:1px solid var(--line-soft)">
      <input type="hidden" name="filtro" value="<%= filter %>">
      <label class="search" style="width:100%;background:var(--sunken)"><svg class="ico ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM20 20l-4-4"/></svg><input type="search" name="q" value="<%= q %>" placeholder="Nome, empresa, e-mail ou telefone" aria-label="Buscar contato"></label>
      <div class="chips" style="flex:none">
        <% filters.forEach(function (f) { %><a class="chip" href="?filtro=<%= f.key %><%= q ? '&q=' + encodeURIComponent(q) : '' %>" aria-current="<%= f.key === filter %>" style="height:32px;font-size:12px"><%= f.label %><span class="n"><%= f.count %></span></a><% }) %>
      </div>
    </form>
    <div class="ct-list">
      <% rows.forEach(function (c) { %>
        <a class="ct-row" href="?filtro=<%= filter %><%= q ? '&q=' + encodeURIComponent(q) : '' %>&c=<%= c.key %>" aria-current="<%= sel && sel.key === c.key %>">
          <span class="av round" style="width:38px;height:38px;background:<%= c.avatarBg %>"><%= c.initials %></span>
          <span style="flex:1;min-width:0;display:flex;flex-direction:column"><b style="font-size:14px"><%= c.name %></b><small class="muted" style="font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= c.roleLabel %> · <%= c.org.name %></small></span>
          <small style="font-size:12px;font-weight:700;color:<%= c.last ? 'var(--muted)' : 'var(--danger)' %>;white-space:nowrap"><%= c.last ? shortDate(c.last) : 'sem conversa' %></small>
        </a>
      <% }) %>
      <% if (!rows.length) { %><div class="empty" style="padding:24px 16px">Nenhum contato.</div><% } %>
    </div>
  </section>

  <% if (sel) { %>
  <section class="card card-pad" style="padding:22px;display:flex;flex-direction:column;gap:18px">
    <div style="display:flex;align-items:center;gap:16px">
      <span class="av av-lg round" style="background:<%= sel.avatarBg %>"><%= sel.initials %></span>
      <div style="flex:1;min-width:0;display:flex;flex-direction:column;gap:4px">
        <h2 style="margin:0;font-size:22px;font-weight:800"><%= sel.name %></h2>
        <span style="font-size:14px;color:var(--ink-2);font-weight:600"><%= sel.roleLabel %> · <a href="/master/clientes/<%= sel.orgId %>" data-ficha="<%= sel.orgId %>" style="color:var(--accent-ink);font-weight:800"><%= sel.org.name %></a></span>
      </div>
      <span class="pill tone-<%= sel.org.pill.tone %>"><%= sel.org.pill.label %></span>
    </div>
    <div class="quick">
      <a href="<%= sel.email ? 'mailto:' + sel.email : '#' %>" aria-disabled="<%= !sel.email %>"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v12H3zM3 7l9 6 9-6"/></svg>E-mail</a>
      <a href="<%= sel.phone ? 'tel:' + sel.phone.replace(/[^\d+]/g, '') : '#' %>" aria-disabled="<%= !sel.phone %>"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>Ligar</a>
      <a href="<%= sel.phone ? 'sms:' + sel.phone.replace(/[^\d+]/g, '') : '#' %>" aria-disabled="<%= !sel.phone %>"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.8 7L4 20l1.2-4.6A8 8 0 1 1 21 12z"/></svg>SMS</a>
      <a href="<%= sel.phone ? 'https://wa.me/' + (sel.phone.replace(/\D/g, '').length === 10 ? '1' : '') + sel.phone.replace(/\D/g, '') : '#' %>" target="_blank" rel="noopener" aria-disabled="<%= !sel.phone %>"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.8 7L4 20l1.2-4.6A8 8 0 1 1 21 12zM9 10c0 3 2 5 5 5"/></svg>WhatsApp</a>
    </div>
    <div class="kv">
      <div><span>E-mail</span><b><%= sel.email || '—' %></b></div>
      <div><span>Telefone</span><b><%= sel.phone || '—' %></b></div>
      <div><span>Plano</span><b><%= sel.org.planText %></b></div>
      <div><span>Vencimento</span><b class="<%= sel.org.overdue ? 'danger' : '' %>"><%= sel.org.due ? sel.org.chip.label + ' · ' + sel.org.dueLabel : '—' %></b></div>
    </div>
    <form data-action action="/master/contatos/<%= sel.orgId %>/registro" style="display:flex;flex-direction:column;gap:10px">
      <b style="font-size:14px">Registrar conversa</b>
      <input type="hidden" name="role" value="<%= sel.role %>"><input type="hidden" name="name" value="<%= sel.name %>">
      <div class="seg-pick">
        <% [['call','Ligação'],['email','E-mail'],['whatsapp','WhatsApp'],['meeting','Reunião']].forEach(function (k, i) { %><label><input type="radio" name="kind" value="<%= k[0] %>" <%= i === 0 ? 'checked' : '' %>><span><%= k[1] %></span></label><% }) %>
      </div>
      <div class="inline-form"><input class="input" name="summary" required maxlength="4000" placeholder="O que foi combinado?" aria-label="Resumo da conversa"><button class="btn btn-dark" type="submit">Salvar</button></div>
    </form>
    <div>
      <b style="font-size:14px">Histórico da empresa</b>
      <% selLog.forEach(function (l) { %>
        <div class="timeline-item"><span class="bullet b-ink"></span><span style="flex:1"><p><%= l.summary %></p><small><%= { call: 'Ligação', email: 'E-mail', whatsapp: 'WhatsApp', meeting: 'Reunião' }[l.kind] || l.kind %> com <%= l.contactName %> · <%= dateTimeLabel(l.createdAt) %> · <%= l.authorName %></small></span></div>
      <% }) %>
      <% if (!selLog.length) { %><div class="empty" style="padding:12px 0">Nenhuma conversa registrada ainda.</div><% } %>
    </div>
  </section>
  <% } else { %>
  <section class="card card-pad"><div class="empty" style="border:0">Escolha um contato.</div></section>
  <% } %>
</div>
<%- include('_bottom') %>
