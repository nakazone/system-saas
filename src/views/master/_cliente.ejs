<% const o = org; const id = o.id; %>
<div class="d-head">
  <div class="d-title">
    <span class="av av-lg" style="background:<%= o.avatarBg %>"><%= o.initials %></span>
    <div class="grow">
      <h2><%= o.name %></h2>
      <small><%= o.slug %><%= o.city ? ' · ' + o.city + (o.state ? ', ' + o.state : '') : '' %> · cliente desde <%= shortDate(o.createdAt) %></small>
      <div class="pills">
        <span class="pill tone-<%= o.pill.tone %>"><%= o.pill.label %></span>
        <% if (o.status !== 'canceled') { %><span class="pill tone-<%= o.chip.tone %>"><%= o.dueKind %>: <%= o.chip.label.toLowerCase() %><%= o.due ? ' · ' + o.dueLabel : '' %></span><% } %>
      </div>
    </div>
    <% if (partial) { %>
      <button class="close-btn" type="button" data-drawer-close aria-label="Fechar"><svg class="ico ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    <% } %>
  </div>
  <div class="d-actions">
    <% if (canBilling) { %>
      <button class="btn btn-dark" type="button" data-open="dlg-assinatura">Editar assinatura</button>
      <% if (o.status !== 'canceled') { %>
        <button class="btn" type="button" data-open="dlg-pagamento">Registrar pagamento</button>
        <button class="btn" type="button" data-open="dlg-prorrogar"><%= o.due ? 'Prorrogar' : 'Definir vencimento' %></button>
        <button class="btn" type="button" data-open="dlg-plano">Mudar plano</button>
      <% } %>
    <% } %>
    <% if (canSupport && o.status !== 'suspended' && o.status !== 'canceled') { %>
      <button class="btn btn-support" type="button" data-open="dlg-suporte"><svg class="ico ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>Entrar como suporte</button>
    <% } %>
    <% if (canSuspend) { %>
      <% if (o.status === 'suspended' || o.status === 'canceled') { %>
        <form data-action action="/master/clientes/<%= id %>/reativar" data-stepup="Reativar <%= o.name %>" style="flex:1;display:flex"><button class="btn" type="submit" style="width:100%">Reativar</button></form>
      <% } else { %>
        <form data-action action="/master/clientes/<%= id %>/suspender" data-stepup="Suspender <%= o.name %> · todos os usuários perdem o acesso na hora" data-confirm="Suspender <%= o.name %>? Os usuários saem do sistema agora." style="flex:1;display:flex"><button class="btn btn-danger" type="submit" style="width:100%">Suspender</button></form>
      <% } %>
    <% } %>
  </div>
</div>
<div class="d-body">
  <section class="d-sec">
    <h3>Assinatura <% if (o.stripeCustomerId) { %><span class="pill pill-sm tone-soft">Stripe</span><% } %><% if (canBilling) { %> <button class="btn btn-soft btn-sm" type="button" data-open="dlg-assinatura">Editar</button><% } %></h3>
    <div class="kv" style="box-shadow:none;padding:0">
      <div><span>Plano</span><b><%= o.planText %> · <%= o.cycleText.toLowerCase() %></b></div>
      <% if (showMoney) { %><div><span>Valor</span><b><%= o.status === 'trial' ? 'grátis no trial · depois ' + money(o.priceCents) : o.priceText %><%= o.planPriceCents != null ? ' (preço especial)' : '' %></b></div><% } %>
      <div><span><%= o.status === 'trial' ? 'Fim do trial' : 'Próximo vencimento' %></span><b class="<%= o.overdue ? 'danger' : '' %>"><%= o.due ? o.dueLabel + ' · ' + o.chip.label.toLowerCase() : 'sem data definida' %></b></div>
      <div><span>Usuários</span><b><%= o.users %></b></div>
      <% if (o.suspendedAt) { %><div><span>Suspensa em</span><b class="danger"><%= shortDate(o.suspendedAt) %></b></div><% } %>
      <% if (o.canceledAt) { %><div><span>Cancelada em</span><b><%= shortDate(o.canceledAt) %><%= o.cancelReason ? ' · ' + o.cancelReason : '' %></b></div><% } %>
      <% if (o.readOnlySince) { %><div><span>Só leitura desde</span><b class="danger"><%= shortDate(o.readOnlySince) %></b></div><% } %>
      <div><span>Cobrança</span><b><%= o.stripeSubscriptionId ? ('Cartão no Stripe' + (o.cancelAtPeriodEnd ? ' · cancela no fim do período' : '')) : (o.stripeCustomerId ? 'Cliente no Stripe, sem assinatura' : 'Manual (Zelle, cheque…)') %></b></div>
      <% if (o.dunningPausedUntil && o.dunningPausedUntil > new Date()) { %><div><span>Régua</span><b>pausada até <%= shortDate(o.dunningPausedUntil) %></b></div><% } %>
      <% if (billx.card) { %><div><span>Cartão</span><b class="<%= billx.cardWarn ? 'danger' : '' %>"><%= billx.card %><%= billx.cardWarn ? ' · vence antes da próxima cobrança' : '' %></b></div><% } %>
      <div><span>Cupom</span><b><%= billx.coupon ? billx.coupon.code + ' · ' + billx.coupon.text : 'nenhum' %></b></div>
      <% if (o.cancelAtPeriodEnd && o.cancelRequestedAt) { %><div><span>Cancelamento</span><b class="danger">pedido pela empresa em <%= shortDate(o.cancelRequestedAt) %><%= billx.cancelReason ? ' · ' + billx.cancelReason : '' %></b></div><% } %>
    </div>
    <% if (canBilling && o.status !== 'canceled') { %>
    <div class="row-actions" style="margin-top:10px">
      <% if (!o.stripeSubscriptionId || o.cancelAtPeriodEnd) { %>
        <form data-action action="/master/clientes/<%= id %>/link-pagamento" style="display:flex"><button class="btn btn-sm <%= o.status === 'read_only' || o.overdue ? 'btn-dark' : 'btn-soft' %>" type="submit" <%= stripeOn ? '' : 'disabled title="Stripe não configurado"' %>>Enviar link de pagamento</button></form>
      <% } %>
      <% if (o.stripeSubscriptionId && ['past_due', 'read_only', 'suspended'].indexOf(o.status) >= 0) { %>
        <form data-action action="/master/clientes/<%= id %>/cobrar" data-confirm="Tentar cobrar agora no cartão de <%= o.name %>?" style="display:flex"><button class="btn btn-sm btn-dark" type="submit">Cobrar agora no cartão</button></form>
      <% } %>
      <% if (billx.coupons.length || o.couponCode) { %><button class="btn btn-sm btn-soft" type="button" data-open="dlg-cupom"><%= o.couponCode ? 'Trocar cupom' : 'Aplicar cupom' %></button><% } %>
      <% if (o.couponCode) { %><form data-action action="/master/clientes/<%= id %>/cupom" data-confirm="Tirar o cupom <%= o.couponCode %> de <%= o.name %>? As próximas cobranças voltam ao preço cheio." style="display:flex"><input type="hidden" name="code" value=""><button class="btn btn-sm btn-soft" type="submit">Tirar cupom</button></form><% } %>
      <% if (o.stripeSubscriptionId && stripeOn) { %><form data-action action="/master/clientes/<%= id %>/cartao" style="display:flex"><button class="btn btn-sm btn-soft" type="submit" title="Ler de novo o cartão no Stripe">Atualizar cartão</button></form><% } %>
      <% if (o.dunningPausedUntil && o.dunningPausedUntil > new Date()) { %>
        <form data-action action="/master/clientes/<%= id %>/pausar-regua" style="display:flex"><input type="hidden" name="days" value="0"><button class="btn btn-sm btn-soft" type="submit">Retomar régua</button></form>
      <% } else if (o.status !== 'active' || o.overdue) { %>
        <form data-action action="/master/clientes/<%= id %>/pausar-regua" style="display:flex" data-confirm="Pausar avisos e bloqueios automáticos de <%= o.name %> por 14 dias?"><input type="hidden" name="days" value="14"><button class="btn btn-sm btn-soft" type="submit">Pausar régua 14 dias</button></form>
      <% } %>
      <% if (canSuspend && o.status === 'read_only') { %>
        <form data-action action="/master/clientes/<%= id %>/somente-leitura" data-stepup="Liberar edição para <%= o.name %> sem pagamento" style="display:flex"><input type="hidden" name="on" value="0"><button class="btn btn-sm btn-soft" type="submit">Tirar do só leitura</button></form>
      <% } else if (canSuspend && ['trial', 'active', 'past_due'].indexOf(o.status) >= 0) { %>
        <form data-action action="/master/clientes/<%= id %>/somente-leitura" data-stepup="Colocar <%= o.name %> em só leitura" data-confirm="<%= o.name %> vai ver tudo mas não poderá criar nem editar. Continuar?" style="display:flex"><input type="hidden" name="on" value="1"><button class="btn btn-sm btn-soft" type="submit">Colocar em só leitura</button></form>
      <% } %>
    </div>
    <% } %>
  </section>

  <% if (health) { %>
  <section class="d-sec">
    <h3>Saúde e onboarding</h3>
    <div class="hl-top">
      <div class="hl-score tone-<%= health.band %>"><b class="num"><%= health.score %></b><small><%= health.bandLabel %></small></div>
      <div class="hl-parts">
        <% health.parts.forEach(function (pt) { %>
          <div class="hl-part"><div class="hl-part-top"><span><%= pt.label %></span><b class="num"><%= pt.points %>/<%= pt.max %></b></div><div class="use-track"><i style="width:<%= Math.round(pt.points / pt.max * 100) %>%"></i></div><small><%= pt.note %></small></div>
        <% }) %>
      </div>
    </div>
    <div class="hl-meta muted">
      <span>Último uso: <b><%= health.lastActive ? shortDate(health.lastActive) : 'sem registro' %></b></span>
      <span>Usuários ativos em 30 dias: <b><%= health.activeUsers30 %></b></span>
    </div>
    <ol class="hl-steps">
      <% health.steps.forEach(function (st) { %>
        <li class="<%= st.done ? 'done' : '' %>"><span class="hl-check" aria-hidden="true"><%= st.done ? '✓' : '' %></span><span><%= st.label %></span><small><%= st.done ? (st.at ? shortDate(st.at) : 'feito') : 'falta' %></small></li>
      <% }) %>
    </ol>
  </section>
  <% } %>

  <section class="d-sec">
    <h3>Contatos <% if (canBilling) { %><button class="btn btn-soft btn-sm" type="button" data-open="dlg-faturamento"><%= o.billingContactEmail ? 'Editar financeiro' : '+ Financeiro' %></button><% } %></h3>
    <div class="d-line">
      <span class="grow" style="flex:1;min-width:0;display:flex;flex-direction:column">
        <b><%= o.ownerName %> <span class="muted" style="font-weight:600">· Dono</span></b>
        <small class="muted" style="font-weight:600"><%= o.ownerEmail || 'sem e-mail' %><%= o.ownerPhone ? ' · ' + o.ownerPhone : '' %></small>
      </span>
      <% if (o.ownerEmail) { %><a class="btn btn-soft btn-sm" href="mailto:<%= o.ownerEmail %>" aria-label="E-mail para <%= o.ownerName %>">E-mail</a><% } %>
      <% if (o.ownerPhone) { %><a class="btn btn-soft btn-sm" href="tel:<%= o.ownerPhone.replace(/[^\d+]/g, '') %>" aria-label="Ligar para <%= o.ownerName %>">Ligar</a><% } %>
    </div>
    <% if (o.billingContactName || o.billingContactEmail) { %>
    <div class="d-line">
      <span class="grow" style="flex:1;min-width:0;display:flex;flex-direction:column">
        <b><%= o.billingContactName || o.billingContactEmail %> <span class="muted" style="font-weight:600">· Financeiro</span></b>
        <small class="muted" style="font-weight:600"><%= o.billingContactEmail || '' %><%= o.billingContactPhone ? ' · ' + o.billingContactPhone : '' %></small>
      </span>
      <% if (o.billingContactEmail) { %><a class="btn btn-soft btn-sm" href="mailto:<%= o.billingContactEmail %>">E-mail</a><% } %>
      <% if (o.billingContactPhone) { %><a class="btn btn-soft btn-sm" href="tel:<%= o.billingContactPhone.replace(/[^\d+]/g, '') %>">Ligar</a><% } %>
    </div>
    <% } %>
    <% if (contactLog.length) { %>
      <div style="margin-top:6px">
        <% contactLog.slice(0, 2).forEach(function (l) { %>
          <div class="d-line" style="align-items:flex-start"><span class="bullet b-ink" style="margin-top:6px"></span><span style="flex:1"><%= l.summary %><br><small class="muted" style="font-weight:600"><%= { call: 'Ligação', email: 'E-mail', whatsapp: 'WhatsApp', meeting: 'Reunião' }[l.kind] || l.kind %> · <%= dateTimeLabel(l.createdAt) %> · <%= l.authorName %></small></span></div>
        <% }) %>
      </div>
    <% } %>
    <a class="btn btn-soft btn-sm" style="margin-top:8px" href="/master/contatos?c=<%= id %>:owner">Registrar conversa</a>
  </section>

  <section class="d-sec">
    <h3>Dados da empresa <% if (canBilling) { %><button class="btn btn-soft btn-sm" type="button" data-open="dlg-dados">Editar</button><% } %></h3>
    <div class="kv kv-compact">
      <div><span>Razão social</span><b><%= details.legalName || '—' %></b></div>
      <div><span>Telefone</span><b><%= details.contactPhone || '—' %></b></div>
      <div><span>E-mail</span><b><%= details.contactEmail || '—' %></b></div>
      <div><span>Endereço</span><b><%= [details.addressLine1, details.city, details.state, details.postalCode].filter(Boolean).join(', ') || '—' %></b></div>
      <div><span>Licença</span><b><%= details.licenseNumber ? details.licenseNumber + (details.licenseState ? ' · ' + details.licenseState : '') : '—' %></b></div>
      <div><span>Fuso e idioma</span><b><%= ((timezones.find(function (t) { return t.id === details.timezone; }) || {}).label || details.timezone) %> · <%= details.defaultLocale %></b></div>
    </div>
  </section>

  <section class="d-sec">
    <h3>Usuários (<%= users.length %>)
      <% if (canUsers && o.status !== 'canceled') { %><button class="btn btn-soft btn-sm" type="button" data-open="dlg-user-empresa">+ Usuário</button><% } %>
      <a class="btn btn-soft btn-sm" href="/master/usuarios?q=<%= encodeURIComponent(o.name) %>">Ver todos</a>
    </h3>
    <% users.slice(0, 6).forEach(function (u) { %>
      <a class="d-line" href="/master/usuarios/<%= u.id %>" data-usuario="<%= u.id %>">
        <span class="av round" style="width:30px;height:30px;font-size:11px;background:<%= u.avatarBg %>"><%= u.initials %></span>
        <span style="flex:1;min-width:0"><b><%= u.name %></b> <span class="muted" style="font-weight:600">· <%= u.roleName %></span></span>
        <% if (u.sessions) { %><span class="pill pill-sm tone-soft"><%= u.sessions %> sessão</span><% } %>
        <span class="pill pill-sm tone-<%= u.pill.tone %>"><%= u.pill.label %></span>
      </a>
    <% }) %>
    <% if (!users.length) { %><p class="muted" style="margin:6px 0">Nenhum usuário.</p><% } %>
  </section>

  <section class="d-sec">
    <h3>Recursos e uso <% if (canBilling) { %><button class="btn btn-soft btn-sm" type="button" data-open="dlg-excecao">+ Exceção</button><% } %><a class="btn btn-soft btn-sm" href="/master/recursos">Por plano</a></h3>
    <div class="use-bars">
      <% rec.limits.forEach(function (l) { %>
        <div class="use-bar tone-<%= l.tone %>">
          <div class="use-top"><span><%= l.name %></span><b class="num"><%= l.used %><%= l.limit != null ? ' / ' + l.limit : '' %></b></div>
          <% if (l.limit != null) { %><div class="use-track"><i style="width:<%= l.pct %>%"></i></div><% } else { %><small class="muted">sem limite no plano</small><% } %>
        </div>
      <% }) %>
    </div>
    <div class="feat-list">
      <% rec.features.forEach(function (f) { %>
        <div class="feat-row">
          <span class="feat-dot <%= f.on ? 'on' : '' %>" aria-hidden="true"></span>
          <span style="flex:1;min-width:0"><b><%= f.name %></b> <small class="muted"><%= f.on ? 'liberado' : 'sem acesso' %> · <%= f.source %></small>
            <% if (f.override) { %><small class="feat-ov"><%= f.override.reason %><%= f.override.by ? ' · ' + f.override.by : '' %></small><% } %>
          </span>
          <% if (f.override && canBilling) { %><form data-action action="/master/clientes/<%= id %>/recursos/excecao/<%= f.key %>/remover"><button class="btn btn-soft btn-sm" type="submit">Voltar ao plano</button></form><% } %>
        </div>
      <% }) %>
    </div>
  </section>

  <% if (canSupport && supportSessions.length) { %>
  <section class="d-sec">
    <h3>Sessões de suporte</h3>
    <% supportSessions.forEach(function (ss) { %>
      <div class="d-line sup-line">
        <span class="sup-dot <%= ss.live ? 'live' : '' %>" aria-hidden="true"></span>
        <span style="flex:1;min-width:0"><b><%= ss.admin %></b> <span class="muted" style="font-weight:600">como <%= ss.user %> · <%= ss.when %></span><small class="sup-meta"><%= ss.reason %> · <%= ss.status %></small></span>
        <% if (ss.live || ss.waiting) { %><form data-action action="/master/suporte-sessoes/<%= ss.id %>/encerrar"><button class="btn btn-soft btn-sm" type="submit">Encerrar</button></form><% } %>
      </div>
    <% }) %>
  </section>
  <% } %>

  <% if (showMoney) { %>
  <section class="d-sec">
    <h3>Pagamentos <a class="btn btn-soft btn-sm" href="/master/pagamentos">Todos</a></h3>
    <% payments.forEach(function (p) { %>
      <div class="d-line">
        <span style="width:62px" class="muted"><%= p.paidLabel %></span>
        <span style="flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= p.methodText %> · <%= p.periodText %></span>
        <b class="num"><%= p.amountText %></b>
        <span class="pill pill-sm tone-<%= p.pill.tone %>"><%= p.pill.label %></span>
      </div>
    <% }) %>
    <% if (!payments.length) { %><p class="muted" style="margin:6px 0">Nenhum pagamento registrado ainda.</p><% } %>
  </section>
  <% } %>

  <section class="d-sec">
    <h3>Termos e origem</h3>
    <div class="legal-rows">
      <% legal.forEach(function (l) { %>
        <div class="legal-row">
          <span class="legal-row__name"><%= l.document === 'terms' ? 'Termos de Serviço' : l.document === 'privacy' ? 'Privacidade' : 'DPA' %></span>
          <% if (l.upToDate) { %>
            <span class="pill pill-sm tone-ink">Aceito v<%= l.accepted %></span>
            <small class="muted"><%= dateTimeLabel(l.acceptedAt) %><%= l.by ? ' · ' + l.by : '' %><%= l.source === 'signup' ? ' · no cadastro' : l.source === 'in_app' ? ' · no app' : '' %><%= l.ip ? ' · IP ' + l.ip : '' %></small>
          <% } else if (l.accepted) { %>
            <span class="pill pill-sm tone-warn">Versão antiga v<%= l.accepted %></span>
            <small class="muted">Atual v<%= l.current %> · o admin vê o pedido ao abrir o app</small>
          <% } else { %>
            <span class="pill pill-sm tone-warn">Não aceito</span>
            <small class="muted">O admin vê o pedido ao abrir o app</small>
          <% } %>
        </div>
      <% }) %>
    </div>
    <p class="muted" style="margin:8px 0 0;font-size:13px">
      <% if (signupOrigin) { %>Cadastro pelo site em <%= dateTimeLabel(signupOrigin.createdAt) %><%= signupOrigin.ip ? ' · IP ' + signupOrigin.ip : '' %><%= signupOrigin.inviteId ? ' · por convite' : '' %> · e-mail confirmado <%= signupOrigin.verifiedAt ? dateTimeLabel(signupOrigin.verifiedAt) : '—' %>
      <% } else { %>Criada pelo Master ou antes do cadastro com confirmação de e-mail.<% } %>
    </p>
  </section>

  <section class="d-sec" id="dados">
    <h3>Dados e privacidade
      <span class="dp-h3-actions"><% if (canExport) { %><form data-action action="/master/clientes/<%= id %>/exportar" data-stepup="Exportar todos os dados de <%= o.name %>" style="display:inline"><button class="btn btn-soft btn-sm" type="submit" <%= dataRec.busy ? 'disabled' : '' %>><%= dataRec.busy ? 'Gerando…' : 'Exportar tudo' %></button></form><% } %>
      <% if (canDataDelete) { %><a class="btn btn-soft btn-sm" href="/master/privacidade/pessoa?empresa=<%= id %>">Excluir uma pessoa</a><% } %></span>
    </h3>
    <% dataRec.requests.forEach(function (r) { %>
      <div class="d-line"><span class="pill pill-sm tone-<%= r.days < 0 ? 'danger' : r.days <= 7 ? 'warn' : 'soft' %>"><%= r.kind %></span><span style="flex:1;min-width:0"><%= r.requester %></span><a class="muted" href="/master/privacidade"><%= r.days < 0 ? 'atrasado ' + (-r.days) + ' d' : 'vence em ' + r.days + ' d' %></a></div>
    <% }) %>
    <% dataRec.exports.forEach(function (e) { %>
      <div class="d-line">
        <span class="pill pill-sm tone-<%= e.pill.tone %>"><%= e.pill.label %></span>
        <span style="flex:1;min-width:0"><%= e.when %> · <%= e.size %><small class="muted" style="display:block"><%= e.expires || e.summary %></small></span>
        <% if (e.downloadable && canExport) { %><a class="btn btn-soft btn-sm" href="/master/privacidade/exportacoes/<%= e.id %>/baixar">Baixar</a><form data-action action="/master/privacidade/exportacoes/<%= e.id %>/link" data-stepup="Link de download para <%= o.name %>"><button class="btn btn-soft btn-sm" type="submit">Link</button></form><% } %>
      </div>
    <% }) %>
    <% if (!dataRec.exports.length && !dataRec.requests.length) { %><p class="muted" style="margin:6px 0;font-size:13px">Nenhuma exportação nem pedido de privacidade. “Exportar tudo” gera um ZIP com todas as tabelas e arquivos (fica 7 dias).</p><% } %>
    <% if (canDataDelete && o.status === 'canceled') { %>
      <div class="dp-del-box">
        <div><b>Excluir de vez</b><small class="muted"><%= dataRec.check.canDelete ? 'Liberado' + (dataRec.check.requestText ? ' · ' + dataRec.check.requestText : ' · cancelada há ' + dataRec.check.canceledDays + ' dias') : dataRec.check.blockers.join(' ') %></small></div>
        <button class="btn btn-danger btn-sm" type="button" data-open="dlg-excluir" <%= dataRec.check.canDelete ? '' : 'disabled' %>>Excluir empresa</button>
      </div>
    <% } %>
  </section>

  <section class="d-sec">
    <h3>Notas internas</h3>
    <% notes.forEach(function (n) { %><div class="note-card"><p><%= n.body %></p><small><%= n.authorName %> · <%= dateTimeLabel(n.createdAt) %></small></div><% }) %>
    <form class="inline-form" data-action action="/master/clientes/<%= id %>/nota">
      <input class="input" name="body" placeholder="Escreva uma nota para a equipe…" aria-label="Nova nota" required maxlength="4000">
      <button class="btn btn-dark" type="submit">Salvar</button>
    </form>
  </section>

  <section class="d-sec">
    <h3>Linha do tempo <a class="btn btn-soft btn-sm" href="/master/auditoria?empresa=<%= id %>">Auditoria</a></h3>
    <ol class="tl">
      <% timeline.items.forEach(function (it) { %>
        <li class="tl-<%= it.kind %>"><span class="tl-dot" aria-hidden="true"></span><div><b><%= it.title %></b><% if (it.sub) { %><small><%= it.sub %></small><% } %></div><time><%= it.when %></time></li>
      <% }) %>
    </ol>
    <% if (!timeline.items.length) { %><p class="muted" style="margin:6px 0">Nada registrado ainda.</p><% } %>
    <% if (timeline.truncated) { %><a class="btn btn-soft btn-sm" href="/master/clientes/<%= id %>?linha=tudo">Ver tudo (<%= timeline.total %>)</a><% } %>
  </section>

  <% if (canSuspend && o.status !== 'canceled') { %>
    <button class="btn btn-danger" type="button" data-open="dlg-cancelar" style="align-self:flex-start">Cancelar empresa</button>
  <% } %>
</div>

<% if (canBilling) { %>

<% if (canSupport) { %><%- include('_suporte-dlg', { sOrgId: id, sOrgName: o.name, sUsers: supportUsers, sUser: null, sTicketId: '', sReason: '' }) %><% } %>
<% if (canBilling) { %>
<dialog id="dlg-excecao" aria-labelledby="t-exc">
  <div class="modal">
    <div class="modal-head"><div><h2 id="t-exc">Exceção de recurso · <%= o.name %></h2><p>Liga ou desliga um módulo só para esta empresa, por cima do plano. Com data de fim, volta sozinho ao plano.</p></div>
      <button class="close-btn" type="button" data-close aria-label="Fechar"><svg class="ico ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
    <form data-action action="/master/clientes/<%= id %>/recursos/excecao">
      <label class="field">Módulo
        <select class="input" name="featureKey" required>
          <% rec.featureOptions.forEach(function (f) { %><option value="<%= f.key %>"><%= f.name %></option><% }) %>
        </select>
      </label>
      <div class="field">Para esta empresa
        <div class="seg-pick">
          <label><input type="radio" name="enabled" value="1" checked><span>Ligar</span></label>
          <label><input type="radio" name="enabled" value="0"><span>Desligar</span></label>
        </div>
      </div>
      <div class="form-row">
        <label class="field">Motivo<input class="input" name="reason" required minlength="3" maxlength="300" placeholder="Ex.: teste do Field Quote por 30 dias"></label>
        <label class="field">Até (opcional)<input class="input" type="date" name="endsAt" min="<%= todayYmd %>"></label>
      </div>
      <button class="btn btn-dark btn-block" type="submit">Salvar exceção</button>
    </form>
  </div>
</dialog>
<% } %>
<% if (canBilling) { %>
<dialog id="dlg-dados" aria-labelledby="t-dd">
  <div class="modal modal-wide">
    <div class="modal-head"><div><h2 id="t-dd">Dados da empresa · <%= o.name %></h2><p>O mesmo cadastro de Configurações da empresa. Fica na auditoria o que mudou.</p></div>
      <button class="close-btn" type="button" data-close aria-label="Fechar"><svg class="ico ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
    <form data-action action="/master/clientes/<%= id %>/dados">
      <div class="form-row">
        <label class="field">Nome<input class="input" name="name" required maxlength="120" value="<%= details.name || '' %>"></label>
        <label class="field">Razão social<input class="input" name="legalName" maxlength="160" value="<%= details.legalName || '' %>"></label>
      </div>
      <div class="form-row">
        <label class="field">E-mail da empresa<input class="input" type="email" name="contactEmail" maxlength="200" value="<%= details.contactEmail || '' %>"></label>
        <label class="field">Telefone<input class="input" name="contactPhone" maxlength="40" value="<%= details.contactPhone || '' %>"></label>
      </div>
      <label class="field">Endereço<input class="input" name="addressLine1" maxlength="200" value="<%= details.addressLine1 || '' %>"></label>
      <div class="form-row">
        <label class="field">Complemento<input class="input" name="addressLine2" maxlength="200" value="<%= details.addressLine2 || '' %>"></label>
        <label class="field">Cidade<input class="input" name="city" maxlength="100" value="<%= details.city || '' %>"></label>
      </div>
      <div class="form-row">
        <label class="field">Estado<input class="input" name="state" maxlength="40" value="<%= details.state || '' %>"></label>
        <label class="field">ZIP<input class="input" name="postalCode" maxlength="20" value="<%= details.postalCode || '' %>"></label>
      </div>
      <div class="form-row">
        <label class="field">Fuso
          <select class="input" name="timezone"><% timezones.forEach(function (t) { %><option value="<%= t.id %>" <%= t.id === details.timezone ? 'selected' : '' %>><%= t.label %></option><% }) %><% if (!timezones.some(function (t) { return t.id === details.timezone; })) { %><option value="" selected disabled>Hoje: <%= details.timezone %> (escolha um)</option><% } %></select>
        </label>
        <label class="field">Idioma
          <select class="input" name="defaultLocale"><% [['pt-BR','Português'],['en','English'],['es','Español']].forEach(function (l) { %><option value="<%= l[0] %>" <%= l[0] === details.defaultLocale ? 'selected' : '' %>><%= l[1] %></option><% }) %></select>
        </label>
      </div>
      <div class="form-row">
        <label class="field">Licença<input class="input" name="licenseNumber" maxlength="80" value="<%= details.licenseNumber || '' %>"></label>
        <label class="field">Estado da licença<input class="input" name="licenseState" maxlength="40" value="<%= details.licenseState || '' %>"></label>
      </div>
      <div class="form-row">
        <label class="field">Site<input class="input" name="website" maxlength="200" value="<%= details.website || '' %>"></label>
        <label class="field">Logo (URL https)<input class="input" name="logoUrl" maxlength="500" value="<%= details.logoUrl || '' %>"></label>
      </div>
      <button class="btn btn-dark btn-block" type="submit">Salvar dados</button>
    </form>
  </div>
</dialog>
<% } %>
<dialog id="dlg-assinatura" aria-labelledby="t-as">
  <div class="modal">
    <div class="modal-head"><div><h2 id="t-as">Editar assinatura</h2><p>Controle total: status, plano, ciclo, preço e datas.</p></div>
      <button class="close-btn" type="button" data-close aria-label="Fechar"><svg class="ico ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
    <form data-action action="/master/clientes/<%= id %>/assinatura" data-stepup="Editar assinatura de <%= o.name %>">
      <div class="field">Status
        <div class="seg-pick">
          <% [['trial','Trial'],['active','Ativa'],['past_due','Atrasada'],['read_only','Só leitura'],['suspended','Suspensa'],['canceled','Cancelada']].forEach(function (s) { %>
            <label><input type="radio" name="status" value="<%= s[0] %>" <%= o.status === s[0] ? 'checked' : '' %>><span><%= s[1] %></span></label>
          <% }) %>
        </div>
      </div>
      <div class="seg-pick cards">
        <% plans.forEach(function (p) { %><label><input type="radio" name="plan" value="<%= p.key %>" <%= o.plan === p.key ? 'checked' : '' %>><span><b><%= p.label %></b><small><%= p.monthly %>/mês · <%= p.annual %>/ano</small></span></label><% }) %>
      </div>
      <div class="field">Ciclo
        <div class="seg-pick">
          <label><input type="radio" name="cycle" value="monthly" <%= o.billingCycle !== 'annual' ? 'checked' : '' %>><span>Mensal</span></label>
          <label><input type="radio" name="cycle" value="annual" <%= o.billingCycle === 'annual' ? 'checked' : '' %>><span>Anual</span></label>
        </div>
      </div>
      <label class="field">Preço especial por ciclo (USD)<input class="input num" name="price" type="number" step="0.01" min="0" value="<%= o.planPriceCents != null ? (o.planPriceCents / 100).toFixed(2) : '' %>" placeholder="preço de lista"></label>
      <div class="form-row">
        <label class="field">Fim do trial<input class="input" name="trialEndsAt" type="date" value="<%= trialYmd || '' %>"></label>
        <label class="field">Vencimento / renovação<input class="input" name="currentPeriodEnd" type="date" value="<%= periodYmd || '' %>"></label>
      </div>
      <div class="note-box">Suspensa ou cancelada: os usuários saem na hora. Os dados ficam guardados.</div>
      <button class="btn btn-dark btn-block" type="submit">Salvar assinatura</button>
    </form>
  </div>
</dialog>

<dialog id="dlg-prorrogar" aria-labelledby="t-pr">
  <div class="modal">
    <div class="modal-head"><div><h2 id="t-pr"><%= o.due ? 'Prorrogar' : 'Definir vencimento' %></h2><p><%= o.status === 'trial' ? 'Fim do trial' : 'Vencimento' %> atual: <%= o.due ? o.dueLabel + (o.overdue ? ' (já passou)' : '') : 'nenhum' %></p></div>
      <button class="close-btn" type="button" data-close aria-label="Fechar"><svg class="ico ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
    <form data-action action="/master/clientes/<%= id %>/prorrogar">
      <fieldset class="seg-pick big" style="border:0;padding:0;margin:0"><legend class="sr-only">Dias</legend>
        <% [3, 7, 15, 30].forEach(function (d) { %><label><input type="radio" name="days" value="<%= d %>" <%= d === 7 ? 'checked' : '' %>><span>+<%= d %> dias</span></label><% }) %>
      </fieldset>
      <label class="field">Ou escolha a data<input class="input" type="date" name="date" min="<%= todayYmd %>"></label>
      <div class="field">Motivo
        <div class="seg-pick">
          <% ['Pedido do cliente', 'Negociação', 'Problema técnico nosso', 'Cortesia', 'Ajuste de cadastro'].forEach(function (r, i) { %><label><input type="radio" name="reason" value="<%= r %>" <%= i === 0 ? 'checked' : '' %>><span><%= r %></span></label><% }) %>
        </div>
      </div>
      <div class="preview-line" data-due-preview data-base="<%= o.due && o.days > 0 ? dueYmd : todayYmd %>"><span>Novo vencimento</span><b>—</b></div>
      <% if (o.ownerEmail) { %><label class="check"><input type="checkbox" name="notify" value="1" checked> Avisar <%= o.ownerName %> por e-mail</label><% } %>
      <button class="btn btn-primary btn-block" type="submit">Salvar vencimento</button>
    </form>
  </div>
</dialog>

<dialog id="dlg-pagamento" aria-labelledby="t-pg">
  <div class="modal">
    <div class="modal-head"><div><h2 id="t-pg">Registrar pagamento</h2><p>Use quando o cliente pagou fora do sistema. O vencimento anda um ciclo.</p></div>
      <button class="close-btn" type="button" data-close aria-label="Fechar"><svg class="ico ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
    <form data-action action="/master/clientes/<%= id %>/pagamento">
      <div class="form-row">
        <label class="field">Valor (USD)<input class="input num" name="amount" type="number" step="0.01" min="0.01" required value="<%= priceDollars %>"></label>
        <label class="field">Data<input class="input" name="paidAt" type="date" required value="<%= todayYmd %>" max="<%= todayYmd %>"></label>
      </div>
      <div class="field">Como pagou
        <div class="seg-pick"><% methods.forEach(function (m, i) { %><label><input type="radio" name="method" value="<%= m[0] %>" <%= i === 0 ? 'checked' : '' %>><span><%= m[1] %></span></label><% }) %></div>
      </div>
      <label class="field">Observação (opcional)<input class="input" name="note" maxlength="300" placeholder="Ex.: Zelle confirmado pelo banco"></label>
      <div class="preview-line"><span>Período pago</span><b><%= nextPeriodLabel %></b></div>
      <% if (o.status === 'suspended') { %><div class="note-box note-warn">A empresa volta a ter acesso assim que o pagamento for registrado.</div><% } %>
      <button class="btn btn-dark btn-block" type="submit">Registrar pagamento</button>
    </form>
  </div>
</dialog>

<dialog id="dlg-plano" aria-labelledby="t-pl">
  <div class="modal">
    <div class="modal-head"><div><h2 id="t-pl">Mudar plano</h2><p>Hoje: <%= o.planText %> · <%= o.cycleText.toLowerCase() %><%= showMoney && o.status !== 'trial' ? ' · ' + o.priceText : '' %></p></div>
      <button class="close-btn" type="button" data-close aria-label="Fechar"><svg class="ico ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
    <form data-action data-plan-form data-prices='<%- JSON.stringify(Object.fromEntries(plans.map(function (p) { return [p.key, { monthly: p.monthly + "/mês", annual: p.annual + "/ano" }]; }))).replace(/'/g, "&#39;") %>' action="/master/clientes/<%= id %>/plano">
      <div class="seg-pick cards">
        <% plans.forEach(function (p) { %><label><input type="radio" name="plan" value="<%= p.key %>" <%= o.plan === p.key ? 'checked' : '' %>><span><b><%= p.label %></b><small><%= p.monthly %>/mês · <%= p.annual %>/ano</small></span></label><% }) %>
      </div>
      <div class="field">Ciclo
        <div class="seg-pick">
          <label><input type="radio" name="cycle" value="monthly" <%= o.billingCycle !== 'annual' ? 'checked' : '' %>><span>Mensal</span></label>
          <label><input type="radio" name="cycle" value="annual" <%= o.billingCycle === 'annual' ? 'checked' : '' %>><span>Anual (2 meses grátis)</span></label>
        </div>
      </div>
      <label class="field">Preço especial por ciclo (opcional, USD)<input class="input num" name="price" type="number" step="0.01" min="0" value="<%= o.planPriceCents != null ? (o.planPriceCents / 100).toFixed(2) : '' %>"></label>
      <button class="btn btn-primary btn-block" type="submit">Aplicar</button>
    </form>
  </div>
</dialog>

<dialog id="dlg-faturamento" aria-labelledby="t-ft">
  <div class="modal">
    <div class="modal-head"><div><h2 id="t-ft">Contato do financeiro</h2><p>Recebe os lembretes de vencimento no lugar do dono.</p></div>
      <button class="close-btn" type="button" data-close aria-label="Fechar"><svg class="ico ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
    <form data-action action="/master/clientes/<%= id %>/faturamento">
      <label class="field">Nome<input class="input" name="name" maxlength="120" value="<%= o.billingContactName || '' %>"></label>
      <div class="form-row">
        <label class="field">E-mail<input class="input" name="email" type="email" value="<%= o.billingContactEmail || '' %>"></label>
        <label class="field">Telefone<input class="input" name="phone" type="tel" value="<%= o.billingContactPhone || '' %>"></label>
      </div>
      <button class="btn btn-dark btn-block" type="submit">Salvar</button>
    </form>
  </div>
</dialog>
<% } %>

<% if (canSuspend && o.status !== 'canceled') { %>
<dialog id="dlg-cancelar" aria-labelledby="t-cc">
  <div class="modal">
    <div class="modal-head"><div><h2 id="t-cc">Cancelar <%= o.name %></h2><p>Os usuários perdem o acesso na hora. Os dados ficam guardados e dá para reativar depois.</p></div>
      <button class="close-btn" type="button" data-close aria-label="Fechar"><svg class="ico ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
    <form data-action action="/master/clientes/<%= id %>/cancelar" data-stepup="Cancelar <%= o.name %>">
      <label class="field">Motivo
        <select class="input" name="reasonKey" required>
          <% billx.reasons.forEach(function (r) { %><option value="<%= r.key %>"><%= r.label %></option><% }) %>
        </select>
      </label>
      <label class="field">Detalhe (opcional)<input class="input" name="reason" maxlength="200" placeholder="Ex.: achou caro para 2 usuários"></label>
      <label class="field">Digite <%= o.slug %> para confirmar<input class="input" name="confirm" required autocomplete="off"></label>
      <button class="btn btn-danger btn-block" type="submit">Cancelar empresa</button>
    </form>
  </div>
</dialog>
<% } %>

<% if (canUsers && o.status !== 'canceled') { %>
<dialog id="dlg-user-empresa" aria-labelledby="t-ue">
  <div class="modal">
    <div class="modal-head"><div><h2 id="t-ue">Novo usuário · <%= o.name %></h2><p>Cadastro manual. A senha temporária aparece uma vez.</p></div>
      <button class="close-btn" type="button" data-close aria-label="Fechar"><svg class="ico ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
    <form data-action action="/master/usuarios" data-stepup="Cadastrar usuário em <%= o.name %>">
      <input type="hidden" name="organizationId" value="<%= id %>">
      <div class="form-row">
        <label class="field">Nome<input class="input" name="name" required maxlength="120" autofocus></label>
        <label class="field">E-mail<input class="input" name="email" type="email" required maxlength="200"></label>
      </div>
      <label class="field">Papel
        <select class="input" name="roleId" required>
          <% (roles || []).forEach(function (r) { %><option value="<%= r.id %>" <%= r.key === 'admin' ? 'selected' : '' %>><%= r.name %></option><% }) %>
        </select>
      </label>
      <label class="check-line" style="display:flex;gap:8px;align-items:flex-start;font-size:13px;font-weight:600;margin:4px 0 12px"><input type="checkbox" name="ignoreLimit" value="1" style="margin-top:2px"> Cadastrar mesmo passando do limite de usuários do plano</label>
      <button class="btn btn-dark btn-block" type="submit">Cadastrar usuário</button>
    </form>
  </div>
</dialog>
<% } %>

<% if (canDataDelete && o.status === 'canceled' && dataRec.check.canDelete) { %>
<dialog id="dlg-excluir" aria-labelledby="t-del">
  <div class="modal">
    <div class="modal-head"><div><h2 id="t-del">Excluir <%= o.name %> de vez</h2><p>Apaga todos os dados e arquivos da empresa. Não dá para desfazer. Fica só o comprovante e a auditoria.</p></div>
      <button class="close-btn" type="button" data-close aria-label="Fechar"><svg class="ico ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
    <ul class="dp-checks">
      <li class="ok">Cancelada<%= dataRec.check.canceledDays != null ? ' há ' + dataRec.check.canceledDays + ' dia(s)' : '' %><%= dataRec.check.requestText ? ' · ' + dataRec.check.requestText : '' %></li>
      <li class="<%= dataRec.check.exportText ? 'ok' : 'warn' %>"><%= dataRec.check.exportText || 'Sem exportação nos últimos 90 dias' %></li>
    </ul>
    <form data-action action="/master/clientes/<%= id %>/excluir" data-stepup="Excluir <%= o.name %> de vez">
      <% if (!dataRec.check.exportText) { %>
        <label class="field">Por que não vai exportar antes?<input class="input" name="skipExport" required maxlength="300" placeholder="Ex.: a empresa recusou a cópia por e-mail em 10/10"></label>
      <% } %>
      <label class="field">Motivo<input class="input" name="reason" required maxlength="300" placeholder="Ex.: pedido formal de exclusão · cancelada há 90+ dias"></label>
      <label class="field">Digite <%= o.slug %> para confirmar<input class="input" name="confirm" required autocomplete="off"></label>
      <button class="btn btn-danger btn-block" type="submit">Excluir tudo de vez</button>
    </form>
  </div>
</dialog>
<% } %>

<% if (canBilling && (billx.coupons.length || o.couponCode)) { %>
<dialog id="dlg-cupom" aria-labelledby="t-cup">
  <div class="modal">
    <div class="modal-head"><div><h2 id="t-cup">Cupom para <%= o.name %></h2><p><%= o.stripeSubscriptionId ? 'Aplicado na assinatura do Stripe a partir da próxima cobrança.' : 'Sem assinatura no Stripe: fica anotado na ficha e vale quando a empresa assinar pelo link.' %></p></div>
      <button class="close-btn" type="button" data-close aria-label="Fechar"><svg class="ico ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
    <form data-action action="/master/clientes/<%= id %>/cupom">
      <div class="seg-pick cards">
        <% billx.coupons.forEach(function (c, i) { %><label><input type="radio" name="code" value="<%= c.code %>" <%= (o.couponCode ? c.code === o.couponCode : i === 0) ? 'checked' : '' %>><span><b><%= c.code %> · <%= c.name %></b><small><%= c.text %><%= c.plansText ? ' · ' + c.plansText : '' %></small></span></label><% }) %>
      </div>
      <% if (!billx.coupons.length) { %><p class="muted">Nenhum cupom ativo que valha para o plano <%= o.planText %>. Crie em Cupons.</p><% } %>
      <button class="btn btn-dark btn-block" type="submit" <%= billx.coupons.length ? '' : 'disabled' %>>Aplicar cupom</button>
    </form>
  </div>
</dialog>
<% } %>
