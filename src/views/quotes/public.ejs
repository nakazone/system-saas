<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
  <title><%= (quote.quoteNumber || ('#' + quote.number)) %> — <%= organization.name %></title>
  <link rel="icon" type="image/png" href="/assets/favicon-192.png" />
  <style>
    :root {
      --qp-primary: <%= organization.primaryColor || '#211d1a' %>;
      --qp-primary-muted: #3a332e;
      --qp-secondary: <%= organization.accentColor || '#e8792c' %>;
      --qp-secondary-dark: #a85428;
      --qp-panel-bg: #f7f4ee;
      --qp-muted: #6b645c;
      --qp-rule: #e2d9cc;
      --qp-page-w: 612px;
    }
    * { box-sizing: border-box; }
    body.qp-page {
      margin: 0;
      min-height: 100vh;
      background: #e8eaef;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      color: var(--qp-primary);
      -webkit-font-smoothing: antialiased;
    }
    .qp-wrap { padding: 24px 12px 110px; }
    .qp-doc {
      max-width: var(--qp-page-w);
      margin: 0 auto;
      background: #fff;
      box-shadow: 0 4px 28px rgba(26, 32, 54, 0.14);
      position: relative;
    }
    .qp-accent-bar { height: 5px; background: var(--qp-secondary); width: 100%; }
    .qp-doc-inner { padding: 14px 40px 36px; }
    .qp-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 18px;
    }
    .qp-header__brand { display: flex; align-items: flex-start; gap: 16px; min-width: 0; flex: 1; }
    .qp-logo { width: 68px; height: auto; flex-shrink: 0; display: block; }
    .qp-company__name { margin: 0; font-size: 17px; font-weight: 700; line-height: 1.2; }
    .qp-company__tagline, .qp-company__contact {
      margin: 4px 0 0; font-size: 8.5px; line-height: 1.4; color: var(--qp-primary-muted);
    }
    .qp-quote-panel {
      flex-shrink: 0; width: 180px; background: var(--qp-panel-bg);
      border-left: 3px solid var(--qp-secondary-dark); padding: 12px 14px 10px 12px;
      font-size: 8px; color: var(--qp-muted); line-height: 1.45;
    }
    .qp-quote-panel__label { margin: 0 0 2px; font-size: 11px; font-weight: 700; color: var(--qp-primary); }
    .qp-quote-panel__number { margin: 0 0 8px; font-size: 10px; font-weight: 700; color: var(--qp-secondary-dark); }
    .qp-quote-panel p { margin: 0 0 4px; }
    .qp-summary {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px;
      background: var(--qp-panel-bg); padding: 10px 12px; margin-bottom: 16px; border-radius: 4px;
    }
    .qp-summary__item label {
      display: block; font-size: 7.5px; font-weight: 700; letter-spacing: 0.04em;
      text-transform: uppercase; color: var(--qp-secondary-dark); margin-bottom: 2px;
    }
    .qp-summary__item strong { font-size: 12px; color: var(--qp-primary); }
    .qp-cols { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; margin-bottom: 18px; }
    .qp-col__label {
      margin: 0 0 4px; font-size: 8px; font-weight: 700; color: var(--qp-secondary-dark);
      text-transform: uppercase; letter-spacing: 0.03em;
    }
    .qp-col__name { margin: 0 0 3px; font-size: 11px; font-weight: 700; }
    .qp-col__meta { margin: 0; font-size: 8.5px; color: var(--qp-muted); line-height: 1.4; }
    .qp-msg {
      margin: 0 0 16px; padding: 8px 0; font-size: 10px; font-style: italic;
      color: var(--qp-primary-muted); border-top: 1px solid var(--qp-rule); border-bottom: 1px solid var(--qp-rule);
    }
    .qp-section {
      margin: 0 0 14px;
      padding-bottom: 4px;
      break-inside: auto;
    }
    .qp-section + .qp-section {
      margin-top: 6px;
      padding-top: 10px;
      border-top: 1px solid var(--qp-rule);
    }
    .qp-section-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin: 0 0 6px;
      padding-bottom: 5px;
      border-bottom: 1.5px solid var(--qp-secondary);
      break-after: avoid-page;
      page-break-after: avoid;
    }
    .qp-section-title {
      margin: 0;
      font-size: 9.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--qp-secondary-dark);
    }
    .qp-section-total {
      margin: 0;
      font-size: 8px;
      font-weight: 600;
      color: var(--qp-muted);
      white-space: nowrap;
    }
    .qp-page-break {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 18px 0 14px;
      font-size: 8px;
      font-style: italic;
      color: var(--qp-muted);
      text-transform: none;
      letter-spacing: 0;
    }
    .qp-page-break::before,
    .qp-page-break::after {
      content: "";
      flex: 1;
      height: 1px;
      background: var(--qp-rule);
    }
    .qp-addons { display: flex; flex-direction: column; gap: 8px; }
    .qp-addon {
      display: grid;
      grid-template-columns: 22px minmax(0, 1fr) auto auto auto;
      gap: 8px;
      align-items: center;
      padding: 10px 12px;
      border: 1px dashed var(--qp-rule);
      border-radius: 4px;
      background: #fff;
    }
    .qp-addon.is-dim .qp-addon__amt,
    .qp-addon.is-dim .qp-addon__meta { opacity: 0.45; }
    .qp-addon__check { display: flex; align-items: center; margin: 0; }
    .qp-addon__box {
      width: 12px; height: 12px; border: 1px solid var(--qp-muted); border-radius: 2px; display: inline-block;
    }
    .qp-addon__body { min-width: 0; }
    .qp-addon__meta, .qp-addon__amt {
      font-size: 8.5px; color: var(--qp-primary); text-align: right; white-space: nowrap;
    }
    .qp-addon__amt { font-weight: 700; min-width: 56px; }
    .qp-addons-empty {
      margin: 0; padding: 12px; border: 1px dashed var(--qp-rule); border-radius: 4px;
      font-size: 8.5px; color: var(--qp-muted);
    }
    .qp-inclex {
      display: block;
      margin: 16px 0 8px;
    }
    .qp-inclex__list {
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: 8.5px;
      line-height: 1.45;
      color: var(--qp-primary);
    }
    .qp-inclex__list li {
      position: relative;
      padding-left: 14px;
      margin: 0 0 6px;
    }
    .qp-inclex__list--in li::before {
      content: "";
      position: absolute;
      left: 0; top: 3px;
      width: 7px; height: 4px;
      border-left: 1.5px solid #15803d;
      border-bottom: 1.5px solid #15803d;
      transform: rotate(-45deg);
    }
    .qp-inclex__list--out li::before {
      content: "";
      position: absolute;
      left: 0; top: 6px;
      width: 9px; height: 0;
      border-top: 1.5px solid #dc2626;
    }
    .qp-terms-list {
      margin: 0 0 12px;
      padding: 0 0 0 18px;
      font-size: 8.5px;
      line-height: 1.45;
      color: var(--qp-muted);
      columns: 2;
      column-gap: 18px;
    }
    .qp-terms-list li { margin: 0 0 8px; break-inside: avoid; }
    .qp-sign-cta {
      margin: 16px 0 8px;
      padding: 14px;
      border: 1px solid var(--qp-rule);
      border-radius: 8px;
      background: var(--qp-panel-bg);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    .qp-sign-cta__text { margin: 0; font-size: 12px; color: var(--qp-primary-muted); flex: 1; min-width: 180px; }
    body.qp-sign-open { overflow: hidden; }
    @media (max-width: 640px) {
      .qp-inclex { display: block; }
      .qp-addon { grid-template-columns: 22px minmax(0, 1fr); }
      .qp-addon__meta, .qp-addon__amt { justify-self: start; }
      .qp-terms-list { columns: 1; }
    }
    .qp-table { width: 100%; border-collapse: collapse; font-size: 9px; }
    .qp-table thead { break-after: avoid-page; page-break-after: avoid; }
    .qp-table th {
      text-align: left; padding: 5px 4px; border-bottom: 1.5px solid var(--qp-primary);
      font-size: 8px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--qp-muted);
    }
    .qp-table td { padding: 8px 4px; border-bottom: 1px solid var(--qp-rule); vertical-align: top; }
    .qp-table tbody tr { break-inside: avoid; page-break-inside: avoid; }
    .qp-table .qp-num { text-align: right; white-space: nowrap; }
    .qp-line__title { display: block; font-weight: 700; font-size: 9.5px; }
    .qp-line__body, .qp-line__detail { display: block; margin-top: 2px; color: var(--qp-muted); font-size: 8px; white-space: pre-wrap; }
    .qp-totals-wrap { margin-top: 16px; display: flex; flex-direction: column; align-items: flex-end; }
    .qp-totals { width: 220px; border-collapse: collapse; font-size: 9px; }
    .qp-totals td { padding: 3px 0; }
    .qp-totals td:last-child { text-align: right; font-variant-numeric: tabular-nums; }
    .qp-totals-label {
      width: 220px; margin: 8px 0 4px; font-size: 8px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.04em; color: var(--qp-muted);
    }
    .qp-grand-total {
      width: 220px; display: flex; justify-content: space-between; align-items: center;
      background: var(--qp-primary); color: #fff; padding: 10px 12px;
      border-left: 4px solid var(--qp-secondary);
    }
    .qp-grand-total__label { font-size: 9px; font-weight: 700; letter-spacing: 0.06em; }
    .qp-grand-total__value { font-size: 16px; font-weight: 700; }
    .qp-block-title {
      margin: 18px 0 6px; font-size: 10px; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.04em; color: var(--qp-secondary-dark);
    }
    .qp-block-text { margin: 0; font-size: 9px; line-height: 1.5; color: var(--qp-primary-muted); white-space: pre-wrap; }
    .qp-options { margin: 12px 0; padding: 10px 12px; border: 1px dashed var(--qp-rule); border-radius: 6px; }
    .qp-options label { display: block; font-size: 10px; margin: 4px 0; cursor: pointer; }
    .qp-signatures {
      display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 22px;
      padding-top: 14px; border-top: 1px solid var(--qp-rule);
    }
    .qp-signatures--single { grid-template-columns: 1fr; max-width: 280px; }
    .qp-signatures h3 {
      margin: 0 0 6px; font-size: 8px; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.04em; color: var(--qp-secondary-dark);
    }
    .qp-signatures__box {
      min-height: 72px; border: 1px solid var(--qp-rule); border-radius: 6px;
      display: flex; align-items: center; justify-content: center; padding: 8px; background: #fff;
    }
    .qp-signatures__box img { max-width: 100%; max-height: 64px; object-fit: contain; }
    .qp-signatures__name { margin: 8px 0 0; font-size: 12px; font-weight: 700; }
    .qp-signatures__title, .qp-signatures__date { margin: 2px 0 0; font-size: 11px; color: var(--qp-muted); }
    .qp-alert { max-width: var(--qp-page-w); margin: 0 auto 14px; padding: 10px 14px; border-radius: 8px; font-size: 13px; }
    .qp-alert-ok { background: #dcfce7; color: #166534; }
    .qp-alert-error { background: #fee2e2; color: #991b1b; }
    .qp-actions {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
      display: flex; justify-content: center; gap: 10px; flex-wrap: wrap;
      padding: 14px 16px calc(14px + env(safe-area-inset-bottom, 0px));
      background: rgba(255,255,255,0.96); border-top: 1px solid var(--qp-rule);
      box-shadow: 0 -8px 24px rgba(33,29,26,0.08);
    }
    .qp-actions[hidden] { display: none !important; }
    .qp-btn {
      display: inline-flex; align-items: center; justify-content: center;
      min-height: 44px; padding: 0 18px; border-radius: 10px; font: inherit;
      font-size: 14px; font-weight: 700; text-decoration: none; cursor: pointer; border: 1px solid transparent;
    }
    .qp-btn--primary { background: var(--qp-secondary); color: #fff; }
    .qp-btn--primary:hover { filter: brightness(0.96); }
    .qp-btn--outline { background: #fff; color: var(--qp-primary); border-color: var(--qp-rule); }
    .qp-btn--ghost { background: transparent; color: var(--qp-muted); border-color: transparent; }
    .qp-approved {
      max-width: var(--qp-page-w); margin: 16px auto 0; text-align: center;
      font-size: 14px; font-weight: 600; color: #166534;
    }
    .qp-sign-modal {
      position: fixed; inset: 0; z-index: 1000; align-items: center; justify-content: center;
    }
    .qp-sign-modal[hidden]:not(.is-open) { display: none !important; }
    .qp-sign-modal.is-open { display: flex !important; }
    .qp-sign-modal__backdrop { position: absolute; inset: 0; background: rgba(26,32,54,0.45); }
    .qp-sign-modal__panel {
      position: relative; z-index: 1; width: min(560px, calc(100vw - 24px));
      background: #fff; border-radius: 12px; padding: 22px 24px 20px;
      box-shadow: 0 16px 48px rgba(26,32,54,0.2); max-height: 92vh; overflow: auto;
    }
    .qp-sign-modal__title { margin: 0 0 6px; font-size: 18px; }
    .qp-sign-modal__sub { margin: 0 0 16px; font-size: 13px; color: var(--qp-muted); }
    .qp-sign-field { display: block; margin: 0 0 6px; font-size: 12px; font-weight: 600; color: var(--qp-primary-muted); }
    .qp-sign-input {
      width: 100%; margin-bottom: 14px; padding: 10px 12px; border: 1px solid var(--qp-rule);
      border-radius: 8px; font-size: 14px;
    }
    .qp-sign-canvas-wrap {
      border: 1px solid var(--qp-rule); border-radius: 8px; background: #fff; margin-bottom: 14px; overflow: hidden;
    }
    .qp-sign-canvas-wrap canvas { display: block; width: 100%; height: 140px; touch-action: none; }
    .qp-sign-modal__actions { display: flex; gap: 8px; justify-content: flex-end; flex-wrap: wrap; }
    .qp-changes { max-width: var(--qp-page-w); margin: 18px auto 0; }
    .qp-changes details {
      background: #fff; border-radius: 10px; padding: 12px 14px; border: 1px solid var(--qp-rule);
    }
    .qp-changes summary { cursor: pointer; font-weight: 700; font-size: 13px; }
    .qp-changes textarea {
      width: 100%; margin-top: 10px; min-height: 80px; padding: 10px; border: 1px solid var(--qp-rule);
      border-radius: 8px; font: inherit; font-size: 13px;
    }
    @media (max-width: 640px) {
      .qp-doc-inner { padding: 12px 18px 28px; }
      .qp-header, .qp-cols, .qp-summary { grid-template-columns: 1fr; display: grid; }
      .qp-header { display: grid; }
      .qp-quote-panel { width: auto; }
      .qp-signatures { grid-template-columns: 1fr; }
    }
    @media print {
      body.qp-page { background: #fff; }
      .qp-wrap { padding: 0; }
      .qp-doc { box-shadow: none; max-width: none; }
      .qp-actions, .qp-changes, .no-print { display: none !important; }
    }
  </style>
  <link rel="stylesheet" href="/om-stable-viewport.css?v=20261007-stable1" id="om-stable-viewport-css" />
</head>
<body class="qp-page">
  <div class="qp-wrap">
    <% if (typeof success !== 'undefined' && success === 'approved') { %>
      <div class="qp-alert qp-alert-ok">Thank you — this quote is approved.</div>
    <% } %>
    <% if (typeof success !== 'undefined' && success === 'changes') { %>
      <div class="qp-alert qp-alert-ok">Your change request was sent.</div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="qp-alert qp-alert-error"><%= error === 'invalid' ? 'Please complete all approval fields.' : (error === 'signature' ? 'Please add your signature.' : error) %></div>
    <% } %>

    <%
      const money = (n) => '$' + Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const fmtDate = (d) => d ? new Date(d).toISOString().slice(0, 10) : '—';
      const contactBits = [organization.contactPhone, organization.contactEmail].filter(Boolean);
      const quoteLabel = quote.quoteNumber || ('Q-' + quote.number);
      const cust = quote.customer || {};
      const prop = quote.property || {};
      const propAddr = [prop.line1, prop.line2].filter(Boolean).join(', ');
      const propCity = [prop.city, prop.state, prop.postalCode].filter(Boolean).join(', ');
      const prep = quote.salesperson || {};
      const owner = (typeof ownerSignature !== 'undefined' && ownerSignature) ? ownerSignature : {};
      const signed = !!(quote.signedByName || quote.signatureUrl);
      const scheduleRaw = (quote.paymentSchedule && quote.paymentSchedule.items) ? quote.paymentSchedule.items : [];
      const quoteTotalNum = Number(quote.total) || 0;
      const scheduleItems = scheduleRaw.map((it) => {
        const fixed = Number(it.fixedAmount);
        const pct = Number(it.percent);
        let amount = Number.isFinite(fixed) && fixed > 0 ? fixed : 0;
        if (!amount && Number.isFinite(pct) && pct > 0) {
          amount = Math.round(((quoteTotalNum * pct) / 100) * 100) / 100;
        }
        const pctLabel = Number.isFinite(pct) && pct > 0 ? (' (' + pct + '%)') : '';
        return { label: (it.label || 'Payment') + pctLabel, amount: amount };
      });

      function lineMeta(li) {
        const m = li.meta && typeof li.meta === 'object' ? li.meta : {};
        return m;
      }
      function sectionKey(li) {
        const t = String(li.itemType || '').toLowerCase();
        if (t === 'product') return 'supply';
        const meta = lineMeta(li);
        const st = String(meta.service_type || meta.serviceType || quote.serviceType || '').toLowerCase();
        if (st.includes('supply') || st.includes('fornec') || st.includes('material')) return 'supply';
        if (st.includes('sand') || st.includes('finish') || st.includes('lix') || st.includes('acab')) return 'sand_finish';
        return 'installation';
      }
      const sectionDefs = [
        { key: 'supply', label: 'SUPPLY' },
        { key: 'installation', label: 'INSTALLATION' },
        { key: 'sand_finish', label: 'SAND & FINISH' },
      ];
      const buckets = { supply: [], installation: [], sand_finish: [] };
      const optionalItems = [];
      (quote.lineItems || []).forEach((li) => {
        if (li.isOptional) {
          optionalItems.push(li);
          return;
        }
        const k = sectionKey(li);
        (buckets[k] || buckets.installation).push(li);
      });
      const sections = sectionDefs
        .filter((d) => buckets[d.key].length)
        .map((d) => ({
          ...d,
          items: buckets[d.key],
          sectionTotal: buckets[d.key].reduce((s, li) => s + (Number(li.amount) || 0), 0),
        }));
      const inclusionsList = (typeof inclusions !== 'undefined' && Array.isArray(inclusions) && inclusions.length)
        ? inclusions
        : [
          'Hardwood sanding of all floors in scope',
          'Select hardwood / LVP installation as listed',
          'Baseboard remove & reinstall where noted',
          'Dust containment during sanding & finishing',
        ];
    %>

    <article class="qp-doc" id="quoteDocument">
      <div class="qp-accent-bar" aria-hidden="true"></div>
      <div class="qp-doc-inner">
        <header class="qp-header">
          <div class="qp-header__brand">
            <% if (organization.logoUrl) { %>
              <img class="qp-logo" src="<%= organization.logoUrl %>" alt="" width="68" height="68" onerror="this.style.display='none'" />
            <% } else { %>
              <img class="qp-logo" src="/assets/obramate-logo.png" alt="" width="68" height="68" onerror="this.style.display='none'" />
            <% } %>
            <div class="qp-company">
              <h1 class="qp-company__name"><%= organization.name %></h1>
              <% if (organizationAddress) { %><p class="qp-company__tagline"><%= organizationAddress %></p><% } %>
              <% if (organizationLicense) { %><p class="qp-company__tagline"><%= organizationLicense %></p><% } %>
              <% if (contactBits.length) { %><p class="qp-company__contact"><%= contactBits.join(' · ') %></p><% } %>
            </div>
          </div>
          <aside class="qp-quote-panel">
            <p class="qp-quote-panel__label">QUOTE</p>
            <p class="qp-quote-panel__number"><%= quoteLabel %></p>
            <p>Issue: <%= fmtDate(quote.createdAt) %></p>
            <% if (quote.validUntil) { %><p>Expires: <%= fmtDate(quote.validUntil) %></p><% } %>
            <p>Status: <%= quote.status %></p>
          </aside>
        </header>

        <div class="qp-summary">
          <div class="qp-summary__item">
            <label>Quote total</label>
            <strong id="summaryTotal"><%= money(quote.total) %></strong>
          </div>
          <div class="qp-summary__item">
            <label>Due on approval</label>
            <strong><%= scheduleItems.length ? money(scheduleItems[0].amount) : money(quote.total) %></strong>
          </div>
          <div class="qp-summary__item">
            <label>Floor area</label>
            <strong><%= Number(quote.areaSqft || 0) ? (Number(quote.areaSqft).toFixed(0) + ' sq ft') : '—' %></strong>
          </div>
          <div class="qp-summary__item">
            <label>Valid until</label>
            <strong><%= quote.validUntil ? fmtDate(quote.validUntil) : '—' %></strong>
          </div>
        </div>

        <div class="qp-cols">
          <div>
            <p class="qp-col__label">Bill to</p>
            <p class="qp-col__name"><%= cust.name || 'Client' %></p>
            <% if (cust.email) { %><p class="qp-col__meta"><%= cust.email %></p><% } %>
            <% if (cust.phone) { %><p class="qp-col__meta"><%= cust.phone %></p><% } %>
          </div>
          <div>
            <p class="qp-col__label">Job site</p>
            <p class="qp-col__name"><%= prop.label || quote.title || 'Project' %></p>
            <% if (propAddr) { %><p class="qp-col__meta"><%= propAddr %></p><% } %>
            <% if (propCity) { %><p class="qp-col__meta"><%= propCity %></p><% } %>
          </div>
          <div>
            <p class="qp-col__label">Prepared by</p>
            <p class="qp-col__name"><%= prep.name || owner.name || organization.name %></p>
            <% if (prep.email || organization.contactEmail) { %>
              <p class="qp-col__meta"><%= prep.email || organization.contactEmail %></p>
            <% } %>
            <% if (owner.title && !prep.name) { %><p class="qp-col__meta"><%= owner.title %></p><% } %>
          </div>
        </div>

        <% if (quote.clientMessage) { %>
          <p class="qp-msg"><%= quote.clientMessage %></p>
        <% } %>

        <form id="quotePublicForm" method="post" action="/public/quotes/<%= token %>/approve">
          <% if (quote.optionGroups && quote.optionGroups.length) { %>
            <div class="qp-options no-print">
              <p class="qp-col__label">Choose an option</p>
              <% quote.optionGroups.forEach((g, i) => { %>
                <label>
                  <input type="radio" name="selectedOptionGroupId" value="<%= g.id %>"
                    <%= (quote.selectedOptionGroupId === g.id || (!quote.selectedOptionGroupId && i===0)) ? 'checked' : '' %>
                    <%= readOnly ? 'disabled' : '' %> />
                  <%= g.name %>
                </label>
              <% }) %>
            </div>
          <% } %>

          <% if (clientView.showRoomBreakdown && quote.rooms && quote.rooms.length) { %>
            <div class="qp-section">
              <h2 class="qp-section-title">Rooms</h2>
              <table class="qp-table">
                <thead><tr><th>Room</th><th class="qp-num">Area</th></tr></thead>
                <tbody>
                  <% quote.rooms.forEach((r) => { %>
                    <tr><td><%= r.name %></td><td class="qp-num"><%= Number(r.areaSqft).toFixed(2) %> sq ft</td></tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>

          <% sections.forEach((sec) => { %>
            <div class="qp-section">
              <div class="qp-section-head">
                <h2 class="qp-section-title"><%= sec.label %></h2>
                <p class="qp-section-total">Section total <%= money(sec.sectionTotal) %></p>
              </div>
              <table class="qp-table">
                <thead>
                  <tr>
                    <th>Description</th>
                    <% if (clientView.showQuantities) { %><th class="qp-num">Qty</th><% } %>
                    <% if (clientView.showUnitPrices) { %><th class="qp-num">Rate</th><% } %>
                    <% if (clientView.showLineTotals) { %><th class="qp-num">Amount</th><% } %>
                  </tr>
                </thead>
                <tbody>
                  <% sec.items.forEach((li) => { %>
                    <tr
                      data-id="<%= li.id %>"
                      data-optional="0"
                      data-group="<%= li.optionGroupId || '' %>"
                    >
                      <td>
                        <span class="qp-line__title"><%= li.name || li.description %></span>
                        <% if (li.name && li.description && li.description !== li.name) { %>
                          <span class="qp-line__body"><%= li.description %></span>
                        <% } %>
                      </td>
                      <% if (clientView.showQuantities) { %>
                        <td class="qp-num"><%= Number(li.quantity).toFixed(2) %> <%= String(li.unit || '').replace(/_/g, ' ') %></td>
                      <% } %>
                      <% if (clientView.showUnitPrices) { %>
                        <td class="qp-num"><%= money(li.unitPrice) %></td>
                      <% } %>
                      <% if (clientView.showLineTotals) { %>
                        <td class="qp-num"><%= money(li.amount) %></td>
                      <% } %>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% }) %>

          <div class="qp-page-break" aria-hidden="true">
            <span>Totals, optional add-ons and approval</span>
          </div>

          <div class="qp-section qp-section--addons">
            <div class="qp-section-head">
              <h2 class="qp-section-title">Optional add-ons</h2>
              <p class="qp-section-total">Not included in the total · check to add when approving</p>
            </div>
            <% if (optionalItems.length) { %>
              <div class="qp-addons">
                <% optionalItems.forEach((li) => { %>
                  <div
                    class="qp-addon"
                    data-id="<%= li.id %>"
                    data-optional="1"
                    data-group="<%= li.optionGroupId || '' %>"
                  >
                    <% if (!readOnly) { %>
                      <label class="qp-addon__check">
                        <input type="checkbox" class="opt-check" name="selectedOptionalIds" value="<%= li.id %>" <%= li.isSelected ? 'checked' : '' %> />
                      </label>
                    <% } else { %>
                      <span class="qp-addon__box" aria-hidden="true"></span>
                    <% } %>
                    <div class="qp-addon__body">
                      <span class="qp-line__title"><%= li.name || li.description %></span>
                      <% if (li.name && li.description && li.description !== li.name) { %>
                        <span class="qp-line__body"><%= li.description %></span>
                      <% } %>
                    </div>
                    <% if (clientView.showQuantities) { %>
                      <span class="qp-addon__meta"><%= Number(li.quantity).toFixed(2) %> <%= String(li.unit || '').replace(/_/g, ' ') %></span>
                    <% } %>
                    <% if (clientView.showUnitPrices) { %>
                      <span class="qp-addon__meta"><%= money(li.unitPrice) %></span>
                    <% } %>
                    <% if (clientView.showLineTotals) { %>
                      <span class="qp-addon__amt"><%= money(li.amount) %></span>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="qp-addons-empty">No optional add-ons on this quote.</p>
            <% } %>
          </div>

          <div class="qp-totals-wrap">
            <table class="qp-totals">
              <tbody>
                <tr><td>Subtotal</td><td id="subtotalDisplay"><%= money(quote.subtotal) %></td></tr>
                <tr><td>Tax</td><td id="taxDisplay"><%= money(quote.taxTotal) %></td></tr>
                <% if (Number(quote.discountValue)) { %>
                  <tr>
                    <td>Discount (<%= quote.discountType === 'fixed' ? '$' : '%' %>)</td>
                    <td><%= quote.discountType === 'fixed' ? money(quote.discountValue) : (Number(quote.discountValue) + '%') %></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
            <p class="qp-totals-label">Quote total</p>
            <div class="qp-grand-total">
              <span class="qp-grand-total__label">TOTAL</span>
              <span class="qp-grand-total__value" id="totalDisplay"><%= money(quote.total) %></span>
            </div>
          </div>

          <% if (scheduleItems.length) { %>
            <h3 class="qp-block-title">Payment schedule</h3>
            <table class="qp-table">
              <thead><tr><th>Milestone</th><th class="qp-num">Amount</th></tr></thead>
              <tbody>
                <% scheduleItems.forEach((it) => { %>
                  <tr>
                    <td><%= it.label || it.name || 'Payment' %></td>
                    <td class="qp-num"><%= money(it.amount) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>

          <div class="qp-inclex">
            <div>
              <h3 class="qp-block-title">What's included</h3>
              <ul class="qp-inclex__list qp-inclex__list--in">
                <% inclusionsList.forEach((item) => { %>
                  <li><%= item %></li>
                <% }) %>
              </ul>
            </div>
          </div>

          <div class="qp-terms-block">
            <h3 class="qp-block-title">Terms</h3>
            <ol class="qp-terms-list">
              <% (typeof termsItems !== 'undefined' && termsItems.length ? termsItems : [
                'This quote is valid until the expiration date shown. Prices assume accurate measurements and site access as discussed.',
                'Changes in scope, materials, or site conditions may require a revised quote before work continues.',
                'Natural wood and LVP may vary in color and grain; samples are representative, not exact matches.',
                'A signed approval and deposit may be required to reserve the schedule. Payment terms are listed above.',
              ]).forEach((item) => { %>
                <li><%= item %></li>
              <% }) %>
            </ol>
          </div>

          <% if (!readOnly && !signed) { %>
            <div class="qp-sign-cta no-print">
              <p class="qp-sign-cta__text">Ready to proceed? Review the terms above, then sign to approve this quote.</p>
              <button type="button" class="qp-btn qp-btn--primary" data-qp-open-sign>Assinar</button>
            </div>
          <% } %>

          <% if (organization.paymentInstructions) { %>
            <h3 class="qp-block-title">Payment instructions</h3>
            <p class="qp-block-text"><%= organization.paymentInstructions %></p>
          <% } %>

          <% if (quote.notes) { %>
            <h3 class="qp-block-title">Notes</h3>
            <p class="qp-block-text"><%= quote.notes %></p>
          <% } %>

          <% const showOwner = !!(owner.image_url || owner.name); %>
          <% if (showOwner || signed) { %>
            <section class="qp-signatures<%= (showOwner && !signed) || (!showOwner && signed) ? ' qp-signatures--single' : '' %>">
              <% if (showOwner) { %>
                <div>
                  <h3>Authorized by</h3>
                  <div class="qp-signatures__box">
                    <% if (owner.image_url) { %>
                      <img src="<%= owner.image_url %>" alt="Authorized signature" />
                    <% } else { %>
                      <span style="color:var(--qp-muted);font-size:12px;"><%= organization.name %></span>
                    <% } %>
                  </div>
                  <% if (owner.name) { %><p class="qp-signatures__name"><%= owner.name %></p><% } %>
                  <% if (owner.title) { %><p class="qp-signatures__title"><%= owner.title %></p><% } %>
                </div>
              <% } %>
              <% if (signed) { %>
                <div>
                  <h3>Client approval</h3>
                  <div class="qp-signatures__box">
                    <% if (quote.signatureUrl) { %>
                      <img src="<%= quote.signatureUrl %>" alt="Client signature" />
                    <% } else { %>
                      <span style="color:var(--qp-muted);font-size:12px;">Signed</span>
                    <% } %>
                  </div>
                  <p class="qp-signatures__name"><%= quote.signedByName || cust.name || 'Client' %></p>
                  <p class="qp-signatures__date">Date: <%= fmtDate(quote.signedAt) %></p>
                </div>
              <% } %>
            </section>
          <% } %>

          <input type="hidden" name="signedByName" id="signedByName" value="" />
          <input type="hidden" name="signatureDataUrl" id="signatureDataUrl" value="" />
          <input type="hidden" name="acceptTerms" id="acceptTerms" value="" />
          <input type="hidden" name="approvedLat" id="approvedLat" />
          <input type="hidden" name="approvedLng" id="approvedLng" />
          <input type="hidden" name="approvedGpsAccuracyM" id="approvedGpsAccuracyM" />
        </form>
      </div>
    </article>

    <% if (signed) { %>
      <p class="qp-approved">Thank you — this quote is approved<%= quote.signedByName ? (' and signed by ' + quote.signedByName) : '' %>.</p>
    <% } %>

    <% if (!readOnly) { %>
      <div class="qp-changes no-print">
        <details>
          <summary>Request changes</summary>
          <form method="post" action="/public/quotes/<%= token %>/request-changes">
            <textarea name="note" required placeholder="What would you like changed?"></textarea>
            <p style="margin:10px 0 0;text-align:right;">
              <button type="submit" class="qp-btn qp-btn--outline">Send request</button>
            </p>
          </form>
        </details>
      </div>
    <% } %>
  </div>

  <div class="qp-actions no-print" id="quoteActions">
    <a class="qp-btn qp-btn--outline" href="/public/quotes/<%= token %>/pdf" target="_blank" rel="noopener noreferrer">Download PDF</a>
    <% if (!readOnly && !signed) { %>
      <button type="button" class="qp-btn qp-btn--primary" id="btnApprove" data-qp-open-sign>Assinar</button>
    <% } %>
  </div>

  <% if (!readOnly && !signed) { %>
  <div class="qp-sign-modal" id="qpSignModal" hidden role="dialog" aria-modal="true" aria-labelledby="qpSignTitle">
    <div class="qp-sign-modal__backdrop" id="qpSignBackdrop"></div>
    <div class="qp-sign-modal__panel">
      <h2 id="qpSignTitle" class="qp-sign-modal__title">Approve &amp; sign</h2>
      <p class="qp-sign-modal__sub">A assinatura é gerada automaticamente a partir do seu nome. Pode desenhar por cima para personalizar.</p>
      <label class="qp-sign-field" for="qpSignerName">Your full name</label>
      <input type="text" id="qpSignerName" class="qp-sign-input" autocomplete="name" placeholder="Full name" value="<%= cust.name || '' %>" />
      <label class="qp-sign-field" for="qpSignCanvas">Your signature</label>
      <div class="qp-sign-canvas-wrap">
        <canvas id="qpSignCanvas" width="520" height="140" aria-label="Draw your signature"></canvas>
      </div>
      <label style="display:flex;gap:8px;align-items:flex-start;font-size:12px;margin-bottom:14px;">
        <input type="checkbox" id="qpAcceptTerms" />
        <span>I accept the terms and conditions in this quote.</span>
      </label>
      <div class="qp-sign-modal__actions">
        <button type="button" class="qp-btn qp-btn--outline" id="qpSignClear">Clear</button>
        <button type="button" class="qp-btn qp-btn--outline" id="qpSignCancel">Cancel</button>
        <button type="button" class="qp-btn qp-btn--primary" id="qpSignSubmit">Approve quote</button>
      </div>
    </div>
  </div>
  <% } %>

  <script src="/quote-signature-auto.js?v=20260708"></script>
  <script>
    (function () {
      const readOnly = <%= readOnly ? 'true' : 'false' %>;
      const token = <%= JSON.stringify(token) %>;
      const defaultName = <%= JSON.stringify((quote.customer && quote.customer.name) || '') %>;

      function money(n) {
        return '$' + Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }

      function createPad(canvas) {
        const ctx = canvas.getContext('2d');
        let drawing = false;
        let hasStroke = false;
        ctx.strokeStyle = '#1a2036';
        ctx.lineWidth = 2;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        const pos = (e) => {
          const r = canvas.getBoundingClientRect();
          const t = e.touches ? e.touches[0] : e;
          return {
            x: (t.clientX - r.left) * (canvas.width / r.width),
            y: (t.clientY - r.top) * (canvas.height / r.height),
          };
        };
        const start = (e) => {
          drawing = true;
          hasStroke = true;
          const p = pos(e);
          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          e.preventDefault();
        };
        const move = (e) => {
          if (!drawing) return;
          const p = pos(e);
          ctx.lineTo(p.x, p.y);
          ctx.stroke();
          e.preventDefault();
        };
        const end = () => { drawing = false; };
        canvas.addEventListener('mousedown', start);
        canvas.addEventListener('mousemove', move);
        window.addEventListener('mouseup', end);
        canvas.addEventListener('touchstart', start, { passive: false });
        canvas.addEventListener('touchmove', move, { passive: false });
        canvas.addEventListener('touchend', end);

        function drawName(name) {
          const text = String(name || '').trim();
          if (text.length < 2) return false;
          if (window.QuoteSignatureAuto && window.QuoteSignatureAuto.renderAutoSignatureOnCanvas(canvas, text)) {
            return true;
          }
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = '#1a2036';
          let fontSize = 36;
          ctx.font = 'italic ' + fontSize + 'px "Brush Script MT", "Segoe Script", cursive';
          while (fontSize > 14 && ctx.measureText(text).width > canvas.width - 32) {
            fontSize -= 1;
            ctx.font = 'italic ' + fontSize + 'px "Brush Script MT", "Segoe Script", cursive';
          }
          ctx.textBaseline = 'middle';
          ctx.textAlign = 'center';
          ctx.fillText(text, canvas.width / 2, canvas.height / 2);
          return true;
        }

        return {
          clear() { ctx.clearRect(0, 0, canvas.width, canvas.height); hasStroke = false; },
          isEmpty() { return !hasStroke; },
          renderFromName(name) {
            const ok = drawName(name);
            hasStroke = !!ok;
            return ok;
          },
          toDataURL() { return canvas.toDataURL('image/png'); },
        };
      }

      let pad = null;
      const modal = document.getElementById('qpSignModal');
      const canvas = document.getElementById('qpSignCanvas');
      const nameInput = document.getElementById('qpSignerName');

      function openModal(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        if (!modal || !canvas) {
          alert('Não foi possível abrir a assinatura. Atualize a página e tente de novo.');
          return;
        }
        try {
          if (!pad) pad = createPad(canvas);
          pad.clear();
          if (nameInput) {
            if (!nameInput.value && defaultName) nameInput.value = defaultName;
            const n = nameInput.value.trim();
            if (n.length >= 2) pad.renderFromName(n);
          }
          modal.hidden = false;
          modal.classList.add('is-open');
          modal.setAttribute('aria-hidden', 'false');
          document.body.classList.add('qp-sign-open');
          setTimeout(() => nameInput && nameInput.focus(), 50);
        } catch (err) {
          console.error(err);
          alert('Erro ao abrir a assinatura. Atualize a página e tente de novo.');
        }
      }
      function closeModal() {
        if (!modal) return;
        modal.classList.remove('is-open');
        modal.hidden = true;
        modal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('qp-sign-open');
      }

      window.__qpOpenSign = openModal;

      document.querySelectorAll('#btnApprove, [data-qp-open-sign]').forEach((btn) => {
        btn.addEventListener('click', openModal);
      });
      document.getElementById('qpSignBackdrop')?.addEventListener('click', closeModal);
      document.getElementById('qpSignCancel')?.addEventListener('click', closeModal);
      document.getElementById('qpSignClear')?.addEventListener('click', () => pad && pad.clear());

      let debounceTimer = null;
      nameInput?.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          if (!pad) return;
          const n = nameInput.value.trim();
          if (n.length >= 2) pad.renderFromName(n);
          else pad.clear();
        }, 250);
      });

      document.getElementById('qpSignSubmit')?.addEventListener('click', () => {
        const name = (nameInput && nameInput.value.trim()) || '';
        if (name.length < 2) { alert('Please enter your full name.'); return; }
        if (!document.getElementById('qpAcceptTerms')?.checked) {
          alert('Please accept the terms and conditions.');
          return;
        }
        if (!pad) pad = createPad(canvas);
        if (pad.isEmpty()) pad.renderFromName(name);
        if (pad.isEmpty()) { alert('Please add your signature.'); return; }
        const form = document.getElementById('quotePublicForm');
        if (!form) { alert('Formulário não encontrado.'); return; }
        document.getElementById('signedByName').value = name;
        document.getElementById('signatureDataUrl').value = pad.toDataURL();
        document.getElementById('acceptTerms').value = 'on';
        form.submit();
      });

      async function recalc() {
        if (readOnly) return;
        const selectedOptionGroupId = document.querySelector('input[name="selectedOptionGroupId"]:checked')?.value || null;
        const selectedOptionalIds = [...document.querySelectorAll('.opt-check:checked')].map((el) => el.value);
        try {
          const res = await fetch('/public/quotes/' + encodeURIComponent(token) + '/recalculate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ selectedOptionGroupId, selectedOptionalIds }),
          });
          const json = await res.json();
          if (json.success && json.data) {
            const t = money(json.data.total);
            const totalEl = document.getElementById('totalDisplay');
            const summaryEl = document.getElementById('summaryTotal');
            const subEl = document.getElementById('subtotalDisplay');
            const taxEl = document.getElementById('taxDisplay');
            if (totalEl) totalEl.textContent = t;
            if (summaryEl) summaryEl.textContent = t;
            if (subEl && json.data.subtotal != null) subEl.textContent = money(json.data.subtotal);
            if (taxEl && json.data.taxTotal != null) taxEl.textContent = money(json.data.taxTotal);
          }
        } catch (_) {}
        document.querySelectorAll('#quotePublicForm [data-id]').forEach((el) => {
          const group = el.dataset.group;
          const optional = el.dataset.optional === '1';
          let show = true;
          if (group && selectedOptionGroupId && group !== selectedOptionGroupId) show = false;
          el.style.display = show ? '' : 'none';
          if (optional) {
            const cb = el.querySelector('.opt-check');
            el.classList.toggle('is-dim', !!(cb && !cb.checked));
          }
        });
      }
      document.querySelectorAll('input[name="selectedOptionGroupId"], .opt-check').forEach((el) => {
        el.addEventListener('change', recalc);
      });
      if (!readOnly) recalc();

      if (navigator.geolocation && !readOnly) {
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const lat = document.getElementById('approvedLat');
            const lng = document.getElementById('approvedLng');
            const acc = document.getElementById('approvedGpsAccuracyM');
            if (lat) lat.value = String(pos.coords.latitude);
            if (lng) lng.value = String(pos.coords.longitude);
            if (acc) acc.value = String(pos.coords.accuracy || '');
          },
          () => {},
          { enableHighAccuracy: true, timeout: 8000, maximumAge: 60000 }
        );
      }
    })();
  </script>
</body>
</html>
