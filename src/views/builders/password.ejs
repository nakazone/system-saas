<%- include('_head', { title: member.invited ? 'Join your team' : 'New password' }) %>
<main class="card center">
  <p class="eyebrow"><%= builder %></p>
  <h1><%= member.invited ? 'Join your team on ' + productName : 'Choose a new password' %></h1>
  <p class="muted"><%= member.email %></p>
  <% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %>
  <form method="post" action="/builders/password">
    <input type="hidden" name="token" value="<%= token %>" />
    <% if (member.invited) { %>
      <label for="name">Your name</label>
      <input id="name" type="text" name="name" maxlength="120" autocomplete="name" value="<%= member.name %>" />
    <% } %>
    <label for="password">Password <span class="muted" style="font-weight:400">(8+ characters)</span></label>
    <input id="password" type="password" name="password" required minlength="8" maxlength="128" autocomplete="new-password" />
    <button class="btn btn--pri" type="submit" style="width:100%;margin-top:20px"><%= member.invited ? 'Join and open the portal' : 'Save and sign in' %></button>
  </form>
</main>
</body>
</html>
