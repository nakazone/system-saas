<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <style>
    :root {
      --ink: <%= organization.primaryColor || '#1a2036' %>;
      --muted: #6b6a66;
      --page: #f3f1ee;
      --line: #dbdee8;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Segoe UI", system-ui, sans-serif;
      background: <%= embed ? 'transparent' : 'var(--page)' %>;
      color: var(--ink);
    }
    .wrap { max-width: 960px; margin: 0 auto; padding: <%= embed ? '0.5rem' : '1.25rem' %>; }
    header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; }
    .logo { width: 48px; height: 48px; border-radius: 10px; object-fit: cover; background: #ddd; }
    .logo-fb {
      width: 48px; height: 48px; border-radius: 10px; background: var(--ink); color: #fff;
      display: grid; place-items: center; font-weight: 800;
    }
    h1 { margin: 0; font-size: 1.25rem; }
    p.sub { margin: 0.15rem 0 0; color: var(--muted); font-size: 0.85rem; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 0.65rem;
    }
    a.card {
      display: block; aspect-ratio: 1; border-radius: 12px; overflow: hidden;
      position: relative; background: #e4e7ef; text-decoration: none; color: #fff;
    }
    a.card img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .stg {
      position: absolute; top: 0.4rem; left: 0.4rem; padding: 0.12rem 0.4rem;
      border-radius: 999px; background: rgba(26,32,54,0.72); font-size: 0.62rem; font-weight: 700;
      text-transform: uppercase;
    }
    .cap {
      position: absolute; left: 0; right: 0; bottom: 0; padding: 0.4rem 0.5rem;
      background: linear-gradient(transparent, rgba(26,32,54,0.78));
      font-size: 0.72rem; font-weight: 600; line-height: 1.25;
    }
    .empty { color: var(--muted); padding: 2rem 0; text-align: center; }
    .foot { margin-top: 1.25rem; font-size: 0.72rem; color: var(--muted); text-align: center; }
  </style>
</head>
<body>
  <div class="wrap">
    <% if (!embed) { %>
    <header>
      <% if (organization.logoUrl) { %>
        <img class="logo" src="<%= organization.logoUrl %>" alt="" />
      <% } else { %>
        <div class="logo-fb" aria-hidden="true"><%= String(organization.name || 'O').charAt(0).toUpperCase() %></div>
      <% } %>
      <div>
        <h1><%= organization.name %></h1>
        <p class="sub">Project photo portfolio</p>
      </div>
    </header>
    <% } %>

    <% if (!items.length) { %>
      <p class="empty">No featured photos yet.</p>
    <% } else { %>
      <div class="grid">
        <% items.forEach(function (p) { %>
          <a class="card" href="<%= p.url %>" target="_blank" rel="noopener">
            <% if (p.stage) { %><span class="stg"><%= p.stage %></span><% } %>
            <img src="<%= p.thumbUrl || p.url %>" alt="<%= p.caption || p.jobTitle || 'Project photo' %>" loading="lazy" />
            <span class="cap"><%= p.caption || p.jobTitle || (p.stage || 'Photo') %></span>
          </a>
        <% }) %>
      </div>
    <% } %>

    <% if (!embed) { %>
      <p class="foot">Powered by ObraMate · Embed with ?embed=1</p>
    <% } %>
  </div>
</body>
</html>
