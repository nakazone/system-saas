<% const displayProductName = (typeof productName !== 'undefined' && productName) ? productName : 'ObraMate'; %>
<% const accent = (typeof organization !== 'undefined' && organization && organization.primaryColor)
  ? (organization.accentColor || organization.primaryColor)
  : '#e8792c'; %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title : 'App' %><% if (typeof organization !== 'undefined' && organization) { %> · <%= organization.name %><% } else { %> · <%= displayProductName %><% } %></title>
  <link rel="icon" type="image/png" href="/assets/obramateLogoSmallTransp.png" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/assets/obramateLogoSmallTransp.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/app.css" />
  <style>:root { --brand: <%= accent %>; --brand-dark: #c1652f; --brand-ink: #211d1a; --brand-surface: #f7f4ee; }</style>
</head>
<body class="<%= typeof organization !== 'undefined' && organization ? 'app-shell' : 'marketing-shell' %>">
  <% if (typeof organization !== 'undefined' && organization) { %>
  <header class="app-header">
    <div class="brand">
      <% if (organization.logoUrl) { %>
        <img src="<%= organization.logoUrl %>" alt="" class="brand-logo" />
      <% } else { %>
        <img src="/assets/obramate-logo.png" alt="<%= displayProductName %>" class="brand-logo" />
      <% } %>
      <a href="/" class="brand-name"><%= organization.name %></a>
    </div>
    <% if (typeof user !== 'undefined' && user) { %>
    <nav class="app-nav">
      <a href="/dashboard.html">Dashboard</a>
      <a href="/dashboard.html?page=leads">Leads</a>
      <a href="/dashboard.html?page=quotes">Quotes</a>
      <a href="/dashboard.html?page=invoices">Invoices</a>
      <a href="/dashboard.html?page=customers">Cadastro</a>
      <a href="/builder-pricing-admin.html">Tabela de Valores</a>
      <a href="/payroll-module.html">Folha de Pagamento</a>
      <a href="/ajustes.html">Ajustes</a>
      <a href="/dashboard.html?page=users">Users</a>
      <form action="/logout" method="post" class="inline">
        <button type="submit" class="linkish">Sign out (<%= user.name %>)</button>
      </form>
    </nav>
    <% } %>
  </header>
  <main class="container">
  <% } else { %>
  <header class="marketing-header">
    <a href="/" class="marketing-logo" aria-label="<%= displayProductName %>">
      <img src="/assets/obramate-logo.png" alt="<%= displayProductName %>" class="marketing-logo__img" width="340" height="72" />
    </a>
    <nav class="marketing-nav">
      <a href="/#features">Features</a>
      <a href="/#calculator">Estimate calculator</a>
      <a href="/pricing">Pricing</a>
      <a href="/login.html">Sign in</a>
      <a class="btn btn-sm" href="/signup">Start free trial</a>
    </nav>
  </header>
  <main class="marketing-main">
  <% } %>
